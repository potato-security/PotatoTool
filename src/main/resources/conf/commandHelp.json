{
	"获取操作系统信息": {
		"查看操作系统版本": {
			"Windows": [
				{
					"command": "systeminfo",
					"describe": "显示详细的操作系统信息，包括补丁信息"
				}
			],
			"Linux": [
				{
					"command": "cat /etc/issue",
					"describe": "查看系统发行版本信息"
				},
				{
					"command": "cat /etc/*-release",
					"describe": "查看操作系统版本信息"
				},
				{
					"command": "cat /etc/lsb-release",
					"describe": "查看Debian系统的版本信息"
				},
				{
					"command": "cat /etc/redhat-release",
					"describe": "查看Redhat系统的版本信息"
				}
			]
		},
		"识别操作系统名称及版本（英文）": {
			"Windows": [
				{
					"command": "systeminfo | findstr /B /C:\"OS Name\" /c:\"OS Version\"",
					"describe": "提取操作系统名称及版本信息"
				},
				{
					"command": "wmic os get Caption, Version",
					"describe": "获取操作系统名称和版本"
				}
			]
		},
		"识别操作系统名称及版本（中文）": {
			"Windows": [
				{
					"command": "systeminfo | findstr /B /C:\"OS 名称\" /C:\"OS 版本\"",
					"describe": "提取中文显示的操作系统名称及版本信息"
				}
			]
		},
		"识别系统体系结构": {
			"Windows": [
				{
					"command": "echo %PROCESSOR_ARCHITECTURE% AMD64",
					"describe": "显示系统的处理器架构"
				},
				{
					"command": "wmic os get Architecture",
					"describe": "获取操作系统架构信息"
				}
			],
			"Linux": [
				{
					"command": "uname -m",
					"describe": "显示系统的机器硬件名称"
				}
			]
		},
		"查看内核版本、是否为64位": {
			"Linux": [
				{
					"command": "cat /proc/version",
					"describe": "查看Linux内核版本"
				},
				{
					"command": "uname -a",
					"describe": "查看内核、操作系统、CPU信息"
				},
				{
					"command": "uname -mrs",
					"describe": "显示内核名称、版本及系统架构"
				},
				{
					"command": "rpm -q kernel",
					"describe": "查看安装的内核版本"
				},
				{
					"command": "dmesg | grep Linux",
					"describe": "查看dmesg日志中的Linux相关信息"
				},
				{
					"command": "ls /boot | grep wmlinuz-",
					"describe": "列出/boot目录中的内核文件"
				}
			]
		},
		"查看环境变量": {
			"Windows": [
				{
					"command": "set",
					"describe": "显示当前环境变量"
				},
				{
					"command": "echo %PATH%",
					"describe": "显示PATH环境变量"
				},
				{
					"command": "wmic environment get Name, VariableValue",
					"describe": "获取所有环境变量的名称和值"
				}
			],
			"Linux": [
				{
					"command": "cat /etc/profile",
					"describe": "查看全局环境变量配置文件"
				},
				{
					"command": "cat /etc/bashrc",
					"describe": "查看bash shell环境配置文件"
				},
				{
					"command": "cat ~/.bash_profile",
					"describe": "查看用户的bash登录环境配置"
				},
				{
					"command": "cat ~/.bashrc",
					"describe": "查看用户的bash环境配置"
				},
				{
					"command": "cat ~/.bash_logout",
					"describe": "查看用户的bash退出配置"
				},
				{
					"command": "env",
					"describe": "显示当前用户的环境变量"
				},
				{
					"command": "set",
					"describe": "显示当前环境变量（bash风格）"
				}
			]
		},
		"查看是否有打印机": {
			"Windows": [
				{
					"command": "wmic printer list brief",
					"describe": "列出所有打印机"
				}
			],
			"Linux": [
				{
					"command": "lpstat -a",
					"describe": "列出所有已安装的打印机"
				}
			]
		}
	},
	"获取用户信息": {
		"查看当前用户": {
			"Windows": [
				{
					"command": "whoami",
					"describe": "显示当前登录的用户名"
				},
				{
					"command": "echo %USERNAME%",
					"describe": "显示当前用户名环境变量"
				}
			],
			"Linux": [
				{
					"command": "id",
					"describe": "显示当前用户及其ID信息"
				},
				{
					"command": "whoami",
					"describe": "显示当前登录的用户名"
				}
			]
		},
		"查看计算机用户列表": {
			"Windows": [
				{
					"command": "net user",
					"describe": "列出所有用户账户"
				},
				{
					"command": "wmic useraccount list full",
					"describe": "显示所有用户账户的详细信息"
				}
			],
			"Linux": [
				{
					"command": "cat /etc/passwd",
					"describe": "查看所有用户的账户信息"
				}
			]
		},
		"查看计算机用户组列表": {
			"Windows": [
				{
					"command": "net localgroup",
					"describe": "列出所有本地用户组"
				},
				{
					"command": "wmic group list brief",
					"describe": "列出所有组的简要信息"
				}
			],
			"Linux": [
				{
					"command": "cat /etc/group",
					"describe": "查看所有用户组的信息"
				}
			]
		},
		"查看当前登录用户": {
			"Windows": [
				{
					"command": "query user",
					"describe": "查看当前登录的用户会话"
				},
				{
					"command": "whoami /all",
					"describe": "显示当前用户的所有详细信息"
				}
			],
			"Linux": [
				{
					"command": "who",
					"describe": "显示当前登录用户的信息"
				},
				{
					"command": "w",
					"describe": "显示登录用户及其活动"
				},
				{
					"command": "users",
					"describe": "显示所有当前登录的用户"
				}
			]
		},
		"查看当前用户保存的凭证": {
			"Windows": [
				{
					"command": "cmdkey /list",
					"describe": "列出当前用户保存的凭证"
				}
			]
		},
		"查看当前用户保存的票据凭证": {
			"Windows": [
				{
					"command": "klist",
					"describe": "显示当前用户保存的Kerberos票据"
				}
			]
		},
		"查看超级用户权限和信息": {
			"Linux": [
				{
					"command": "cat /etc/sudoers",
					"describe": "查看sudo权限配置文件"
				},
				{
					"command": "sudo -l",
					"describe": "列出当前用户的sudo权限"
				},
				{
					"command": "ls -ahlR /root/",
					"describe": "查看root用户的目录内容"
				}
			]
		},
		"查看系统登录历史": {
			"Linux": [
				{
					"command": "who",
					"describe": "查看当前登录的用户"
				},
				{
					"command": "w",
					"describe": "显示登录用户及其活动"
				},
				{
					"command": "last",
					"describe": "显示用户登录历史"
				}
			]
		}
	},
	"获取网络信息": {
		"查看路由信息": {
			"Windows": [
				{
					"command": "route print",
					"describe": "查看本地路由表信息"
				}
			],
			"Linux": [
				{
					"command": "route -n",
					"describe": "查看路由表信息"
				},
				{
					"command": "ip route show",
					"describe": "显示当前路由信息"
				}
			]
		},
		"查看arp": {
			"Windows": [
				{
					"command": "arp -A",
					"describe": "显示本地ARP缓存"
				}
			],
			"Linux": [
				{
					"command": "arp -a",
					"describe": "显示ARP缓存表"
				},
				{
					"command": "ip neighbor",
					"describe": "查看邻居缓存表（ARP表）"
				}
			]
		},
		"查看ip地址和dns信息": {
			"Windows": [
				{
					"command": "ipconfig /all",
					"describe": "查看本地IP地址、子网掩码、默认网关、DNS信息等"
				}
			],
			"Linux": [
				{
					"command": "ip a",
					"describe": "显示本地网络接口及其地址"
				},
				{
					"command": "ifconfig -a",
					"describe": "显示所有网络接口信息"
				},
				{
					"command": "cat /etc/resolv.conf",
					"describe": "查看DNS服务器配置"
				}
			]
		},
		"查看防火墙规则和状态": {
			"Windows": [
				{
					"command": "netsh firewall show config",
					"describe": "查看防火墙配置"
				},
				{
					"command": "netsh firewall show state",
					"describe": "查看防火墙状态"
				},
				{
					"command": "netsh advfirewall firewall show rule name=all",
					"describe": "显示所有防火墙规则"
				},
				{
					"command": "netsh advfirewall show allprofiles",
					"describe": "查看所有防火墙配置文件"
				}
			],
			"Linux": [
				{
					"command": "iptables -L",
					"describe": "列出当前iptables防火墙规则"
				},
				{
					"command": "ufw status",
					"describe": "查看UFW防火墙状态"
				},
				{
					"command": "firewall-cmd --list-all",
					"describe": "列出firewalld的所有规则"
				}
			]
		},
		"查看系统开放端口": {
			"Windows": [
				{
					"command": "netstat -ano",
					"describe": "显示所有活动连接和监听端口"
				}
			],
			"Linux": [
				{
					"command": "netstat -tulpn",
					"describe": "显示当前监听的端口及其相关进程"
				},
				{
					"command": "ss -tuln",
					"describe": "显示监听端口的简化信息"
				}
			]
		},
		"查看当前网络地址": {
			"Linux": [
				{
					"command": "/sbin/ifconfig -a",
					"describe": "显示所有网络接口地址"
				},
				{
					"command": "cat /etc/network/interfaces",
					"describe": "查看网络接口的配置文件"
				},
				{
					"command": "cat /etc/susconfig/network",
					"describe": "查看系统网络配置"
				}
			]
		},
		"查看网络配置、DNS、 DHCP、网关": {
			"Windows": [
				{
					"command": "ipconfig /all",
					"describe": "查看网络配置、DNS、DHCP、网关等信息"
				}
			],
			"Linux": [
				{
					"command": "cat /etc/resolv.conf",
					"describe": "查看DNS服务器配置"
				},
				{
					"command": "cat /etc/sysconfig/network",
					"describe": "查看系统网络配置"
				},
				{
					"command": "cat /etc/networks",
					"describe": "查看网络名称及对应的IP地址"
				},
				{
					"command": "iptables -L",
					"describe": "查看当前iptables防火墙规则"
				},
				{
					"command": "hostname",
					"describe": "查看系统主机名"
				},
				{
					"command": "dnsdomainname",
					"describe": "查看系统DNS域名"
				},
				{
					"command": "ip a",
					"describe": "查看本地IP地址信息"
				},
				{
					"command": "nmcli device show",
					"describe": "显示网络设备的详细信息"
				}
			]
		},
		"查看网络通信": {
			"Windows": [
				{
					"command": "netstat -an",
					"describe": "显示所有网络连接"
				},
				{
					"command": "netstat -an | findstr :80",
					"describe": "查找监听80端口的连接"
				}
			],
			"Linux": [
				{
					"command": "lsof -i",
					"describe": "显示打开的网络文件"
				},
				{
					"command": "lsof -i :80",
					"describe": "查看80端口的连接"
				},
				{
					"command": "grep 80 /etc/services",
					"describe": "查找80端口的服务信息"
				},
				{
					"command": "netstat -antup",
					"describe": "显示所有TCP/UDP连接及监听端口"
				},
				{
					"command": "netstat -antpx",
					"describe": "显示TCP连接及其进程信息"
				},
				{
					"command": "netstat -tulpn",
					"describe": "显示监听端口及进程"
				},
				{
					"command": "ss -tuln",
					"describe": "查看简化的监听端口信息"
				},
				{
					"command": "chkconfig --list",
					"describe": "列出系统服务及其启动状态"
				},
				{
					"command": "chkconfig --list | grep 3:on",
					"describe": "过滤出在运行级别3中启动的服务"
				}
			]
		},
		"查看缓存表": {
			"Windows": [
				{
					"command": "ipconfig /displaydns",
					"describe": "查看DNS缓存表"
				},
				{
					"command": "arp -a",
					"describe": "显示ARP缓存"
				}
			],
			"Linux": [
				{
					"command": "arp -e",
					"describe": "显示详细的ARP表"
				},
				{
					"command": "route",
					"describe": "查看路由表"
				},
				{
					"command": "/sbin/route -nee",
					"describe": "显示详细的路由表信息"
				}
			]
		}
	},
	"获取应用程序及服务信息": {
		"查看计划任务": {
			"Windows": [
				{
					"command": "schtasks /query /fo LIST /v",
					"describe": "查看当前计划任务的详细信息"
				}
			],
			"Linux": [
				{
					"command": "crontab -l",
					"describe": "查看当前用户的计划任务"
				},
				{
					"command": "ls -alh /var/spool/cron",
					"describe": "查看计划任务的目录内容"
				},
				{
					"command": "ls -al /etc/ | grep cron",
					"describe": "列出/etc目录下与cron相关的文件"
				},
				{
					"command": "ls -al /etc/cron*",
					"describe": "列出/etc目录中与cron相关的子目录"
				},
				{
					"command": "cat /etc/cron*",
					"describe": "查看/etc/目录中所有与cron相关的配置文件内容"
				},
				{
					"command": "cat /etc/at.allow",
					"describe": "查看允许执行at命令的用户列表"
				},
				{
					"command": "cat /etc/at.deny",
					"describe": "查看禁止执行at命令的用户列表"
				},
				{
					"command": "cat /etc/cron.allow",
					"describe": "查看允许使用cron的用户列表"
				},
				{
					"command": "cat /etc/cron.deny",
					"describe": "查看禁止使用cron的用户列表"
				},
				{
					"command": "cat /etc/crontab",
					"describe": "查看系统级别的crontab文件内容"
				},
				{
					"command": "cat /etc/anacrontab",
					"describe": "查看anacron的计划任务配置"
				},
				{
					"command": "cat /var/spool/cron/crontabs/root",
					"describe": "查看root用户的计划任务"
				}
			]
		},
		"查看安装驱动": {
			"Windows": [
				{
					"command": "driverquery",
					"describe": "列出系统中所有已安装的驱动程序"
				},
				{
					"command": "wmic driver get Caption,Manufacturer,Version",
					"describe": "查看已安装驱动的详细信息"
				}
			],
			"Linux": [
				{
					"command": "lshw -C network",
					"describe": "查看网络硬件驱动信息"
				},
				{
					"command": "lspci -nn | grep -i vga",
					"describe": "查看图形显示驱动信息"
				},
				{
					"command": "lsmod",
					"describe": "查看已加载的内核模块（驱动）"
				},
				{
					"command": "lspci -v",
					"describe": "查看所有PCI设备的详细信息"
				}
			]
		},
		"查看安装程序和版本信息": {
			"Windows": [
				{
					"command": "wmic product list brief",
					"describe": "查看所有已安装的程序及其版本信息"
				}
			],
			"Linux": [
				{
					"command": "dpkg -l",
					"describe": "列出已安装的Debian软件包"
				},
				{
					"command": "rpm -qa",
					"describe": "列出已安装的RPM包"
				},
				{
					"command": "snap list",
					"describe": "列出通过snap安装的程序"
				}
			]
		},
		"查看服务": {
			"Windows": [
				{
					"command": "sc query",
					"describe": "查看系统中所有服务的状态"
				},
				{
					"command": "wmic service list brief",
					"describe": "列出所有系统服务及其状态"
				}
			],
			"Linux": [
				{
					"command": "systemctl list-units --type=service",
					"describe": "查看所有正在运行的系统服务"
				},
				{
					"command": "service --status-all",
					"describe": "查看所有服务的状态"
				},
				{
					"command": "chkconfig --list",
					"describe": "列出所有服务及其运行级别"
				}
			]
		},
		"查看进程": {
			"Windows": [
				{
					"command": "tasklist",
					"describe": "列出所有正在运行的进程"
				},
				{
					"command": "wmic process list brief",
					"describe": "列出正在运行的进程的简要信息"
				}
			],
			"Linux": [
				{
					"command": "ps aux",
					"describe": "列出所有进程，包括不属于当前终端的进程"
				},
				{
					"command": "ps -ef",
					"describe": "显示所有进程的详细信息"
				},
				{
					"command": "top",
					"describe": "动态显示系统中占用资源最多的进程"
				}
			]
		},
		"查看启动程序信息": {
			"Windows": [
				{
					"command": "wmic startup list brief",
					"describe": "查看系统中所有启动程序的简要信息"
				}
			],
			"Linux": [
				{
					"command": "ls /etc/init.d/",
					"describe": "列出所有系统启动脚本"
				},
				{
					"command": "systemctl list-unit-files | grep enabled",
					"describe": "查看所有已启用的服务"
				},
				{
					"command": "chkconfig --list | grep 3:on",
					"describe": "查看启动级别为3的所有已启用服务"
				}
			]
		},
		"查看远程桌面端口": {
			"Windows": [
				{
					"command": "for /f \"tokens=2\" %i in ('tasklist /FI \"SERVICES eq TermService\" /NH') do netstat -ano | findstr %i | findstr LISTENING",
					"describe": "查找远程桌面服务的端口"
				}
			],
			"Linux": [
				{
					"command": "sudo netstat -tuln | grep LISTEN",
					"describe": "查看正在监听的端口"
				},
				{
					"command": "sudo ss -tuln | grep LISTEN",
					"describe": "查看监听的套接字信息"
				},
				{
