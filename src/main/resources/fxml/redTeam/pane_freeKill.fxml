<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.Cursor?>
<?import com.dlsc.gemsfx.CFCheckBox?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/freeKill.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PaneFreeKill"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <HBox alignment="CENTER" prefWidth="${sPane.width - 15}" prefHeight="${sPane.height}">
        <!-- 左侧工具导航 (对齐 Penpot: 平铺列表 + TOOLS section label) -->
        <VBox fx:id="vBoxBar" styleClass="fk-nav-panel" minWidth="190" maxWidth="190" prefWidth="190" prefHeight="${sPane.height}">
            <Label text="TOOLS" styleClass="fk-nav-section-label"/>
            <Label fx:id="navWebshell" text="Shell 生成" styleClass="fk-nav-item,fk-nav-selected"
                   onMouseClicked="#toWebshell" userData="i18n:freekill.webshell" maxWidth="Infinity"/>
            <Label fx:id="navSignature" text="签名伪造" styleClass="fk-nav-item"
                   onMouseClicked="#toSignature" userData="i18n:freekill.signature" maxWidth="Infinity"/>
            <Label fx:id="navQR" text="二维码生成" styleClass="fk-nav-item"
                   onMouseClicked="#toQR" userData="i18n:freekill.qrcode" maxWidth="Infinity"/>
            <Label fx:id="navProtect" text="保护配置" styleClass="fk-nav-item"
                   onMouseClicked="#toSecureProtect" userData="i18n:freekill.packer" maxWidth="Infinity"/>
        </VBox>

        <SmoothScrollPane prefWidth="${sPane.width - 395}" maxWidth="${sPane.width - 395}" maxHeight="${sPane.height}" hbarPolicy="NEVER" fx:id="contentSp">
            <VBox minWidth="${sPane.width - 265}" alignment="CENTER">
                <VBox fx:id="webshellContent" alignment="CENTER" managed="true" visible="true">
                    <Label fx:id="tipTitle" visible="false"/>
                    <!-- Shell 生成 页头 (对齐 Penpot: 标题 + 全局密码 + 全部生成) -->
                    <HBox styleClass="fk-section-header" alignment="CENTER_LEFT" spacing="12">
                        <Label text="Shell 生成" styleClass="fk-section-title" userData="i18n:freekill.webshell"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="全局密码" styleClass="pt-caption" userData="i18n:freekill.password"/>
                        <TextField styleClass="pt-input" fx:id="webShellKey" prefHeight="32" minWidth="140" prefWidth="140"
                                   promptText="空则每项独立配置" userData="i18n-prompt:freekill.password.placeholder"/>
                        <Button styleClass="pt-btn-solid" minHeight="32" minWidth="100"
                                text="全部生成" userData="i18n:freekill.generateall" onAction="#webshellGeneration"/>
                    </HBox>

                    <!-- Godzilla 卡片 -->
                    <VBox styleClass="fk-shell-card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Godzilla" styleClass="fk-shell-name" style="-fx-text-fill: -pt-accent;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="tipTitleGod" styleClass="fk-shell-path" visible="false"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="语言" styleClass="pt-caption" userData="i18n:freekill.language"/>
                            <ComboBox fx:id="godComboBox" prefHeight="30" minWidth="90" prefWidth="90" onAction="#godChoose">
                                <items><FXCollections fx:factory="observableArrayList">
                                    <String fx:value="jsp"/><String fx:value="jspx"/><String fx:value="php"/>
                                    <String fx:value="asp"/><String fx:value="aspx"/><String fx:value="ashx"/>
                                </FXCollections></items>
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </ComboBox>
                            <Label text="编码" styleClass="pt-caption" userData="i18n:freekill.encoding"/>
                            <ComboBox fx:id="godModeComboBox" prefHeight="30" minWidth="180" prefWidth="180">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </ComboBox>
                            <Label text="密码" styleClass="pt-caption" userData="i18n:freekill.password"/>
                            <TextField styleClass="pt-input" fx:id="godKey" prefHeight="30" minWidth="130" prefWidth="130"
                                       promptText="随机生成" userData="i18n-prompt:freekill.password.placeholder"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button styleClass="pt-btn-solid" minHeight="30" minWidth="72" text="生成"
                                    userData="i18n:freekill.generate" onAction="#godWebshellGeneration"/>
                        </HBox>
                    </VBox>

                    <!-- Behinder 卡片 -->
                    <VBox styleClass="fk-shell-card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Behinder" styleClass="fk-shell-name"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="tipTitleBeh" styleClass="fk-shell-path" visible="false"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="语言" styleClass="pt-caption" userData="i18n:freekill.language"/>
                            <ComboBox fx:id="behComboBox" prefHeight="30" minWidth="90" prefWidth="90" onAction="#behChoose">
                                <items><FXCollections fx:factory="observableArrayList">
                                    <String fx:value="jsp"/><String fx:value="jspx"/><String fx:value="php"/>
                                    <String fx:value="asp"/><String fx:value="aspx"/>
                                </FXCollections></items>
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </ComboBox>
                            <Label text="编码" styleClass="pt-caption" userData="i18n:freekill.encoding"/>
                            <ComboBox fx:id="behModeComboBox" prefHeight="30" minWidth="180" prefWidth="180">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </ComboBox>
                            <Label text="密码" styleClass="pt-caption" userData="i18n:freekill.password"/>
                            <TextField styleClass="pt-input" fx:id="behKey" prefHeight="30" minWidth="130" prefWidth="130"
                                       promptText="随机生成" userData="i18n-prompt:freekill.password.placeholder"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button styleClass="pt-btn-solid" minHeight="30" minWidth="72" text="生成"
                                    userData="i18n:freekill.generate" onAction="#behWebshellGeneration"/>
                        </HBox>
                    </VBox>

                    <!-- AntSword 卡片 -->
                    <VBox styleClass="fk-shell-card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="AntSword" styleClass="fk-shell-name"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="tipTitleAnt" styleClass="fk-shell-path" visible="false"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="语言" styleClass="pt-caption" userData="i18n:freekill.language"/>
                            <ComboBox fx:id="antComboBox" prefHeight="30" minWidth="90" prefWidth="90" onAction="#antChoose">
                                <items><FXCollections fx:factory="observableArrayList">
                                    <String fx:value="jsp"/><String fx:value="jspx"/><String fx:value="php"/>
                                    <String fx:value="asp"/><String fx:value="aspx"/>
                                </FXCollections></items>
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </ComboBox>
                            <Label text="编码" styleClass="pt-caption" userData="i18n:freekill.encoding"/>
                            <ComboBox fx:id="antModeComboBox" prefHeight="30" minWidth="180" prefWidth="180">
                                <items><FXCollections fx:id="antFXCollections" fx:factory="observableArrayList"/></items>
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </ComboBox>
                            <Label text="密码" styleClass="pt-caption" userData="i18n:freekill.password"/>
                            <TextField styleClass="pt-input" fx:id="antKey" prefHeight="30" minWidth="130" prefWidth="130"
                                       promptText="随机生成" userData="i18n-prompt:freekill.password.placeholder"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button styleClass="pt-btn-solid" minHeight="30" minWidth="72" text="生成"
                                    userData="i18n:freekill.generate" onAction="#antWebshellGeneration"/>
                        </HBox>
                    </VBox>

                    <!-- Cmd 卡片 -->
                    <VBox styleClass="fk-shell-card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Cmd" styleClass="fk-shell-name"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="tipTitleCmd" styleClass="fk-shell-path" visible="false"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="语言" styleClass="pt-caption" userData="i18n:freekill.language"/>
                            <ComboBox fx:id="cmdComboBox" prefHeight="30" minWidth="90" prefWidth="90" onAction="#cmdChoose">
                                <items><FXCollections fx:factory="observableArrayList">
                                    <String fx:value="jsp"/><String fx:value="jspx"/><String fx:value="ashx"/>
                                </FXCollections></items>
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </ComboBox>
                            <Label text="编码" styleClass="pt-caption" userData="i18n:freekill.encoding"/>
                            <ComboBox fx:id="cmdModeComboBox" prefHeight="30" minWidth="180" prefWidth="180">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </ComboBox>
                            <Label text="密码" styleClass="pt-caption" userData="i18n:freekill.password"/>
                            <TextField styleClass="pt-input" fx:id="cmdKey" prefHeight="30" minWidth="130" prefWidth="130"
                                       promptText="随机生成" userData="i18n-prompt:freekill.password.placeholder"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button styleClass="pt-btn-solid" minHeight="30" minWidth="72" text="生成"
                                    userData="i18n:freekill.generate" onAction="#cmdWebshellGeneration"/>
                        </HBox>
                    </VBox>

                </VBox>

                <VBox fx:id="signatureContent" maxHeight="${sPane.height}" alignment="CENTER" managed="false" visible="false">
                    <VBox styleClass="paddingVBox" prefWidth="${signatureContent.width}" spacing="30" alignment="CENTER">
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="无签名木马文件路径：" userData="i18n:freekill.sig.unsigned"/>
                            <StackPane>
                                <TextField styleClass="pt-input" style="-fx-padding: 5 80 5 5;" fx:id="sigFilePath" promptText="输入文件路径" userData="i18n-prompt:freekill.sig.path.placeholder" prefWidth="400" StackPane.alignment="CENTER"/>
                                <Button styleClass="pt-btn" text="选择文件" userData="i18n:freekill.sig.selectfile" onAction="#getSigFilePath" StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="有签名正规文件路径：" userData="i18n:freekill.sig.signed"/>
                            <StackPane>
                                <TextField styleClass="pt-input" style="-fx-padding: 5 80 5 5;" fx:id="exePath" promptText="输入文件路径" userData="i18n-prompt:freekill.sig.path.placeholder" prefWidth="400" StackPane.alignment="CENTER"/>
                                <Button styleClass="pt-btn" text="选择文件" userData="i18n:freekill.sig.selectfile" onAction="#getExePath" StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER">
                            <Button styleClass="pt-btn-solid" fx:id="addBtn" minHeight="40.0" minWidth="150" text="伪造" userData="i18n:freekill.sig.fake" onAction="#toSigna">
                                <effect>
                                    <DropShadow />
                                </effect>
                            </Button>
                        </HBox>
                        <Label fx:id="tipTitleSigna" wrapText="true" textAlignment="CENTER" visible="false"/>
                    </VBox>
                </VBox>

                <VBox fx:id="QRContent" maxHeight="${sPane.height}" alignment="CENTER" managed="false" visible="false">
                    <VBox styleClass="paddingVBox" prefWidth="${QRContent.width}" spacing="30" alignment="CENTER">
                        <HBox alignment="CENTER" spacing="10">
                            <Label fx:id="contentQrLabel" text="二维码内容：" userData="i18n:freekill.qr.content"/>
                            <TextField styleClass="pt-input" fx:id="contentQR" text="https://www.baidu.com" promptText="输入二维码内容/网址" userData="i18n-prompt:freekill.qr.content.placeholder" prefWidth="400" StackPane.alignment="CENTER"/>
                        </HBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Label minWidth="${contentQrLabel.width}" text="二维码宽高：" userData="i18n:freekill.qr.size"/>
                            <TextField styleClass="pt-input" fx:id="widthQR" text="300" promptText="输入二维码宽度/高度" userData="i18n-prompt:freekill.qr.size.placeholder" prefWidth="400" StackPane.alignment="CENTER"/>
                        </HBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Label minWidth="${contentQrLabel.width}" text="Logo路径：" userData="i18n:freekill.qr.logo"/>
                            <StackPane>
                                <TextField styleClass="pt-input" style="-fx-padding: 5 80 5 5;" fx:id="logoPath" promptText="输入logo文件路径，可为空" userData="i18n-prompt:freekill.qr.logo.placeholder" prefWidth="400" StackPane.alignment="CENTER"/>
                                <Button styleClass="pt-btn" text="选择文件" userData="i18n:freekill.qr.selectfile" onAction="#getLogoPath" StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Label minWidth="${contentQrLabel.width}" text="logo宽高：" userData="i18n:freekill.qr.logosize"/>
                            <TextField styleClass="pt-input" fx:id="widthLogo" text="60" promptText="输入logo宽度/高度(过大易无法识别二维码)" userData="i18n-prompt:freekill.qr.logosize.placeholder" prefWidth="400" StackPane.alignment="CENTER"/>
                        </HBox>
                        <HBox alignment="CENTER">
                            <Button styleClass="pt-btn-solid" minHeight="40.0" minWidth="150" text="生成二维码" userData="i18n:freekill.qr.generate" onAction="#toQr">
                                <effect>
                                    <DropShadow />
                                </effect>
                            </Button>
                        </HBox>
                        <Label fx:id="tipTitleQR" wrapText="true" textAlignment="CENTER" visible="false"/>
                    </VBox>
                </VBox>

                <VBox fx:id="secureProtectContent" styleClass="closeImg" maxHeight="${sPane.height}" spacing="30" alignment="CENTER" managed="false" visible="false">
                    <HBox alignment="CENTER" spacing="10">
                        <Label minWidth="${contentQrLabel.width}" text="文件路径：" userData="i18n:freekill.packer.filepath"/>
                        <StackPane>
                            <TextField styleClass="pt-input" style="-fx-padding: 5 80 5 5;" fx:id="filePath" promptText="输入文件路径" userData="i18n-prompt:freekill.packer.filepath.placeholder" prefWidth="400" StackPane.alignment="CENTER"/>
                            <Button styleClass="pt-btn" text="选择文件" userData="i18n:freekill.packer.selectfile" onAction="#getLogoPath" StackPane.alignment="CENTER_RIGHT"/>
                        </StackPane>
                    </HBox>

                    <Label styleClass="pt-section-label" text="基本信息" userData="i18n:freekill.packer.basicinfo"/>

                    <VBox styleClass="paddingVBox" spacing="10" alignment="CENTER">
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="文件位置：" userData="i18n:freekill.packer.location"/>
                            <Label fx:id="filePos"/>
                        </HBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="文件创建时间：" userData="i18n:freekill.packer.createtime"/>
                            <Label fx:id="fileCreateTime"/>
                        </HBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="文件修改时间：" userData="i18n:freekill.packer.modifytime"/>
                            <Label fx:id="fileChangeTime"/>
                        </HBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="文件最后访问时间：" userData="i18n:freekill.packer.accesstime"/>
                            <Label fx:id="fileRunTime"/>
                        </HBox>
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="文件类型：" userData="i18n:freekill.packer.filetype"/>
                            <Label fx:id="fileType"/>
                        </HBox>
                    </VBox>

                    <Label styleClass="pt-section-label" text="加密选项" userData="i18n:freekill.packer.encryption"/>

                    <VBox alignment="CENTER_LEFT"  styleClass="paddingVBox" style="-fx-padding: 20" spacing="10">
                        <CFCheckBox fx:id="isImportPro" alignment="CENTER" mnemonicParsing="false" selected="false" text="导入表保护" userData="i18n:freekill.packer.importpro"/>
                        <CFCheckBox fx:id="isMemoryPro" alignment="CENTER" mnemonicParsing="false" selected="false" text="内存校验" userData="i18n:freekill.packer.memorypro"/>
                        <CFCheckBox fx:id="isCompressPro" alignment="CENTER" mnemonicParsing="false" selected="false" text="压缩" userData="i18n:freekill.packer.compress"/>
                        <CFCheckBox fx:id="isResPro" alignment="CENTER" mnemonicParsing="false" selected="false" text="资源节加密" userData="i18n:freekill.packer.resourcepro"/>
                        <CFCheckBox fx:id="isDebuggerDetection" alignment="CENTER" mnemonicParsing="false" selected="false" text="调试器检测" userData="i18n:freekill.packer.debugdetect"/>
                        <CFCheckBox fx:id="isVirtualDetection" alignment="CENTER" mnemonicParsing="false" selected="false" text="虚拟机检测" userData="i18n:freekill.packer.vmdetect"/>
                    </VBox>

                    <Label styleClass="pt-section-label" text="函数选项" userData="i18n:freekill.packer.function"/>

                    <VBox styleClass="paddingVBox" style="-fx-padding: 20" spacing="10" alignment="CENTER">
                        <HBox spacing="20" alignment="CENTER">
                            <HBox alignment="CENTER" spacing="10">
                                <Label text="函数总数：" userData="i18n:freekill.packer.func.total"/>
                                <Label fx:id="funcSize" minWidth="100"/>
                            </HBox>
                            <HBox alignment="CENTER" spacing="10">
                                <Label text="混淆数：" userData="i18n:freekill.packer.func.confusion"/>
                                <Label fx:id="confusionSize" minWidth="100"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="10">
                                <Label text="虚拟化数：" userData="i18n:freekill.packer.func.virtual"/>
                                <Label fx:id="virtualizationSize" minWidth="100"/>
                            </HBox>
                            <HBox alignment="CENTER" spacing="10">
                                <Label text="加密数：" userData="i18n:freekill.packer.func.encrypt"/>
                                <Label fx:id="encodeSize" minWidth="100"/>
                            </HBox>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER">
                            <SmoothScrollPane maxHeight="500" hbarPolicy="NEVER">
                                <VBox minHeight="500" fx:id="vBoxBarFunc">
                                    <Accordion expandedPane="$myTitledPane">
                                        <panes>
                                            <TitledPane fx:id="myTitledPane" expanded="true">
                                                <graphic>
                                                    <Label prefWidth="150" text="函数地址表" userData="i18n:freekill.packer.func.table"/>
                                                </graphic>
                                                <content>
                                                    <VBox spacing="5" styleClass="vBox">
                                                        <Label text=" "/>
                                                        <Label text=" "/>
                                                        <Label text=" "/>
                                                        <Label text=" "/>
                                                        <Label text=" "/>
                                                        <Label text=" "/>
                                                        <Label text=" "/>
                                                        <Label text=" "/>
                                                        <Label text=" "/>
                                                    </VBox>
                                                </content>
                                            </TitledPane>
                                        </panes>
                                    </Accordion>
                                </VBox>
                            </SmoothScrollPane>
                            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="10">
                                <HBox alignment="CENTER" spacing="10">
                                    <Label text="保护方案：" userData="i18n:freekill.packer.protect"/>
                                    <ComboBox fx:id="getMode" prefHeight="20.0" prefWidth="250" userData="i18n-combobox:freekill.packer.protect.scheme; i18n-combobox-value:freekill.packer.protect.none" value="不保护">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="不保护" />
                                                <String fx:value="代码混淆" />
                                                <String fx:value="代码虚拟化" />
                                                <String fx:value="代码加密" />
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                </HBox>
                                <Label text="汇编代码" userData="i18n:freekill.packer.asmcode"/>
                                <VBox fx:id="assemblyCode">
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>
            </VBox>
        </SmoothScrollPane>
    </HBox>

    <!-- 右侧 BYPASS 面板（对齐 Penpot 修正版） -->
    <SmoothScrollPane fx:id="bypassPanelScroll"
                      maxHeight="${sPane.height}" maxWidth="195"
                      hbarPolicy="NEVER"
                      StackPane.alignment="TOP_RIGHT"
                      style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox styleClass="fk-bypass-panel" spacing="0">
            <VBox styleClass="fk-bypass-header">
                <Label text="BYPASS" styleClass="fk-bypass-section-label"/>
                <Label text="免杀工具" styleClass="fk-bypass-title" userData="i18n:freekill.panel.title"/>
            </VBox>
            <VBox styleClass="fk-bypass-items" spacing="0">
                <VBox styleClass="fk-bypass-item,fk-bypass-selected" onMouseClicked="#toWebshell">
                    <Label text="Shell 生成" styleClass="fk-bypass-item-name" userData="i18n:freekill.webshell"/>
                    <Label text="4 种 WebShell 类型" styleClass="fk-bypass-item-sub" userData="i18n:freekill.panel.webshell.sub"/>
                </VBox>
                <VBox styleClass="fk-bypass-item" onMouseClicked="#toSignature">
                    <Label text="签名伪造" styleClass="fk-bypass-item-name" userData="i18n:freekill.signature"/>
                    <Label text="复制目标签名" styleClass="fk-bypass-item-sub" userData="i18n:freekill.panel.signature.sub"/>
                </VBox>
                <VBox styleClass="fk-bypass-item" onMouseClicked="#toQR">
                    <Label text="二维码生成" styleClass="fk-bypass-item-name" userData="i18n:freekill.qrcode"/>
                    <Label text="嵌入 Logo" styleClass="fk-bypass-item-sub" userData="i18n:freekill.panel.qr.sub"/>
                </VBox>
                <VBox styleClass="fk-bypass-item" onMouseClicked="#toSecureProtect">
                    <Label text="保护配置" styleClass="fk-bypass-item-name" userData="i18n:freekill.packer"/>
                    <Label text="代码混淆 / 加密" styleClass="fk-bypass-item-sub" userData="i18n:freekill.panel.protect.sub"/>
                </VBox>
            </VBox>
            <Label text="STATES" styleClass="fk-bypass-states-label" userData="i18n:freekill.panel.states"/>
            <VBox styleClass="fk-bypass-states" spacing="8">
                <HBox styleClass="fk-state-chip" alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="fk-state-dot,fk-state-dot-generated"/>
                    <Label text="Shell 生成" styleClass="fk-state-label" userData="i18n:freekill.webshell"/>
                </HBox>
                <HBox styleClass="fk-state-chip" alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="fk-state-dot,fk-state-dot-tool"/>
                    <Label text="Godzilla ✓" styleClass="fk-state-label"/>
                </HBox>
            </VBox>
        </VBox>
    </SmoothScrollPane>

</StackPane>
