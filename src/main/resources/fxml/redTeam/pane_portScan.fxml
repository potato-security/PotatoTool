<?xml version="1.0" encoding="UTF-8"?>
<?import com.dlsc.gemsfx.CFCheckBox?>
<?import com.potato.potatotool.utils.ui.SmoothListView?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PanePortScan"
           stylesheets="@../../css/PanePortScan.css"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <!-- Hidden elements required by controller -->
    <ComboBox fx:id="portPresetComboBox" visible="false" managed="false"/>
    <ComboBox fx:id="exportFormatComboBox" visible="false" managed="false"/>

    <!-- Preset ToggleGroup (fx:define) -->
    <fx:define>
        <ToggleGroup fx:id="presetGroup"/>
    </fx:define>

    <!-- Main layout: left content + right session panel -->
    <HBox prefWidth="${sPane.width}" prefHeight="${sPane.height}" spacing="0">

        <!-- LEFT: main content -->
        <VBox HBox.hgrow="ALWAYS" styleClass="portscan-root" spacing="12">

            <!-- Target input + right controls -->
            <HBox spacing="12">
                <!-- Target textarea -->
                <SmoothTextArea fx:id="targetField" HBox.hgrow="ALWAYS" prefHeight="130"
                                styleClass="pt-input,portscan-target" wrapText="true"
                                promptText="请输入 IP/域名/CIDR，每行一个"
                                userData="i18n-prompt:portscan.target.placeholder"/>

                <!-- Right controls: presets + toggles -->
                <VBox spacing="8" prefWidth="200" minWidth="200" alignment="TOP_LEFT">

                    <!-- Port preset chips -->
                    <Label styleClass="pt-caption" text="端口预设" userData="i18n:portscan.preset"/>
                    <HBox spacing="4" styleClass="portscan-preset-row">
                        <ToggleButton fx:id="preset100Btn" text="Top100" styleClass="preset-chip"
                                      toggleGroup="$presetGroup" selected="true"
                                      userData="0" onAction="#onPresetChip"/>
                        <ToggleButton fx:id="preset1000Btn" text="Top1000" styleClass="preset-chip"
                                      toggleGroup="$presetGroup"
                                      userData="1" onAction="#onPresetChip"/>
                        <ToggleButton fx:id="presetAllBtn" text="All" styleClass="preset-chip"
                                      toggleGroup="$presetGroup"
                                      userData="2" onAction="#onPresetChip"/>
                        <ToggleButton fx:id="presetCustomBtn" text="Custom" styleClass="preset-chip"
                                      toggleGroup="$presetGroup"
                                      userData="3" onAction="#onPresetChip"/>
                    </HBox>

                    <!-- Service / Public Mode toggles -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <CFCheckBox fx:id="serviceProbeBox" text="服务识别"
                                    userData="i18n:portscan.serviceprobe"/>
                        <CFCheckBox fx:id="publicModeBox" text="公网限速"
                                    userData="i18n:portscan.publicmode"/>
                    </HBox>

                    <!-- Timeout + Batch -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="超时(ms)" styleClass="pt-caption" userData="i18n:portscan.timeout"/>
                        <TextField fx:id="timeoutField" prefWidth="72" styleClass="pt-input"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Batch" styleClass="pt-caption" userData="i18n:portscan.batch"/>
                        <TextField fx:id="batchSizeField" prefWidth="72" styleClass="pt-input"/>
                    </HBox>

                </VBox>
            </HBox>

            <!-- Config TitledPane (custom ports + autoHandoff) -->
            <TitledPane fx:id="configTitledPane" text="高级配置" expanded="false" animated="true"
                        styleClass="compact-config-pane" maxWidth="Infinity"
                        userData="i18n:portscan.config">
                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding:8 12 8 12;">
                    <Label text="自定义端口" styleClass="pt-caption" userData="i18n:portscan.custom.ports"/>
                    <TextField fx:id="customPortsField" prefWidth="200" promptText="80,443,8000-9000" styleClass="pt-input"/>
                    <CFCheckBox fx:id="autoHandoffBox" text="完成后送入漏扫" userData="i18n:portscan.autohandoff"/>
                </HBox>
            </TitledPane>

            <!-- Action buttons -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="startButton" text="开始扫描" onMouseClicked="#startScan"
                        styleClass="pt-btn-primary" userData="i18n:portscan.start"/>
                <Button fx:id="pauseButton" text="暂停" onMouseClicked="#pauseScan"
                        styleClass="pt-btn" userData="i18n:portscan.pause"/>
                <Button fx:id="resumeButton" text="恢复" onMouseClicked="#resumeScan"
                        styleClass="pt-btn" userData="i18n:portscan.resume"/>
                <Button fx:id="stopButton" text="停止" onMouseClicked="#stopScan"
                        styleClass="pt-btn-danger" userData="i18n:portscan.stop"/>
                <Button text="清空结果" onMouseClicked="#clearResults"
                        styleClass="pt-btn" userData="i18n:portscan.clear"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="导出" onMouseClicked="#exportSelected"
                        styleClass="pt-btn" userData="i18n:portscan.export"/>
                <Button fx:id="handoffButton" text="送入漏扫" onMouseClicked="#handoffToVulnScan"
                        styleClass="pt-btn" userData="i18n:portscan.handoff"/>
            </HBox>

            <!-- Status row -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="scanStateLabel" text="Ready" styleClass="pt-chip"/>
                <ProgressBar fx:id="progressBar" prefWidth="240" progress="0" HBox.hgrow="NEVER"/>
                <Label fx:id="progressLabel" text="0 / 0" styleClass="pt-mono"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="开放端口:" styleClass="pt-caption" userData="i18n:portscan.open.count"/>
                <Label fx:id="openCountLabel" text="0" styleClass="pt-mono,portscan-open-count"/>
            </HBox>

            <!-- Result table -->
            <TableView fx:id="resultTable" VBox.vgrow="ALWAYS" maxWidth="Infinity"
                       styleClass="pt-table,portscan-result-table">
                <columns>
                    <TableColumn fx:id="hostColumn" text="Host" prefWidth="150"/>
                    <TableColumn fx:id="portColumn" text="Port" prefWidth="70"/>
                    <TableColumn fx:id="stateColumn" text="State" prefWidth="80"/>
                    <TableColumn fx:id="serviceColumn" text="Service" prefWidth="110"/>
                    <TableColumn fx:id="rttColumn" text="RTT" prefWidth="60"/>
                    <TableColumn fx:id="bannerColumn" text="Banner" prefWidth="300"/>
                    <TableColumn fx:id="actionColumn" text="Vuln" prefWidth="60"/>
                </columns>
            </TableView>

        </VBox>

        <!-- RIGHT: SCAN SESSION panel (always visible) -->
        <VBox styleClass="portscan-session-panel" prefWidth="220" minWidth="220">

            <VBox styleClass="portscan-session-header">
                <Label text="SCAN SESSION" styleClass="portscan-session-title"/>
                <Label text="扫描历史" styleClass="portscan-session-heading" userData="i18n:portscan.history.heading"/>
                <Label fx:id="historyCountLabel" text="" styleClass="pt-caption,portscan-hist-count"/>
            </VBox>

            <SmoothListView fx:id="historyListView" VBox.vgrow="ALWAYS"
                            styleClass="portscan-history-list"/>

            <!-- History action buttons -->
            <HBox spacing="6" alignment="CENTER_RIGHT" styleClass="portscan-session-footer">
                <Button text="打开" onMouseClicked="#openSelectedHistory"
                        styleClass="pt-btn" userData="i18n:portscan.history.open"/>
                <Button text="删除" onMouseClicked="#deleteSelectedHistory"
                        styleClass="pt-btn" userData="i18n:app.delete"/>
                <Button text="清空" onMouseClicked="#clearAllHistory"
                        styleClass="pt-btn-danger" userData="i18n:portscan.history.clear"/>
            </HBox>

        </VBox>

    </HBox>

    <!-- Prompt overlay -->
    <StackPane fx:id="promptPane" visible="false" managed="false"
               StackPane.alignment="CENTER"
               maxHeight="-Infinity" maxWidth="-Infinity"
               onMouseClicked="#closePromptPane">
        <Label fx:id="promptLabel" text="" wrapText="true" textAlignment="CENTER"
               alignment="CENTER" maxWidth="600"/>
    </StackPane>

</StackPane>
