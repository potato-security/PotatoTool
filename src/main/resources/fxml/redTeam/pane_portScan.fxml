<?xml version="1.0" encoding="UTF-8"?>
<?import com.dlsc.gemsfx.CFCheckBox?>
<?import com.potato.potatotool.utils.ui.SmoothTableView?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PanePortScan"
           stylesheets="@../../css/PanePortScan.css"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">
    <VBox alignment="TOP_CENTER" prefWidth="${sPane.width}" maxWidth="${sPane.width}" spacing="12" styleClass="portscan-root">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="5" minWidth="120">
                <Label text="端口预设" styleClass="title-label" userData="i18n:portscan.preset"/>
                <ComboBox fx:id="portPresetComboBox" prefWidth="120"/>
            </VBox>
            <StackPane HBox.hgrow="ALWAYS">
                <SmoothTextArea fx:id="targetField" prefHeight="80" wrapText="true" promptText="请输入 IP/域名/CIDR，每行一个" userData="i18n-prompt:portscan.target.placeholder" id="targetField"/>
            </StackPane>
        </HBox>

        <TitledPane fx:id="configTitledPane" text="扫描配置" expanded="false" animated="true"
                    styleClass="compact-config-pane" prefWidth="${sPane.width}" maxWidth="${sPane.width}"
                    userData="i18n:portscan.config">
            <VBox id="settingVbox" maxWidth="Infinity">
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                    <HBox id="topLeftTitle" alignment="CENTER">
                        <Label text="端口配置" userData="i18n:portscan.config.ports"/>
                    </HBox>
                    <FlowPane id="topRightTitle" HBox.hgrow="ALWAYS" hgap="12" vgap="8" alignment="CENTER_LEFT">
                        <Label text="自定义端口" userData="i18n:portscan.custom.ports"/>
                        <TextField fx:id="customPortsField" prefWidth="160" promptText="80,443,8000-9000"/>
                        <Label text="超时(ms)" userData="i18n:portscan.timeout"/>
                        <TextField fx:id="timeoutField" prefWidth="70"/>
                        <Label text="Batch" userData="i18n:portscan.batch"/>
                        <TextField fx:id="batchSizeField" prefWidth="70"/>
                        <CFCheckBox fx:id="serviceProbeBox" text="服务识别" userData="i18n:portscan.serviceprobe"/>
                        <CFCheckBox fx:id="publicModeBox" text="公网限速" userData="i18n:portscan.publicmode"/>
                        <CFCheckBox fx:id="autoHandoffBox" text="完成后送入漏扫" userData="i18n:portscan.autohandoff"/>
                    </FlowPane>
                </HBox>
            </VBox>
        </TitledPane>

        <HBox alignment="CENTER_LEFT" spacing="8" maxWidth="Infinity">
            <Button fx:id="startButton" text="开始扫描" onMouseClicked="#startScan" styleClass="primary-button" userData="i18n:portscan.start"/>
            <Button fx:id="pauseButton" text="暂停" onMouseClicked="#pauseScan" styleClass="small-button" userData="i18n:portscan.pause"/>
            <Button fx:id="resumeButton" text="恢复" onMouseClicked="#resumeScan" styleClass="small-button" userData="i18n:portscan.resume"/>
            <Button fx:id="stopButton" text="停止" onMouseClicked="#stopScan" styleClass="danger-button" userData="i18n:portscan.stop"/>
            <Button text="清空结果" onMouseClicked="#clearResults" styleClass="small-button" userData="i18n:portscan.clear"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="格式" userData="i18n:portscan.export.format" style="-fx-text-fill: -main-linenoText-color;"/>
            <ComboBox fx:id="exportFormatComboBox" prefWidth="90"/>
            <Button text="导出" onMouseClicked="#exportSelected" styleClass="small-button" userData="i18n:portscan.export"/>
            <Button text="历史记录" onMouseClicked="#showHistory" styleClass="small-button" userData="i18n:portscan.history"/>
            <Button fx:id="handoffButton" text="送入漏扫" onMouseClicked="#handoffToVulnScan" styleClass="small-button" userData="i18n:portscan.handoff"/>
        </HBox>

        <HBox spacing="16" alignment="CENTER_LEFT" prefWidth="${sPane.width}">
            <Label text="状态:" userData="i18n:portscan.status.label"/>
            <Label fx:id="scanStateLabel" text="Ready"/>
            <ProgressBar fx:id="progressBar" prefWidth="260" progress="0"/>
            <Label fx:id="progressLabel" text="0 / 0"/>
            <Label text="开放端口:" userData="i18n:portscan.open.count"/>
            <Label fx:id="openCountLabel" text="0"/>
        </HBox>

        <TableView fx:id="resultTable" VBox.vgrow="ALWAYS" prefWidth="${sPane.width}" maxWidth="${sPane.width}" prefHeight="420" styleClass="portscan-result-table">
            <columns>
                <TableColumn fx:id="hostColumn" text="Host" prefWidth="150"/>
                <TableColumn fx:id="portColumn" text="Port" prefWidth="70"/>
                <TableColumn fx:id="stateColumn" text="State" prefWidth="90"/>
                <TableColumn fx:id="serviceColumn" text="Service" prefWidth="120"/>
                <TableColumn fx:id="rttColumn" text="RTT" prefWidth="70"/>
                <TableColumn fx:id="bannerColumn" text="Banner" prefWidth="420"/>
                <TableColumn fx:id="actionColumn" text="Vuln" prefWidth="70"/>
            </columns>
        </TableView>

    </VBox>

    <StackPane fx:id="historyMask" visible="false" managed="false" styleClass="dialog-mask" onMouseClicked="#closeHistoryByMask">
        <VBox fx:id="historyPane" styleClass="manage-pane" StackPane.alignment="CENTER"
              onMouseClicked="#consumePromptEvent"
              prefWidth="820" prefHeight="520" maxWidth="820" maxHeight="520">
            <HBox alignment="CENTER_LEFT" styleClass="manage-header">
                <Label text="端口扫描历史" styleClass="manage-title" userData="i18n:portscan.history.title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="historyCountLabel" text="共 0 条" style="-fx-text-fill: -main-linenoText-color; -fx-padding: 0 12 0 0;"/>
                <Label text="✕" styleClass="close-button" onMouseClicked="#closeHistory"/>
            </HBox>
            <SmoothTableView fx:id="historyTableView" VBox.vgrow="ALWAYS" styleClass="history-table">
                <columns>
                    <TableColumn fx:id="historyTimeColumn" text="扫描时间" prefWidth="170" userData="i18n:portscan.column.time"/>
                    <TableColumn fx:id="historyOpenColumn" text="开放端口" prefWidth="90" style="-fx-alignment: CENTER;" userData="i18n:portscan.column.openports"/>
                    <TableColumn fx:id="historyTaskColumn" text="进度" prefWidth="110" style="-fx-alignment: CENTER;" userData="i18n:portscan.column.progress"/>
                    <TableColumn fx:id="historyDurationColumn" text="耗时" prefWidth="90" style="-fx-alignment: CENTER;" userData="i18n:portscan.column.duration"/>
                    <TableColumn fx:id="historyScanIdColumn" text="ID" prefWidth="260" userData="i18n:portscan.column.scanid"/>
                </columns>
            </SmoothTableView>
            <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 12 16 12 16; -fx-border-color: -main-lineno-color; -fx-border-width: 1 0 0 0;">
                <Button text="打开" onMouseClicked="#openSelectedHistory" styleClass="small-button" userData="i18n:portscan.history.open"/>
                <Button text="删除" onMouseClicked="#deleteSelectedHistory" styleClass="small-button" userData="i18n:app.delete"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="清空历史" onMouseClicked="#clearAllHistory" styleClass="danger-button" userData="i18n:portscan.history.clear"/>
            </HBox>
        </VBox>
    </StackPane>

    <StackPane fx:id="promptPane" visible="false" managed="false"
               StackPane.alignment="CENTER"
               maxHeight="-Infinity" maxWidth="-Infinity"
               onMouseClicked="#closePromptPane">
        <Label fx:id="promptLabel" text="" wrapText="true" textAlignment="CENTER" alignment="CENTER" maxWidth="600"/>
    </StackPane>
</StackPane>
