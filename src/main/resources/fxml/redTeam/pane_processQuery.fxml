<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/PaneProcessQuery.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PaneProcessQuery"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <VBox styleClass="proc-root" spacing="16">

        <!-- 1. 输入区：紧凑输入带 + 右侧动作按钮 (对齐 Penpot 设计) -->
        <VBox spacing="6">
            <Label text="进程列表输入" styleClass="pt-section-label" userData="i18n:process.input.caption"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <SmoothTextArea fx:id="inputText" styleClass="pt-input,pt-mono" wrapText="true"
                                prefHeight="52" minHeight="52" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                promptText="请输入tasklist或者ps aux执行后的内容"
                                userData="i18n-prompt:process.input.placeholder"/>
                <Button text="开始提取" styleClass="pt-btn-solid" minWidth="104" prefHeight="52"
                        userData="i18n:process.extract" onAction="#getInfo"/>
            </HBox>
        </VBox>

        <!-- 2. 结果双面板：等宽字体输出 -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <VBox styleClass="proc-panel" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="安全软件检测" styleClass="proc-panel-title" userData="i18n:process.antivirus"/>
                <Region styleClass="proc-panel-divider" maxWidth="Infinity"/>
                <VBox styleClass="proc-inset" VBox.vgrow="ALWAYS">
                    <Label text="NAME        TYPE" styleClass="proc-col-header" userData="i18n:process.antivirus.cols"/>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="proc-output-scroll" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox fx:id="antivirus" styleClass="proc-rows" spacing="2"/>
                    </ScrollPane>
                </VBox>
            </VBox>

            <VBox styleClass="proc-panel" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="可提权进程" styleClass="proc-panel-title" userData="i18n:process.other"/>
                <Region styleClass="proc-panel-divider" maxWidth="Infinity"/>
                <VBox styleClass="proc-inset" VBox.vgrow="ALWAYS">
                    <Label text="PROCESS        PID" styleClass="proc-col-header" userData="i18n:process.other.cols"/>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="proc-output-scroll" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox fx:id="canRoot" styleClass="proc-rows" spacing="2"/>
                    </ScrollPane>
                </VBox>
            </VBox>

        </HBox>

    </VBox>

</StackPane>
