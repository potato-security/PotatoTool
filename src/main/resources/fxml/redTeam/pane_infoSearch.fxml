<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Cursor?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import com.dlsc.gemsfx.CFCheckBox?>
<?import javafx.scene.effect.DropShadow?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/PaneInfoSearch.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PaneInfoSearch"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <!-- Main two-column layout -->
    <HBox prefWidth="${sPane.width}" prefHeight="${sPane.height}" spacing="0">

        <!-- ===== LEFT: main content ===== -->
        <VBox HBox.hgrow="ALWAYS" spacing="0">

            <!-- Stats bar -->
            <HBox styleClass="is-stats-bar" alignment="CENTER_LEFT" spacing="0">
                <Label text="DOMAINS" styleClass="is-stat-key"/>
                <Label fx:id="statDomains" text="—" styleClass="is-stat-val"/>
                <Region prefWidth="20"/>
                <Label text="SUBS" styleClass="is-stat-key"/>
                <Label fx:id="statSubs" text="—" styleClass="is-stat-val"/>
                <Region prefWidth="20"/>
                <Label text="IPS" styleClass="is-stat-key"/>
                <Label fx:id="statIps" text="—" styleClass="is-stat-val"/>
                <Region prefWidth="20"/>
                <Label text="PORTS" styleClass="is-stat-key"/>
                <Label fx:id="statPorts" text="—" styleClass="is-stat-val"/>
                <Region prefWidth="20"/>
                <Label text="APIS" styleClass="is-stat-key"/>
                <Label fx:id="statApis" text="—" styleClass="is-stat-val"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Page header row -->
            <HBox styleClass="is-header-row" alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="信息收集" styleClass="is-h1" userData="i18n:infosearch.page.title"/>
                    <Label text="资产测绘 · 多源聚合检索 (Fofa / Quake / Hunter)"
                           styleClass="is-subtitle" userData="i18n:infosearch.page.subtitle"/>
                </VBox>
                <Button fx:id="uploadBtn" styleClass="pt-btn" text="批量上传"
                        onAction="#searchUploadInput" userData="i18n:infosearch.batch"
                        minHeight="36"/>
                <Button fx:id="searchBtn" styleClass="pt-btn-primary" text="开始测绘"
                        onAction="#searchInput" userData="i18n:infosearch.search.start"
                        minHeight="36" minWidth="96"/>
                <Button fx:id="stopBtn" styleClass="pt-btn-danger" text="停止"
                        onAction="#stopSearch" userData="i18n:infosearch.stop"
                        visible="false" managed="false"
                        minHeight="36" minWidth="96"/>
            </HBox>

            <!-- Target input row -->
            <HBox styleClass="is-target-row" alignment="CENTER_LEFT" spacing="8">
                <Label text="目标" styleClass="is-target-label" userData="i18n:infosearch.target.label"/>
                <TextField fx:id="question" styleClass="pt-input,is-target-input" HBox.hgrow="ALWAYS"
                           promptText="example.com / 企业名称 / IP / 域名"
                           userData="i18n-prompt:infosearch.input.placeholder"/>
                <Button styleClass="pt-btn-primary" text="智能检索"
                        onAction="#searchInput" userData="i18n:infosearch.search.smart"
                        minHeight="36" minWidth="88"/>
            </HBox>

            <!-- Data source chips + mode selector -->
            <HBox styleClass="is-sources-row" alignment="CENTER_LEFT" spacing="8">
                <Label text="数据源" styleClass="is-section-label" userData="i18n:infosearch.platform"/>
                <ToggleButton fx:id="fofaBox" styleClass="is-source-chip" text="Fofa"
                              onAction="#checkFofa"/>
                <ToggleButton fx:id="quakeBox" styleClass="is-source-chip" text="Quake"
                              onAction="#checkQuake"/>
                <ToggleButton fx:id="hunterBox" styleClass="is-source-chip" text="Hunter"
                              onAction="#checkHunter"/>
                <ToggleButton fx:id="shodanBox" styleClass="is-source-chip" text="Shodan"
                              onAction="#checkShodan"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="模式" styleClass="is-section-label" userData="i18n:infosearch.mode"/>
                <ComboBox fx:id="searchModeBox" prefWidth="110" prefHeight="30"
                          userData="i18n-combobox:infosearch.mode" onAction="#chooseSearcchMode">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="智能检索" />
                            <String fx:value="标准检索" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <!-- Stat cards row -->
            <HBox styleClass="is-stat-cards" spacing="8">
                <VBox styleClass="is-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="● 子域" styleClass="is-stat-card-label" userData="i18n:infosearch.stat.subdomain"/>
                    <Label fx:id="statCardSubs" text="—" styleClass="is-stat-card-val"/>
                </VBox>
                <VBox styleClass="is-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="● IP" styleClass="is-stat-card-label"/>
                    <Label fx:id="statCardIps" text="—" styleClass="is-stat-card-val"/>
                </VBox>
                <VBox styleClass="is-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="● 端口" styleClass="is-stat-card-label" userData="i18n:infosearch.stat.port"/>
                    <Label fx:id="statCardPorts" text="—" styleClass="is-stat-card-val"/>
                </VBox>
                <VBox styleClass="is-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="● 指纹" styleClass="is-stat-card-label" userData="i18n:infosearch.stat.fingerprint"/>
                    <Label fx:id="statCardFps" text="—" styleClass="is-stat-card-val"/>
                </VBox>
            </HBox>

            <!-- Advanced settings (hidden by default, shown in 智能检索 mode) -->
            <HBox fx:id="advancedSetting" styleClass="is-advanced-row" alignment="CENTER_LEFT"
                  prefWidth="${sPane.width}" visible="false" managed="false" spacing="0">
                <VBox styleClass="is-advanced-panel" HBox.hgrow="ALWAYS" spacing="8">
                    <!-- Extra platforms: Zoomeye, Google, Github -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="扩展源" styleClass="is-section-label"/>
                        <CFCheckBox fx:id="zoomeyeBox" text="Zoomeye" onMouseClicked="#checkZoomeye"/>
                        <CFCheckBox fx:id="googleBox" text="Google" onMouseClicked="#checkGoogle"/>
                        <CFCheckBox fx:id="githubBox" text="Github" onMouseClicked="#checkGithub"/>
                    </HBox>
                    <!-- Advanced options -->
                    <FlowPane alignment="CENTER_LEFT" hgap="16" vgap="8">
                        <CFCheckBox fx:id="weightBox" text="连带子公司" selected="true"
                                    userData="i18n:infosearch.weight" onMouseClicked="#checkWeight">
                            <tooltip><Tooltip text="例:80,90【二级公司权重>=90%，三级公司权重>=90%】"
                                              userData="i18n:infosearch.weight.tooltip"/></tooltip>
                        </CFCheckBox>
                        <CFCheckBox fx:id="searchSslSubdomainBox" text="查询子域"
                                    userData="i18n:infosearch.subdomain">
                            <tooltip><Tooltip text="略微耗时，请自行评估是否开启"
                                              userData="i18n:infosearch.subdomain.tooltip"/></tooltip>
                        </CFCheckBox>
                        <CFCheckBox fx:id="bruteForceSubdomainBox" text="爆破子域"
                                    userData="i18n:infosearch.bruteforce">
                            <tooltip><Tooltip text="较为耗时，请自行评估是否开启"
                                              userData="i18n:infosearch.bruteforce.tooltip"/></tooltip>
                        </CFCheckBox>
                        <CFCheckBox fx:id="searchShadowAssetsBox" text="检索影子资产"
                                    userData="i18n:infosearch.shadow" onMouseClicked="#checkSearchShadowAssets">
                            <tooltip><Tooltip text="极度耗时，请自行评估是否开启"
                                              userData="i18n:infosearch.shadow.tooltip"/></tooltip>
                        </CFCheckBox>
                        <CFCheckBox fx:id="hasLocalFullDetectionBox" text="本地全量探测"
                                    userData="i18n:infosearch.fulldetect" onMouseClicked="#checkhasLocalFullDetection">
                            <tooltip><Tooltip text="较为耗时，请自行评估是否开启"
                                              userData="i18n:infosearch.fulldetect.tooltip"/></tooltip>
                        </CFCheckBox>
                        <CFCheckBox fx:id="hasIconSearchBox" text="Icon检索" selected="true"
                                    userData="i18n:infosearch.iconsearch" onMouseClicked="#checkhasIconSearch">
                            <tooltip><Tooltip text="较为耗时，请自行评估是否开启"
                                              userData="i18n:infosearch.iconsearch.tooltip"/></tooltip>
                        </CFCheckBox>
                        <CFCheckBox fx:id="hasCrawlLinksBox" text="爬取链接"
                                    userData="i18n:infosearch.crawllinks" onMouseClicked="#checkhasCrawlLinks">
                            <tooltip><Tooltip text="较为耗时，请自行评估是否开启"
                                              userData="i18n:infosearch.crawllinks.tooltip"/></tooltip>
                        </CFCheckBox>
                        <CFCheckBox fx:id="hasFindSensitiveInfoBox" text="获取敏感信息"
                                    userData="i18n:infosearch.sensitiveinfo">
                            <tooltip><Tooltip text="略微耗时，请自行评估是否开启"
                                              userData="i18n:infosearch.sensitiveinfo.tooltip"/></tooltip>
                        </CFCheckBox>
                        <CFCheckBox fx:id="hasCipAggregatorBox" text="C段聚合"
                                    userData="i18n:infosearch.cipaggregator" onMouseClicked="#checkhasCipAggregator">
                            <tooltip><Tooltip text="容易出现非资产内容，请自行评估是否开启"
                                              userData="i18n:infosearch.cipaggregator.tooltip"/></tooltip>
                        </CFCheckBox>
                        <!-- Conditional text fields -->
                        <HBox alignment="CENTER" fx:id="weightHBox">
                            <Label text="子公司权重：" styleClass="pt-body" userData="i18n:infosearch.weight.value"/>
                            <TextField fx:id="weightStr" styleClass="pt-input" prefWidth="120" text="100,100"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="maxDepthHBox" visible="false" managed="false">
                            <Label text="爬链接深度：" styleClass="pt-body" userData="i18n:infosearch.crawldepth"/>
                            <TextField fx:id="maxDepth" styleClass="pt-input" prefWidth="80" text="2"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="maxSubPathCountHBox" visible="false" managed="false">
                            <Label text="最大链接数：" styleClass="pt-body" userData="i18n:infosearch.maxlinks"/>
                            <TextField fx:id="maxSubPathCount" styleClass="pt-input" prefWidth="80" text="30"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="shadowAssetsThresholdHBox" visible="false" managed="false">
                            <Label text="影资量阈值：" styleClass="pt-body" userData="i18n:infosearch.shadow.threshold"/>
                            <TextField fx:id="shadowAssetsThreshold" styleClass="pt-input" prefWidth="80" text="50"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="maxGoogleSearchCountHBox" visible="false" managed="false">
                            <Label text="谷歌检索数：" styleClass="pt-body" userData="i18n:infosearch.google.count"/>
                            <TextField fx:id="maxGoogleSearchCount" styleClass="pt-input" prefWidth="80" text="10"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="maxGithubSearchCountHBox" visible="false" managed="false">
                            <Label text="仓库检索数：" styleClass="pt-body" userData="i18n:infosearch.github.count"/>
                            <TextField fx:id="maxGithubSearchCount" styleClass="pt-input" prefWidth="80" text="10"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="cipThresholdHBox" visible="false" managed="false">
                            <Label text=" C聚合阈值：" styleClass="pt-body" userData="i18n:infosearch.cip.threshold"/>
                            <TextField fx:id="cipThreshold" styleClass="pt-input" prefWidth="80" text="4"/>
                        </HBox>
                        <VBox fx:id="localFullDetectionThresholdHBox" visible="true" managed="true" spacing="5"
                              style="-fx-padding: 2 0 2 0;">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="目标数量 >" styleClass="pt-body" userData="i18n:infosearch.localdetect.condA.label"/>
                                <TextField fx:id="localFullDetectionThreshold" styleClass="pt-input" prefWidth="56" text="20"/>
                                <Label text="时执行完整检测" styleClass="pt-body" userData="i18n:infosearch.localdetect.condA.suffix"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="OR" styleClass="is-or-separator"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="目标类型包含" styleClass="pt-body" userData="i18n:infosearch.localdetect.condB.label"/>
                                <Label text="IP段/C段" styleClass="is-type-chip"/>
                                <Label text="时执行完整检测" styleClass="pt-body" userData="i18n:infosearch.localdetect.condB.suffix"/>
                            </HBox>
                            <Label text="满足任一条件即触发完整检测（OR 逻辑）" styleClass="pt-caption"
                                   userData="i18n:infosearch.localdetect.hint"/>
                        </VBox>
                    </FlowPane>
                </VBox>
            </HBox>

            <!-- Results area -->
            <SmoothScrollPane fx:id="scroll" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
                <VBox fx:id="echoVbox" alignment="TOP_LEFT" spacing="10"/>
            </SmoothScrollPane>

        </VBox>

        <!-- ===== RIGHT: context panel ===== -->
        <VBox styleClass="is-ctx-panel" prefWidth="200" minWidth="180">
            <VBox styleClass="is-ctx-header">
                <Label text="INFO" styleClass="is-ctx-section-label"/>
                <Label text="历史与状态" styleClass="is-ctx-title"
                       userData="i18n:infosearch.ctx.title"/>
            </VBox>
            <SmoothScrollPane VBox.vgrow="ALWAYS" hbarPolicy="NEVER" fitToWidth="true">
                <VBox fx:id="contextList" spacing="0"/>
            </SmoothScrollPane>
        </VBox>

    </HBox>

    <!-- Prompt overlay -->
    <StackPane fx:id="promptPane" visible="false" managed="false"
               maxHeight="-Infinity" maxWidth="-Infinity"
               alignment="CENTER" StackPane.alignment="CENTER">
        <Label fx:id="prompt" wrapText="true" textAlignment="CENTER" alignment="CENTER"
               minHeight="-Infinity" maxWidth="600"/>
    </StackPane>

    <!-- ===== Modal overlays (unchanged) ===== -->

    <VBox fx:id="companyNameChoosePaneBox" styleClass="choosePaneBox" visible="false" managed="false" alignment="CENTER">
        <HBox alignment="CENTER" translateY="-45">
            <effect><DropShadow/></effect>
            <VBox styleClass="choosePane" alignment="TOP_CENTER" spacing="10">
                <HBox alignment="CENTER" styleClass="titleHbox">
                    <Label styleClass="pt-h2" text="公司别名设置" userData="i18n:infosearch.company.alias.title"/>
                </HBox>
                <VBox styleClass="contentVbox" alignment="CENTER" spacing="20">
                    <Label styleClass="pt-caption" text="请增加/修改公司别名，将用于影子资产检索"
                           userData="i18n:infosearch.company.alias.desc"/>
                    <SmoothScrollPane maxHeight="250" hbarPolicy="NEVER" fitToWidth="true">
                        <VBox fx:id="companyNameVbox" spacing="10" alignment="CENTER"/>
                    </SmoothScrollPane>
                    <Button fx:id="companyNameSave" prefWidth="150" styleClass="pt-btn-primary"
                            text="下一步" userData="i18n:infosearch.next" onAction="#saveCompanyNameField"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="companyCandidateChoosePaneBox" styleClass="choosePaneBox" visible="false" managed="false" alignment="CENTER">
        <HBox alignment="CENTER" translateY="-45">
            <effect><DropShadow/></effect>
            <VBox styleClass="choosePane" alignment="TOP_CENTER" spacing="0" minWidth="660">
                <HBox alignment="CENTER_LEFT" styleClass="titleHbox" spacing="10">
                    <Label fx:id="companyCandidateTitle" styleClass="pt-h2" text="企业候选选择面板"
                           userData="i18n:infosearch.candidate.panel.title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="双模式切换" styleClass="is-dual-mode-badge"
                           userData="i18n:infosearch.candidate.dual.mode"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6"
                      style="-fx-padding: 8 16 8 16; -fx-border-color: -pt-border-subtle; -fx-border-width: 0 0 1 0;">
                    <ToggleButton fx:id="candidateSearchModeBtn" text="搜索企业"
                                  styleClass="is-mode-tab,is-mode-tab-selected"
                                  userData="i18n:infosearch.candidate.mode.search"
                                  onAction="#switchToCandidateSearchMode"/>
                    <ToggleButton fx:id="candidateManualModeBtn" text="手动输入"
                                  styleClass="is-mode-tab"
                                  userData="i18n:infosearch.candidate.mode.manual"
                                  onAction="#switchToCandidateManualMode"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="candidateModeLabel" text="MODE A" styleClass="is-mode-indicator"/>
                </HBox>
                <VBox styleClass="contentVbox" spacing="12">
                    <VBox fx:id="candidateModeASection" spacing="10">
                        <Label fx:id="companyCandidateDesc" styleClass="pt-caption"
                               text="请确认根公司候选，未确认前不会继续企业扩展"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="candidateSearchField" styleClass="pt-input" HBox.hgrow="ALWAYS"
                                       promptText="搜索企业名称"
                                       userData="i18n-prompt:infosearch.candidate.search.prompt"/>
                            <Button styleClass="pt-btn" text="搜 索" onAction="#searchCandidates"
                                    userData="i18n:infosearch.candidate.search.btn"
                                    minWidth="72" minHeight="30"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="候选企业列表" styleClass="pt-body"
                                   userData="i18n:infosearch.candidate.list.title"/>
                            <Label fx:id="candidateCountLabel" text="已选 0" styleClass="is-count-badge"/>
                        </HBox>
                        <SmoothScrollPane maxHeight="260" hbarPolicy="NEVER" fitToWidth="true">
                            <VBox fx:id="companyCandidateVbox" spacing="8" alignment="CENTER"/>
                        </SmoothScrollPane>
                    </VBox>
                    <VBox fx:id="candidateModeBSection" spacing="10" visible="false" managed="false">
                        <Label text="直接输入公司全称" styleClass="pt-caption"
                               userData="i18n:infosearch.candidate.manual.label"/>
                        <TextArea fx:id="candidateManualInput" styleClass="pt-input" prefHeight="120" wrapText="true"
                                  promptText="北京科技有限公司"
                                  userData="i18n-prompt:infosearch.candidate.manual.prompt"/>
                        <HBox alignment="CENTER">
                            <Button styleClass="pt-btn-primary" text="确 认" onAction="#confirmManualCandidate"
                                    userData="i18n:infosearch.candidate.confirm.btn"
                                    minWidth="100" minHeight="30"/>
                        </HBox>
                    </VBox>
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 4 0 0 0;">
                        <Button fx:id="companyCandidateSave" prefWidth="150" styleClass="pt-btn-primary"
                                text="确认并继续" onAction="#saveCompanyCandidateField"/>
                        <Button fx:id="companyCandidateNone" prefWidth="120" styleClass="pt-btn"
                                text="都不是" onAction="#chooseNoneCompanyCandidate"/>
                        <Button fx:id="companyCandidateCancel" prefWidth="120" styleClass="pt-btn"
                                text="取消" userData="i18n:app.cancel" onAction="#cancelCompanyCandidateField"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="iconChoosePaneBox" styleClass="choosePaneBox" visible="false" managed="false" alignment="CENTER">
        <HBox alignment="CENTER" translateY="-45">
            <effect><DropShadow/></effect>
            <VBox styleClass="choosePane" alignment="TOP_CENTER" spacing="10">
                <HBox alignment="CENTER" styleClass="titleHbox">
                    <Label styleClass="pt-h2" text="icon设置" userData="i18n:infosearch.icon.title"/>
                </HBox>
                <VBox styleClass="contentVbox" alignment="CENTER" spacing="20">
                    <Label styleClass="pt-caption"
                           text="请选择相关的icon，将用于基础检索 及 影子资产检索"
                           userData="i18n:infosearch.icon.desc"/>
                    <FlowPane fx:id="iconFlowPane" vgap="10" hgap="10" alignment="CENTER"/>
                    <Button fx:id="iconSave" prefWidth="150" styleClass="pt-btn-primary"
                            text="下一步" userData="i18n:infosearch.next" onAction="#saveIconField"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="domainChoosePaneBox" styleClass="choosePaneBox" visible="false" managed="false" alignment="CENTER">
        <HBox alignment="CENTER" translateY="-45">
            <effect><DropShadow/></effect>
            <VBox styleClass="choosePane" alignment="TOP_CENTER" spacing="10">
                <HBox alignment="CENTER" styleClass="titleHbox">
                    <Label styleClass="pt-h2" text="选择域名" userData="i18n:infosearch.domain.title"/>
                </HBox>
                <VBox styleClass="contentVbox" alignment="CENTER" spacing="20">
                    <Label styleClass="pt-caption" text="以下为反查到的域名，请选择"
                           userData="i18n:infosearch.domain.desc"/>
                    <SmoothScrollPane maxHeight="300" hbarPolicy="NEVER">
                        <VBox fx:id="domainVbox" spacing="10" alignment="CENTER"/>
                    </SmoothScrollPane>
                    <Button fx:id="domainSave" prefWidth="150" styleClass="pt-btn-primary"
                            text="下一步" userData="i18n:infosearch.next" onAction="#saveDomainField"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

</StackPane>
