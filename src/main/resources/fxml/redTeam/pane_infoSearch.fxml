<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Cursor?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import com.dlsc.gemsfx.CFCheckBox?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/PaneInfoSearch.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PaneInfoSearch"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <VBox prefHeight="${sPane.height}" prefWidth="${sPane.width}" alignment="TOP_CENTER" spacing="20">
        <HBox alignment="CENTER_LEFT" prefWidth="${sPane.width}" spacing="20">
            <HBox prefWidth="${sPane.width/2 - 230}" alignment="CENTER" spacing="10">
                <Label text="模式：" styleClass="pt-body" userData="i18n:infosearch.mode"/>
                <ComboBox fx:id="searchModeBox" prefHeight="20.0" prefWidth="130" userData="i18n-combobox:infosearch.mode" onAction="#chooseSearcchMode">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="智能检索" />
                            <String fx:value="标准检索" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>
            <StackPane maxWidth="${sPane.width/2}">
                <TextField fx:id="question" styleClass="pt-input" prefWidth="${sPane.width / 2}" minHeight="50" promptText="请输入需要检索的IP/域名/企业名称……" userData="i18n-prompt:infosearch.input.placeholder"/>
                <Pane maxWidth="0" maxHeight="35" StackPane.alignment="CENTER_RIGHT">
                    <HBox layoutX="-70" spacing="5" layoutY="3">
                        <Label fx:id="uploadLabel" visible="true" managed="true" onMouseClicked="#searchUploadInput">
                            <graphic>
                                <Region styleClass="upload"/>
                            </graphic>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <tooltip>
                                <Tooltip text="批量检索" userData="i18n:infosearch.batch"/>
                            </tooltip>
                        </Label>
                        <Label fx:id="sendLabel" visible="true" managed="true" onMouseClicked="#searchInput">
                            <graphic>
                                <Region styleClass="send"/>
                            </graphic>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <tooltip>
                                <Tooltip text="检索" userData="i18n:infosearch.search"/>
                            </tooltip>
                        </Label>
                        <Label  fx:id="stopLabel" visible="false" managed="false" onMouseClicked="#stopSearch">
                            <graphic>
                                <Region styleClass="stop"/>
                            </graphic>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <tooltip>
                                <Tooltip text="停止检索" userData="i18n:infosearch.stop"/>
                            </tooltip>
                        </Label>
                    </HBox>
                </Pane>
            </StackPane>
        </HBox>

        <VBox id="settingVbox" prefWidth="${sPane.width}">
            <HBox alignment="CENTER" prefWidth="${sPane.width}">
                <HBox alignment="CENTER" id="topLeftTitle" prefWidth="130">
                    <Label text="平台选择：" styleClass="pt-body" userData="i18n:infosearch.platform"/>
                </HBox>
                <FlowPane alignment="CENTER_LEFT" id="topRightTitle" prefWidth="${sPane.width - 130}" hgap="20" vgap="10">
                    <CFCheckBox fx:id="fofaBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="Fofa" VBox.vgrow="ALWAYS" onMouseClicked="#checkFofa" />
                    <CFCheckBox fx:id="hunterBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="Hunter" VBox.vgrow="ALWAYS" onMouseClicked="#checkHunter" />
                    <CFCheckBox fx:id="quakeBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="Quake" VBox.vgrow="ALWAYS" onMouseClicked="#checkQuake" />
                    <CFCheckBox fx:id="zoomeyeBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="Zoomeye" VBox.vgrow="ALWAYS" onMouseClicked="#checkZoomeye" />
                    <CFCheckBox fx:id="shodanBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="Shodan" VBox.vgrow="ALWAYS" onMouseClicked="#checkShodan" />
                    <CFCheckBox fx:id="googleBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="Google" VBox.vgrow="ALWAYS" onMouseClicked="#checkGoogle" />
                    <CFCheckBox fx:id="githubBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="Github" VBox.vgrow="ALWAYS" onMouseClicked="#checkGithub" />
                </FlowPane>
            </HBox>

            <HBox fx:id="advancedSetting" alignment="CENTER" prefWidth="${sPane.width}" visible="true" managed="true">
                <HBox alignment="CENTER" id="bottomLeftTitle" prefWidth="130">
                    <Label text="高级设置：" styleClass="pt-body" userData="i18n:infosearch.advanced"/>
                </HBox>
                <FlowPane alignment="CENTER_LEFT" id="bottomRightTitle" prefWidth="${sPane.width - 130}" hgap="20" vgap="10">
                    <CFCheckBox fx:id="weightBox" alignment="CENTER" mnemonicParsing="false" selected="true" text="连带子公司" userData="i18n:infosearch.weight" VBox.vgrow="ALWAYS" onMouseClicked="#checkWeight" >
                        <tooltip>
                            <Tooltip text="例:80,90【二级公司权重>=90%，三级公司权重>=90%】" userData="i18n:infosearch.weight.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="searchSslSubdomainBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="查询子域" userData="i18n:infosearch.subdomain" VBox.vgrow="ALWAYS">
                        <tooltip>
                            <Tooltip text="略微耗时，请自行评估是否开启" userData="i18n:infosearch.subdomain.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="bruteForceSubdomainBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="爆破子域" userData="i18n:infosearch.bruteforce" VBox.vgrow="ALWAYS">
                        <tooltip>
                            <Tooltip text="较为耗时，请自行评估是否开启" userData="i18n:infosearch.bruteforce.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="searchShadowAssetsBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="检索影子资产" userData="i18n:infosearch.shadow" VBox.vgrow="ALWAYS" onMouseClicked="#checkSearchShadowAssets" >
                        <tooltip>
                            <Tooltip text="极度耗时，请自行评估是否开启" userData="i18n:infosearch.shadow.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="hasLocalFullDetectionBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="本地全量探测" userData="i18n:infosearch.fulldetect" VBox.vgrow="ALWAYS" onMouseClicked="#checkhasLocalFullDetection" >
                        <tooltip>
                            <Tooltip text="较为耗时，请自行评估是否开启" userData="i18n:infosearch.fulldetect.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="hasIconSearchBox" alignment="CENTER" mnemonicParsing="false" selected="true" text="Icon检索" userData="i18n:infosearch.iconsearch" VBox.vgrow="ALWAYS" onMouseClicked="#checkhasIconSearch" >
                        <tooltip>
                            <Tooltip text="较为耗时，请自行评估是否开启" userData="i18n:infosearch.iconsearch.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="hasCrawlLinksBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="爬取链接" userData="i18n:infosearch.crawllinks" VBox.vgrow="ALWAYS" onMouseClicked="#checkhasCrawlLinks" >
                        <tooltip>
                            <Tooltip text="较为耗时，请自行评估是否开启" userData="i18n:infosearch.crawllinks.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="hasFindSensitiveInfoBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="获取敏感信息" userData="i18n:infosearch.sensitiveinfo" VBox.vgrow="ALWAYS">
                        <tooltip>
                            <Tooltip text="略微耗时，请自行评估是否开启" userData="i18n:infosearch.sensitiveinfo.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="hasCipAggregatorBox" alignment="CENTER" mnemonicParsing="false" selected="false" text="C段聚合" userData="i18n:infosearch.cipaggregator" VBox.vgrow="ALWAYS" onMouseClicked="#checkhasCipAggregator" >
                        <tooltip>
                            <Tooltip text="容易出现非资产内容，请自行评估是否开启" userData="i18n:infosearch.cipaggregator.tooltip"/>
                        </tooltip>
                    </CFCheckBox>

                    <FlowPane alignment="CENTER_LEFT"  prefWidth="${sPane.width - 170}" hgap="20" vgap="10">
                        <HBox alignment="CENTER" fx:id="weightHBox" visible="true" managed="true">
                            <Label text="子公司权重：" styleClass="pt-body" userData="i18n:infosearch.weight.value"/>
                            <TextField fx:id="weightStr" styleClass="pt-input" prefWidth="150" text="100,100"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="maxDepthHBox" visible="false" managed="false">
                            <Label text="爬链接深度：" styleClass="pt-body" userData="i18n:infosearch.crawldepth"/>
                            <TextField fx:id="maxDepth" styleClass="pt-input" prefWidth="150" text="2"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="maxSubPathCountHBox" visible="false" managed="false">
                            <Label text="最大链接数：" styleClass="pt-body" userData="i18n:infosearch.maxlinks"/>
                            <TextField fx:id="maxSubPathCount" styleClass="pt-input" prefWidth="150" text="30"/>
                        </HBox>
                        <VBox fx:id="localFullDetectionThresholdHBox" visible="true" managed="true" spacing="5" style="-fx-padding: 2 0 2 0;">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="目标数量 >" styleClass="pt-body" userData="i18n:infosearch.localdetect.condA.label"/>
                                <TextField fx:id="localFullDetectionThreshold" styleClass="pt-input" prefWidth="56" text="20"/>
                                <Label text="时执行完整检测" styleClass="pt-body" userData="i18n:infosearch.localdetect.condA.suffix"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="OR" styleClass="is-or-separator"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="目标类型包含" styleClass="pt-body" userData="i18n:infosearch.localdetect.condB.label"/>
                                <Label text="IP段/C段" styleClass="is-type-chip"/>
                                <Label text="时执行完整检测" styleClass="pt-body" userData="i18n:infosearch.localdetect.condB.suffix"/>
                            </HBox>
                            <Label text="满足任一条件即触发完整检测（OR 逻辑）" styleClass="pt-caption" userData="i18n:infosearch.localdetect.hint"/>
                        </VBox>
                        <HBox alignment="CENTER" fx:id="shadowAssetsThresholdHBox" visible="false" managed="false">
                            <Label text="影资量阈值：" styleClass="pt-body" userData="i18n:infosearch.shadow.threshold"/>
                            <TextField fx:id="shadowAssetsThreshold" styleClass="pt-input" prefWidth="150" text="50"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="maxGoogleSearchCountHBox" visible="false" managed="false">
                            <Label text="谷歌检索数：" styleClass="pt-body" userData="i18n:infosearch.google.count"/>
                            <TextField fx:id="maxGoogleSearchCount" styleClass="pt-input" prefWidth="150" text="10"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="maxGithubSearchCountHBox" visible="false" managed="false">
                            <Label text="仓库检索数：" styleClass="pt-body" userData="i18n:infosearch.github.count"/>
                            <TextField fx:id="maxGithubSearchCount" styleClass="pt-input" prefWidth="150" text="10"/>
                        </HBox>
                        <HBox alignment="CENTER" fx:id="cipThresholdHBox" visible="false" managed="false">
                            <Label text=" C聚合阈值：" styleClass="pt-body" userData="i18n:infosearch.cip.threshold"/>
                            <TextField fx:id="cipThreshold" styleClass="pt-input" prefWidth="150" text="4"/>
                        </HBox>
                    </FlowPane>
                </FlowPane>
            </HBox>
        </VBox>

        <SmoothScrollPane fx:id="scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="echoVbox" alignment="TOP_LEFT" spacing="10" />
        </SmoothScrollPane>
    </VBox>

    <StackPane fx:id="promptPane" visible="false" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" alignment="CENTER" StackPane.alignment="CENTER">
        <Label fx:id="prompt" wrapText="true" textAlignment="CENTER" alignment="CENTER" minHeight="-Infinity" maxWidth="600"/>
    </StackPane>

    <VBox fx:id="companyNameChoosePaneBox" styleClass="choosePaneBox" visible="false" managed="false" alignment="CENTER">
        <HBox alignment="CENTER" translateY="-45">
            <effect>
                <DropShadow/>
            </effect>
            <VBox styleClass="choosePane" alignment="TOP_CENTER" spacing="10">
                <HBox alignment="CENTER" styleClass="titleHbox">
                    <Label styleClass="pt-h2" text="公司别名设置" userData="i18n:infosearch.company.alias.title"/>
                </HBox>
                <VBox styleClass="contentVbox" alignment="CENTER" spacing="20">
                    <Label styleClass="pt-caption" text="请增加/修改公司别名，将用于影子资产检索" userData="i18n:infosearch.company.alias.desc"/>
                    <SmoothScrollPane maxHeight="250" hbarPolicy="NEVER" fitToWidth="true">
                        <VBox fx:id="companyNameVbox" spacing="10" alignment="CENTER"/>
                    </SmoothScrollPane>
                    <Button fx:id="companyNameSave" prefWidth="150" styleClass="pt-btn-primary" text="下一步" userData="i18n:infosearch.next" onAction="#saveCompanyNameField"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="companyCandidateChoosePaneBox" styleClass="choosePaneBox" visible="false" managed="false" alignment="CENTER">
        <HBox alignment="CENTER" translateY="-45">
            <effect>
                <DropShadow/>
            </effect>
            <VBox styleClass="choosePane" alignment="TOP_CENTER" spacing="0" minWidth="660">
                <!-- 标题栏 + 双模式徽标 -->
                <HBox alignment="CENTER_LEFT" styleClass="titleHbox" spacing="10">
                    <Label fx:id="companyCandidateTitle" styleClass="pt-h2" text="企业候选选择面板" userData="i18n:infosearch.candidate.panel.title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="双模式切换" styleClass="is-dual-mode-badge" userData="i18n:infosearch.candidate.dual.mode"/>
                </HBox>
                <!-- 模式切换栏 -->
                <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 8 16 8 16; -fx-border-color: -pt-border-subtle; -fx-border-width: 0 0 1 0;">
                    <ToggleButton fx:id="candidateSearchModeBtn" text="搜索企业"
                                  styleClass="is-mode-tab,is-mode-tab-selected"
                                  userData="i18n:infosearch.candidate.mode.search"
                                  onAction="#switchToCandidateSearchMode"/>
                    <ToggleButton fx:id="candidateManualModeBtn" text="手动输入"
                                  styleClass="is-mode-tab"
                                  userData="i18n:infosearch.candidate.mode.manual"
                                  onAction="#switchToCandidateManualMode"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="candidateModeLabel" text="MODE A" styleClass="is-mode-indicator"/>
                </HBox>
                <!-- 内容区 -->
                <VBox styleClass="contentVbox" spacing="12">
                    <!-- MODE A：搜索 + 候选列表 -->
                    <VBox fx:id="candidateModeASection" spacing="10">
                        <Label fx:id="companyCandidateDesc" styleClass="pt-caption" text="请确认根公司候选，未确认前不会继续企业扩展"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="candidateSearchField" styleClass="pt-input" HBox.hgrow="ALWAYS"
                                       promptText="搜索企业名称" userData="i18n-prompt:infosearch.candidate.search.prompt"/>
                            <Button styleClass="pt-btn" text="搜 索" onAction="#searchCandidates"
                                    userData="i18n:infosearch.candidate.search.btn" minWidth="72" minHeight="30"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="候选企业列表" styleClass="pt-body" userData="i18n:infosearch.candidate.list.title"/>
                            <Label fx:id="candidateCountLabel" text="已选 0" styleClass="is-count-badge"/>
                        </HBox>
                        <SmoothScrollPane maxHeight="260" hbarPolicy="NEVER" fitToWidth="true">
                            <VBox fx:id="companyCandidateVbox" spacing="8" alignment="CENTER"/>
                        </SmoothScrollPane>
                    </VBox>
                    <!-- MODE B：手动输入 -->
                    <VBox fx:id="candidateModeBSection" spacing="10" visible="false" managed="false">
                        <Label text="直接输入公司全称" styleClass="pt-caption" userData="i18n:infosearch.candidate.manual.label"/>
                        <TextArea fx:id="candidateManualInput" styleClass="pt-input" prefHeight="80" wrapText="true"
                                  promptText="北京科技有限公司" userData="i18n-prompt:infosearch.candidate.manual.prompt"/>
                        <HBox alignment="CENTER">
                            <Button styleClass="pt-btn-primary" text="确 认" onAction="#confirmManualCandidate"
                                    userData="i18n:infosearch.candidate.confirm.btn" minWidth="100" minHeight="30"/>
                        </HBox>
                    </VBox>
                    <!-- 底部按钮 -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 4 0 0 0;">
                        <Button fx:id="companyCandidateSave" prefWidth="150" styleClass="pt-btn-primary" text="确认并继续" onAction="#saveCompanyCandidateField"/>
                        <Button fx:id="companyCandidateNone" prefWidth="120" styleClass="pt-btn" text="都不是" onAction="#chooseNoneCompanyCandidate"/>
                        <Button fx:id="companyCandidateCancel" prefWidth="120" styleClass="pt-btn" text="取消" userData="i18n:app.cancel" onAction="#cancelCompanyCandidateField"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="iconChoosePaneBox" styleClass="choosePaneBox" visible="false" managed="false" alignment="CENTER">
        <HBox alignment="CENTER" translateY="-45">
            <effect>
                <DropShadow/>
            </effect>
            <VBox styleClass="choosePane" alignment="TOP_CENTER" spacing="10">
                <HBox alignment="CENTER" styleClass="titleHbox">
                    <Label styleClass="pt-h2" text="icon设置" userData="i18n:infosearch.icon.title"/>
                </HBox>
                <VBox styleClass="contentVbox" alignment="CENTER" spacing="20">
                    <Label styleClass="pt-caption" text="请选择相关的icon，将用于基础检索 及 影子资产检索" userData="i18n:infosearch.icon.desc"/>
                    <FlowPane fx:id="iconFlowPane" vgap="10" hgap="10" alignment="CENTER"/>
                    <Button fx:id="iconSave" prefWidth="150" styleClass="pt-btn-primary" text="下一步" userData="i18n:infosearch.next" onAction="#saveIconField"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="domainChoosePaneBox" styleClass="choosePaneBox" visible="false" managed="false" alignment="CENTER">
        <HBox alignment="CENTER" translateY="-45">
            <effect>
                <DropShadow/>
            </effect>
            <VBox styleClass="choosePane" alignment="TOP_CENTER" spacing="10">
                <HBox alignment="CENTER" styleClass="titleHbox">
                    <Label styleClass="pt-h2" text="选择域名" userData="i18n:infosearch.domain.title"/>
                </HBox>
                <VBox styleClass="contentVbox" alignment="CENTER" spacing="20">
                    <Label styleClass="pt-caption" text="以下为反查到的域名，请选择" userData="i18n:infosearch.domain.desc"/>
                    <SmoothScrollPane maxHeight="300" hbarPolicy="NEVER">
                        <VBox fx:id="domainVbox" spacing="10" alignment="CENTER"/>
                    </SmoothScrollPane>
                    <Button fx:id="domainSave" prefWidth="150" styleClass="pt-btn-primary" text="下一步" userData="i18n:infosearch.next" onAction="#saveDomainField"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

</StackPane>
