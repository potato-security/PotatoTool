<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.dlsc.gemsfx.CFCheckBox?>

<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/PaneKbRootQuery.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PaneKbRootQuery"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <!-- 内容区左对齐并让出右侧 226px(CVE面板210 + 间距16), 使 CVE DETAIL 面板常驻并排不遮挡(对齐设计稿) -->
    <SmoothScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="${sPane.height}" prefWidth="${sPane.width - 226}" maxWidth="${sPane.width - 226}" StackPane.alignment="TOP_LEFT" style="-fx-background-color: transparent; -fx-background: transparent;">
    <VBox fx:id="vBox" styleClass="kb-root" spacing="12"
          prefWidth="${sPane.width - 242}">

        <!-- Top: input (left) + controls (right) -->
        <HBox spacing="12" prefWidth="${sPane.width - 258}">

            <!-- systeminfo textarea (grows) -->
            <SmoothTextArea fx:id="inputText" styleClass="pt-input,kb-input"
                            HBox.hgrow="ALWAYS" prefHeight="180" wrapText="true"
                            promptText="请粘贴完整的systeminfo信息"
                            userData="i18n-prompt:kb.input.placeholder"/>

            <!-- Right: MUC toggle + extract button -->
            <VBox spacing="10" alignment="TOP_LEFT" prefWidth="178" minWidth="178">

                <!-- MUC card -->
                <VBox styleClass="kb-control-card" spacing="6">
                    <Label styleClass="pt-caption,kb-ctrl-title" text="MUC 在线校验"/>
                    <CFCheckBox fx:id="mucFilter" alignment="CENTER_LEFT" mnemonicParsing="false"
                                selected="false" text="检测平替KB编号" userData="i18n:kb.mucfilter">
                        <tooltip>
                            <Tooltip text="『较慢』通过Microsoft Update在线对比可替换的KB编号，减少误报，提升准确性"
                                     userData="i18n:kb.mucfilter.tooltip"/>
                        </tooltip>
                    </CFCheckBox>
                </VBox>

                <!-- Extract button -->
                <Button styleClass="pt-btn-primary" maxWidth="Infinity" minHeight="48"
                        text="提取漏洞" userData="i18n:kb.extract" onAction="#searchKb"/>

            </VBox>
        </HBox>

        <!-- FilterView + TableView are added here dynamically by the controller -->

    </VBox>

    </SmoothScrollPane>

    <!-- Right CVE DETAIL panel (slides in from right via translateX animation) -->
    <SmoothScrollPane fx:id="cveDetailScrollPane"
                      maxHeight="${sPane.height}" maxWidth="210" prefWidth="210"
                      translateX="0" hbarPolicy="NEVER"
                      StackPane.alignment="TOP_RIGHT"
                      style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="cvePanelBox" styleClass="cve-panel-root" spacing="0">
            <VBox styleClass="cve-panel-header-section">
                <Label text="CVE DETAIL" styleClass="cve-panel-section-label"/>
                <Label fx:id="cvePanelId" styleClass="cve-panel-cve-id" text="" wrapText="true"/>
            </VBox>
            <VBox fx:id="cvePanelInfo" styleClass="cve-panel-info" spacing="0"/>
            <Label text="STATES" styleClass="cve-panel-states-label" userData="i18n:kb.states"/>
            <VBox fx:id="cvePanelStates" styleClass="cve-panel-states" spacing="8"/>
        </VBox>
    </SmoothScrollPane>

    <!-- 四角取景框叠加在最上层 -->
    <Region styleClass="pt-corner-tl" mouseTransparent="true" StackPane.alignment="TOP_LEFT" translateX="4" translateY="4"/>
    <Region styleClass="pt-corner-tr" mouseTransparent="true" StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
    <Region styleClass="pt-corner-bl" mouseTransparent="true" StackPane.alignment="BOTTOM_LEFT" translateX="4" translateY="-4"/>
    <Region styleClass="pt-corner-br" mouseTransparent="true" StackPane.alignment="BOTTOM_RIGHT" translateX="-4" translateY="-4"/>
</StackPane>
