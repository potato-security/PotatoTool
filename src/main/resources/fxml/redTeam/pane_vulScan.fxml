<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>
<?import com.potato.potatotool.utils.ui.SmoothTableView?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Cursor?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import com.dlsc.gemsfx.CFCheckBox?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/PaneVulScan.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PaneVulScan"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <!-- 外层滚动容器：配置展开后整体超出窗口时出现 vbar，避免底部内容被截 -->
    <SmoothScrollPane fx:id="rootScroll" prefWidth="${sPane.width}" maxWidth="${sPane.width}" maxHeight="Infinity"
                      fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                      style="-fx-background-color: transparent; -fx-background: transparent;">
    <VBox alignment="TOP_CENTER" spacing="15" styleClass="vulscan-root">

        <!-- 0. 页面标题 -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="漏洞扫描" styleClass="pt-h1" userData="i18n:vulnscan.page.title"/>
                <Label text="多引擎 POC 编排 · 扫描工作台" styleClass="pt-caption" userData="i18n:vulnscan.page.subtitle"/>
            </VBox>
        </HBox>

        <!-- 1. 顶部目标输入区 -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <!-- 模式选择放在左侧 -->
            <VBox spacing="5" alignment="CENTER_LEFT" minWidth="120">
                <Label text="扫描模式" styleClass="title-label" userData="i18n:vulnscan.mode"/>
                <ComboBox fx:id="scanModeComboBox" prefWidth="120" userData="i18n-combobox:vulnscan.scanmode">
                    <tooltip><Tooltip text="智能模式：先指纹识别再精准匹配POC；默认模式：地毯式扫描所有POC" userData="i18n:vulnscan.ui.scanmode.tooltip"/></tooltip>
                </ComboBox>
            </VBox>

            <!-- 目标输入框 (带右侧图标按钮) -->
            <StackPane HBox.hgrow="ALWAYS">
                <SmoothTextArea fx:id="targetField" prefRowCount="3" minHeight="66" wrapText="true"
                          promptText="请输入目标 URL/IP，每行一个..."
                          userData="i18n-prompt:vulnscan.target.placeholder"
                          styleClass="pt-input,pt-mono"
                          id="targetField"/>
                
                <Pane maxWidth="0" maxHeight="30" StackPane.alignment="TOP_RIGHT">
                    <HBox layoutX="-110" layoutY="8" spacing="8">
                        <Label fx:id="uploadLabel" visible="true" managed="true" onMouseClicked="#uploadTargets" styleClass="action-icon">
                            <graphic><Region styleClass="upload"/></graphic>
                            <tooltip><Tooltip text="批量导入目标" userData="i18n:vulnscan.batch"/></tooltip>
                        </Label>
                        <Label fx:id="startScanLabel" visible="true" managed="true" onMouseClicked="#startQuickScan" styleClass="action-icon">
                            <graphic><Region styleClass="send"/></graphic>
                            <tooltip><Tooltip text="开始扫描" userData="i18n:vulnscan.startscan"/></tooltip>
                        </Label>
                        <Label fx:id="pauseScanLabel" visible="false" managed="false" onMouseClicked="#pauseScan" styleClass="action-icon">
                            <graphic><Region styleClass="pause"/></graphic>
                            <tooltip><Tooltip text="暂停扫描" userData="i18n:vulnscan.pausescan"/></tooltip>
                        </Label>
                        <Label fx:id="resumeScanLabel" visible="false" managed="false" onMouseClicked="#resumeFromPause" styleClass="action-icon">
                            <graphic><Region styleClass="resume"/></graphic>
                            <tooltip><Tooltip text="恢复扫描" userData="i18n:vulnscan.resumescan"/></tooltip>
                        </Label>
                        <Label fx:id="stopScanLabel" visible="false" managed="false" onMouseClicked="#stopScan" styleClass="action-icon">
                            <graphic><Region styleClass="stop"/></graphic>
                            <tooltip><Tooltip text="停止扫描" userData="i18n:vulnscan.stopscan"/></tooltip>
                        </Label>
                    </HBox>
                </Pane>
            </StackPane>
        </HBox>
        
        <!-- 2a. 探测方式 + 特殊分组 (常态可见, 对齐 Penpot 设计: Checkbox 分两组) -->
        <VBox spacing="10" styleClass="vulscan-methods" maxWidth="Infinity">
            <!-- 探测方式: 4 张探测卡片 (名称 + POC 计数 + format 色下划线) -->
            <HBox alignment="CENTER_LEFT" spacing="12" maxWidth="Infinity">
                <Label text="探测方式" styleClass="pt-section-label" minWidth="72" userData="i18n:vulnscan.group.methods"/>

                <HBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <VBox styleClass="detect-card,detect-nuclei" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT">
                            <CFCheckBox fx:id="nucleiCheckBox" text="Nuclei" selected="true" onMouseClicked="#checkNuclei"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="pocNucleiLabel" text="0" styleClass="detect-count"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="detect-card,detect-goby" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT">
                            <CFCheckBox fx:id="gobyCheckBox" text="Goby" selected="true" onMouseClicked="#checkGoby"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="pocGobyLabel" text="0" styleClass="detect-count"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="detect-card,detect-xray" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT">
                            <CFCheckBox fx:id="xrayCheckBox" text="Xray" selected="true" onMouseClicked="#checkXray"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="pocXrayLabel" text="0" styleClass="detect-count"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="detect-card,detect-pocsuite" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT">
                            <CFCheckBox fx:id="pocsuiteCheckBox" text="Pocsuite" selected="true" onMouseClicked="#checkPocsuite"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="pocPocsuiteLabel" text="0" styleClass="detect-count"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Button text="全选" onAction="#selectAllFormats" styleClass="pt-btn" userData="i18n:vulnscan.selectall"/>
                <Button text="反选" onAction="#invertFormats" styleClass="pt-btn" userData="i18n:vulnscan.invert"/>
            </HBox>

            <!-- 特殊类别 / 特殊模板 —— 分两组 -->
            <HBox alignment="CENTER_LEFT" spacing="12" maxWidth="Infinity">
                <Label text="特殊类别" styleClass="pt-section-label" minWidth="72" userData="i18n:vulnscan.group.special"/>
                <FlowPane hgap="14" vgap="8" alignment="CENTER_LEFT">
                    <CFCheckBox fx:id="includeOsintBox" text="OSINT 收集" selected="false" userData="i18n:vulnscan.ui.osint">
                        <tooltip><Tooltip text="开源情报收集（需要API密钥）" userData="i18n:vulnscan.ui.osint.tooltip"/></tooltip>
                    </CFCheckBox>
                    <CFCheckBox fx:id="includeTokenSprayBox" text="Token 噴洒" selected="false" userData="i18n:vulnscan.ui.tokenspray">
                        <tooltip><Tooltip text="密码喷射/凭证测试" userData="i18n:vulnscan.ui.tokenspray.tooltip"/></tooltip>
                    </CFCheckBox>
                </FlowPane>
                <Separator orientation="VERTICAL"/>
                <Label text="特殊模板" styleClass="pt-section-label" minWidth="72" userData="i18n:vulnscan.group.template"/>
                <FlowPane HBox.hgrow="ALWAYS" hgap="14" vgap="8" alignment="CENTER_LEFT">
                    <CFCheckBox fx:id="enableHeadlessBox" text="无头浏览器" selected="false" userData="i18n:vulnscan.ui.headless"/>
                    <CFCheckBox fx:id="enableCodeBox" text="代码执行" selected="false" userData="i18n:vulnscan.ui.code"/>
                    <CFCheckBox fx:id="enableFuzzBox" text="Fuzz" selected="false"/>
                </FlowPane>
            </HBox>
        </VBox>

        <!-- 2b. 进阶配置 (扫描选项/标签/输入类型) -->
        <TitledPane fx:id="configTitledPane" text="扫描配置" expanded="false" animated="true"
                    styleClass="compact-config-pane" prefWidth="${sPane.width}" maxWidth="${sPane.width}"
                    userData="i18n:vulnscan.config.title">
        <VBox id="settingVbox" maxWidth="Infinity">

            <!-- 扫描选项 -->
            <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                <HBox id="smartScanLeftTitle" alignment="CENTER">
                    <Label text="扫描选项" userData="i18n:vulnscan.options"/>
                </HBox>
                <FlowPane id="smartScanRightTitle" HBox.hgrow="ALWAYS" hgap="15" vgap="10" alignment="CENTER_LEFT">
                    <CFCheckBox fx:id="verboseLogBox" text="详细日志" selected="true" userData="i18n:vulnscan.verbose"/>
                    <CFCheckBox fx:id="autoSaveBox" text="自动保存" selected="true" userData="i18n:vulnscan.autosave"/>
                    <Label text="标签:" styleClass="pt-caption" userData="i18n:vulnscan.ui.tags.label"/>
                    <TextField fx:id="tagsField" prefWidth="100" promptText="RCE,XSS" styleClass="pt-input"/>
                    <Label text="输入:" styleClass="pt-caption" userData="i18n:vulnscan.ui.input.label"/>
                    <ComboBox fx:id="inputTypeComboBox" prefWidth="100" userData="i18n-combobox:vulnscan.inputtype"/>
                </FlowPane>
            </HBox>
        </VBox>
        </TitledPane>
        
        <!-- 3. 信息栏 (POC统计 与 进度条 拆为两行，避免占宍、裁切) -->
        <VBox spacing="6">
            <!-- Row A: POC 统计 + 状态 -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="POC库:" styleClass="pt-body" style="-fx-font-weight: bold;" userData="i18n:vulnscan.ui.poclib"/>
                <Label fx:id="pocTotalLabel" text="0" styleClass="stat-value"/>

                <Button text="刷新" onAction="#refreshPocList" styleClass="pt-btn" userData="i18n:vulnscan.button.refresh"><tooltip><Tooltip text="刷新POC"/></tooltip></Button>
                <Button text="管理" onAction="#managePoc" styleClass="pt-btn" userData="i18n:vulnscan.manage"><tooltip><Tooltip text="POC管理"/></tooltip></Button>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- 状态文本（进度条已另起行，状态可完整显示） -->
                <Label fx:id="scanStateLabel" text="准备就绪" styleClass="pt-accent-text"/>
            </HBox>

            <!-- Row B: 进度条 (默认隐藏，扫描时显示) -->
            <HBox fx:id="progressBox" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
                <ProgressBar fx:id="progressBar" HBox.hgrow="ALWAYS" maxWidth="Infinity" progress="0" styleClass="scan-progress"/>
                <Label fx:id="progressLabel" text="0%" styleClass="stat-value"/>
                <Label fx:id="timeLabel" text="00:00:00" styleClass="stat-label"/>
            </HBox>
        </VBox>

        <!-- 4. 结果区域 -->
        <VBox VBox.vgrow="ALWAYS" spacing="10" styleClass="result-area">
            <!-- 工具栏：窄窗时换行避免统计/按钮被截断（自适应） -->
            <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT" rowValignment="CENTER" style="-fx-background-color: -pt-bg-panel; -fx-background-radius: 8; -fx-padding: 8;">
                <Label text="扫描结果" styleClass="pt-h2" userData="i18n:vulnscan.results"/>
                <Label fx:id="vulnCountLabel" text="(0)" styleClass="vuln-count"/>
                
                <!-- 统计摘要 (初始隐藏) -->
                <HBox fx:id="statsPane" spacing="16" alignment="CENTER_LEFT" visible="false" managed="false">
                    <Separator orientation="VERTICAL"/>
                    <HBox styleClass="stat-chip" alignment="CENTER_LEFT">
                        <Label text="CRIT" styleClass="stat-tag,severity-dot-critical"/><Label fx:id="criticalCountLabel" text="0" styleClass="stat-num,severity-dot-critical"/>
                    </HBox>
                    <HBox styleClass="stat-chip" alignment="CENTER_LEFT">
                        <Label text="HIGH" styleClass="stat-tag,severity-dot-high"/><Label fx:id="highCountLabel" text="0" styleClass="stat-num,severity-dot-high"/>
                    </HBox>
                    <HBox styleClass="stat-chip" alignment="CENTER_LEFT">
                        <Label text="MED" styleClass="stat-tag,severity-dot-medium"/><Label fx:id="mediumCountLabel" text="0" styleClass="stat-num,severity-dot-medium"/>
                    </HBox>
                    <HBox styleClass="stat-chip" alignment="CENTER_LEFT">
                        <Label text="LOW" styleClass="stat-tag,severity-dot-low"/><Label fx:id="lowCountLabel" text="0" styleClass="stat-num,severity-dot-low"/>
                    </HBox>
                    <HBox styleClass="stat-chip" alignment="CENTER_LEFT">
                        <Label text="INFO" styleClass="stat-tag,severity-dot-info"/><Label fx:id="infoCountLabel" text="0" styleClass="stat-num,severity-dot-info"/>
                    </HBox>
                </HBox>

                <Button text="清空" onAction="#clearResults" styleClass="pt-btn-danger" userData="i18n:vulnscan.clearresults"/>
                <Button text="日志" onAction="#showScanLogs" styleClass="pt-btn" userData="i18n:vulnscan.ui.logs"/>
                <Button text="历史" onAction="#showHistory" styleClass="pt-btn" userData="i18n:vulnscan.history"/>
                
                <Separator orientation="VERTICAL"/>
                
                <ComboBox fx:id="exportFormatComboBox" prefWidth="110" minWidth="110" promptText="格式" userData="i18n-prompt:vulnscan.ui.exportformat.prompt">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="HTML"/>
                            <String fx:value="Word"/>
                            <String fx:value="Excel"/>
                            <String fx:value="CSV"/>
                            <String fx:value="JSON"/>
                            <String fx:value="TXT"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Button text="导出报告" onAction="#exportReport" styleClass="pt-btn-primary" userData="i18n:vulnscan.export"/>
            </FlowPane>
            
            <!-- 结果列表：内层 ScrollPane 仅负责结果列表滚动，设 minHeight=200 避免被压扣 -->
            <SmoothScrollPane fx:id="resultScroll" VBox.vgrow="ALWAYS" fitToWidth="true" minHeight="200" prefHeight="320" style="-fx-background-color: transparent;">
                <VBox fx:id="resultVBox" spacing="8" style="-fx-padding: 5;">
                    <!-- 动态内容 -->
                </VBox>
            </SmoothScrollPane>

            <!-- 漏洞详情双态：实时扫描 / 历史回溯 -->
            <HBox spacing="0" styleClass="vuln-dual-detail">
                <!-- 左: 实时扫描 -->
                <VBox HBox.hgrow="ALWAYS" styleClass="vuln-detail-col" spacing="3">
                    <Label text="实时扫描" styleClass="vuln-detail-col-title" userData="i18n:vulnscan.detail.live"/>
                    <HBox styleClass="vuln-detail-row"><Label text="目标" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.target"/><Label fx:id="liveTargetVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="POC名称" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.pocname"/><Label fx:id="livePocNameVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="严重度" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.severity"/><Label fx:id="liveSeverityVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="POC格式" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.pocformat"/><Label fx:id="livePocFormatVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="协议" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.protocol"/><Label fx:id="liveProtocolVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="漏洞类型" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.vulntype"/><Label fx:id="liveVulnTypeVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="描述" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.description"/><Label fx:id="liveDescriptionVal" text="—" styleClass="vuln-detail-val" HBox.hgrow="ALWAYS" wrapText="true"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="检测路径" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.matchpath"/><Label fx:id="liveMatchedPathVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="Payload" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.payload"/><Label fx:id="livePayloadVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox spacing="8" style="-fx-padding: 2 0 0 0;">
                        <Button fx:id="liveRawRequestBtn" text="HTTP 请求" styleClass="pt-btn" disable="true" userData="i18n:vulnscan.detail.httprequest" onAction="#showLiveRawRequest"/>
                        <Button fx:id="liveRawResponseBtn" text="HTTP 响应" styleClass="pt-btn" disable="true" userData="i18n:vulnscan.detail.httpresponse" onAction="#showLiveRawResponse"/>
                    </HBox>
                </VBox>
                <Separator orientation="VERTICAL" style="-fx-padding: 0 8 0 8;"/>
                <!-- 右: 历史回溯 -->
                <VBox HBox.hgrow="ALWAYS" styleClass="vuln-detail-col" spacing="3">
                    <Label text="历史回溯" styleClass="vuln-detail-col-title" userData="i18n:vulnscan.detail.hist"/>
                    <HBox styleClass="vuln-detail-row"><Label text="目标" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.target"/><Label fx:id="histTargetVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="POC名称" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.pocname"/><Label fx:id="histPocNameVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="严重度" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.severity"/><Label fx:id="histSeverityVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="POC格式" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.pocformat"/><Label fx:id="histPocFormatVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="协议" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.protocol"/><Label fx:id="histProtocolVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="漏洞类型" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.vulntype"/><Label fx:id="histVulnTypeVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="描述" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.description"/><Label fx:id="histDescriptionVal" text="—" styleClass="vuln-detail-val" HBox.hgrow="ALWAYS" wrapText="true"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="检测路径" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.matchpath"/><Label fx:id="histMatchedPathVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox styleClass="vuln-detail-row"><Label text="Payload" styleClass="vuln-detail-key" minWidth="76" userData="i18n:vulnscan.detail.payload"/><Label fx:id="histPayloadVal" text="—" styleClass="vuln-detail-val"/></HBox>
                    <HBox spacing="8" style="-fx-padding: 2 0 0 0;">
                        <Button fx:id="histRawRequestBtn" text="HTTP 请求" styleClass="pt-btn" disable="true" userData="i18n:vulnscan.detail.httprequest" onAction="#showHistRawRequest"/>
                        <Button fx:id="histRawResponseBtn" text="HTTP 响应" styleClass="pt-btn" disable="true" userData="i18n:vulnscan.detail.httpresponse" onAction="#showHistRawResponse"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>

        <!-- HISTORY — 保留天数内联设置 (对齐 Penpot 修正版) -->
        <HBox styleClass="history-retention-bar" alignment="CENTER_LEFT" spacing="10">
            <Label text="HISTORY" styleClass="pt-section-label" userData="i18n:vulnscan.history.label"/>
            <Label text="保留天数" styleClass="pt-caption" userData="i18n:vulnscan.history.retentiondays"/>
            <TextField fx:id="historyRetentionDaysField" text="30" prefWidth="60" styleClass="pt-input" style="-fx-text-alignment: center;"/>
            <Label text="天" styleClass="pt-caption" userData="i18n:vulnscan.history.days"/>
            <Button text="清理历史▲" styleClass="pt-btn" onAction="#cleanHistoryByRetention" userData="i18n:vulnscan.history.clean"/>
        </HBox>

    </VBox>
    </SmoothScrollPane>
    
    <!-- === 弹窗层 (保持逻辑不变，仅更新样式类) === -->
    
    <!-- 1. POC管理弹窗 -->
    <StackPane fx:id="pocManageMask" visible="false" managed="false" styleClass="dialog-mask" onMouseClicked="#closePocManageByMask">
        <VBox fx:id="pocManagePane" styleClass="manage-pane" StackPane.alignment="CENTER" onMouseClicked="#consumeEvent" prefWidth="900" prefHeight="650">
            <HBox alignment="CENTER_LEFT" styleClass="manage-header">
                <Label text="POC 仓库管理" styleClass="manage-title" userData="i18n:vulnscan.tab.pocmanage"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="pocCountLabel" text="共 0 个POC" styleClass="pt-caption" style="-fx-padding: 0 10 0 0;"/>
                <Label text="✕" styleClass="close-button" onMouseClicked="#closePocManage"/>
            </HBox>
            
            <!-- 搜索工具栏 -->
            <HBox spacing="10" styleClass="manage-search" alignment="CENTER_LEFT">
                <TextField fx:id="pocSearchField" promptText="搜索 ID / 名称 / 标签..." prefWidth="250" styleClass="pt-input" userData="i18n-prompt:vulnscan.search.placeholder"/>
                <ComboBox fx:id="pocFormatFilter" prefWidth="90" userData="i18n-combobox:vulnscan.filter.formatopt"/>
                <ComboBox fx:id="pocSeverityFilter" prefWidth="90" userData="i18n-combobox:vulnscan.filter.severityopt"/>
                <ComboBox fx:id="pocStatusFilter" prefWidth="90" userData="i18n-combobox:vulnscan.filter.statusopt"/>
                <Region HBox.hgrow="ALWAYS"/>
                <CFCheckBox fx:id="selectAllCheckBox" text="全选" onMouseClicked="#toggleSelectAll"/>
                <Button text="反选" onAction="#invertSelection" styleClass="pt-btn" userData="i18n:vulnscan.invert"/>
                <Button text="导入POC" onAction="#importPoc" styleClass="pt-btn" userData="i18n:vulnscan.button.import"/>
                <Button text="在线更新" onAction="#showPocUpdateDialog" styleClass="pt-btn" userData="i18n:vulnscan.ui.onlineupdate"/>
            </HBox>
            
            <SmoothTableView fx:id="pocTableView" VBox.vgrow="ALWAYS" styleClass="pt-table,poc-table">
                <columns>
                    <TableColumn fx:id="pocStatusColumn" text="状态" prefWidth="60" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="pocIdColumn" text="ID" prefWidth="150"/>
                    <TableColumn fx:id="pocNameColumn" text="名称" prefWidth="250"/>
                    <TableColumn fx:id="pocFormatColumn" text="格式" prefWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="pocSeverityColumn" text="等级" prefWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="pocTagsColumn" text="标签" prefWidth="150"/>
                    <TableColumn fx:id="pocProtocolColumn" text="协议" prefWidth="70" style="-fx-alignment: CENTER;"/>
                </columns>
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem text="查看详情" onAction="#viewPocDetail" userData="i18n:vulnscan.ctx.poc.1"/>
                            <MenuItem text="复制 ID" onAction="#copyPocId" userData="i18n:vulnscan.ctx.poc.2"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="togglePocMenuItem" text="切换状态" onAction="#togglePocStatus"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="删除" onAction="#deletePoc" style="-fx-text-fill: -pt-danger;" userData="i18n:vulnscan.ctx.poc.4"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </SmoothTableView>
            
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
                <Label fx:id="selectedPocLabel" text="已选 0 项" styleClass="pt-caption"/>
                <Button text="批量导出" onAction="#exportSelectedPocs" styleClass="pt-btn" userData="i18n:vulnscan.ui.batchexport"/>
                <Button text="批量启用" onAction="#enableAllPocs" styleClass="pt-btn" userData="i18n:vulnscan.ui.batchenable"/>
                <Button text="批量禁用" onAction="#disableAllPocs" styleClass="pt-btn" userData="i18n:vulnscan.ui.batchdisable"/>
                <Button text="批量删除" onAction="#deleteSelectedPocs" styleClass="pt-btn-danger" userData="i18n:vulnscan.ui.batchdelete"/>
            </HBox>
        </VBox>
    </StackPane>
    
    <!-- 2. POC详情弹窗 -->
    <StackPane fx:id="pocDetailMask" visible="false" managed="false" styleClass="dialog-mask" onMouseClicked="#closePocDetailByMask">
        <VBox fx:id="pocDetailPane" styleClass="detail-pane" StackPane.alignment="CENTER" onMouseClicked="#consumeEvent" prefWidth="750" prefHeight="550">
            <HBox alignment="CENTER_LEFT" styleClass="manage-header">
                <Label text="POC 详情" styleClass="manage-title" userData="i18n:vulnscan.ui.pocdetail"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="✕" styleClass="close-button" onMouseClicked="#closePocDetail"/>
            </HBox>
            <SmoothScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 10;">
                <VBox fx:id="pocDetailContent" spacing="10">
                    <!-- Content populated by controller -->
                </VBox>
            </SmoothScrollPane>
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 16; -fx-border-color: -pt-border-subtle; -fx-border-width: 1 0 0 0;">
                <Button text="复制内容" onAction="#copyPocContent" styleClass="pt-btn" userData="i18n:vulnscan.ui.copycontent"/>
                <Button text="导出文件" onAction="#exportPocFile" styleClass="pt-btn" userData="i18n:vulnscan.ui.exportfile"/>
            </HBox>
        </VBox>
    </StackPane>
    
    <!-- 3. 日志查看弹窗 -->
    <StackPane fx:id="logViewerMask" visible="false" managed="false" styleClass="dialog-mask" onMouseClicked="#closeLogViewerByMask">
        <VBox fx:id="logViewerPane" styleClass="manage-pane" StackPane.alignment="CENTER" onMouseClicked="#consumeEvent" prefWidth="900" prefHeight="600">
            <HBox alignment="CENTER_LEFT" styleClass="manage-header">
                <Label text="运行日志" styleClass="manage-title" userData="i18n:vulnscan.ui.runlog"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="logCountLabel" text="共 0 条日志" styleClass="pt-caption" style="-fx-padding: 0 10 0 0;"/>
                <Label text="✕" styleClass="close-button" onMouseClicked="#closeLogViewer"/>
            </HBox>
            <HBox spacing="10" styleClass="manage-search" alignment="CENTER_LEFT">
                <ComboBox fx:id="logLevelFilter" prefWidth="100" userData="i18n-combobox:vulnscan.filter.loglevel"/>
                <TextField fx:id="logSearchField" promptText="搜索日志内容..." prefWidth="250" styleClass="pt-input" userData="i18n-prompt:vulnscan.ui.logsearch.placeholder"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="刷新" onAction="#refreshLogs" styleClass="pt-btn" userData="i18n:vulnscan.button.refresh"/>
                <Button text="清空" onAction="#clearLogs" styleClass="pt-btn-danger" userData="i18n:vulnscan.button.clear"/>
            </HBox>
            <SmoothTextArea fx:id="logTextArea" VBox.vgrow="ALWAYS" editable="false" wrapText="false" styleClass="pt-input,pt-mono"/>
        </VBox>
    </StackPane>
    
    <!-- 4. 历史记录弹窗 (新增) -->
    <StackPane fx:id="historyMask" visible="false" managed="false" styleClass="dialog-mask" onMouseClicked="#closeHistoryByMask">
        <VBox fx:id="historyPane" styleClass="manage-pane" StackPane.alignment="CENTER" onMouseClicked="#consumeEvent" prefWidth="800" prefHeight="500">
            <HBox alignment="CENTER_LEFT" styleClass="manage-header">
                <Label text="扫描历史" styleClass="manage-title" userData="i18n:vulnscan.ui.scanhistory"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="✕" styleClass="close-button" onMouseClicked="#closeHistory"/>
            </HBox>
            <HBox spacing="10" styleClass="manage-search" alignment="CENTER_LEFT">
                <Label text="开始" styleClass="pt-caption" userData="i18n:vulnscan.ui.start"/>
                <DatePicker fx:id="startDatePicker" prefWidth="140"/>
                <Label text="结束" styleClass="pt-caption" userData="i18n:vulnscan.ui.end"/>
                <DatePicker fx:id="endDatePicker" prefWidth="140"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="查询" onAction="#queryHistory" styleClass="pt-btn" userData="i18n:vulnscan.button.query"/>
            </HBox>
            <SmoothTableView fx:id="historyTableView" VBox.vgrow="ALWAYS" styleClass="pt-table,poc-table">
                 <columns>
                    <TableColumn fx:id="historyTimeColumn" text="扫描时间" prefWidth="145"/>
                    <TableColumn fx:id="historyCritColumn" text="开放数" prefWidth="70" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="historyTargetColumn" text="扫描数" prefWidth="70" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="historyPocColumn" text="POC数" prefWidth="70" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="historyVulnCountColumn" text="漏洞数" prefWidth="70" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="historyDurationColumn" text="耗时" prefWidth="90" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="historyStatusColumn" text="状态" prefWidth="100" style="-fx-alignment: CENTER;"/>
                </columns>
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem text="加载结果" onAction="#loadHistoryResult" userData="i18n:vulnscan.ctx.history.1"/>
                            <MenuItem text="删除记录" onAction="#deleteHistory" userData="i18n:vulnscan.ctx.history.2"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </SmoothTableView>
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10;" spacing="10">
                 <Button text="导出历史" onAction="#exportHistory" styleClass="pt-btn" userData="i18n:vulnscan.button.exporthistory"/>
                 <Button text="清空历史" onAction="#clearHistory" styleClass="pt-btn-danger" userData="i18n:vulnscan.button.clearhistory"/>
            </HBox>
        </VBox>
    </StackPane>
    
    <!-- 5. 全局提示框 -->
    <StackPane fx:id="promptPane" visible="false" managed="false"
               StackPane.alignment="CENTER"
               maxHeight="-Infinity" maxWidth="-Infinity"
               onMouseClicked="#closePromptPane">
        <Label fx:id="promptLabel" text="提示信息"
               wrapText="true" textAlignment="CENTER" alignment="CENTER" maxWidth="600"/>
    </StackPane>

</StackPane>
