<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>
<?import com.dlsc.gemsfx.CFCheckBox?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.effect.DropShadow?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/PaneCustomMemoryCode.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.redTeam.PaneCustomMemoryCode"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">
    <SmoothScrollPane fx:id="rootScrollPane" maxWidth="${sPane.width}" maxHeight="${sPane.height}" hbarPolicy="NEVER" style="-fx-padding: 0">
        <VBox spacing="20" alignment="TOP_CENTER">

            <HBox styleClass="tipInfo" alignment="BOTTOM_LEFT">
                <Label styleClass="pt-h2" text="类型选项" userData="i18n:memshell.type.title"/>
            </HBox>

            <VBox styleClass="pt-panel" spacing="15" prefWidth="${sPane.width - 10}">
                <HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" text="工具类型：" userData="i18n:memshell.tooltype"/>
                        <ComboBox fx:id="toolTypeBox" prefHeight="20.0" prefWidth="250"  />
                    </HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" fx:id="leftLabel" text="中间件类型：" userData="i18n:memshell.servertype"/>
                        <ComboBox fx:id="serverTypeBox" prefHeight="20.0" prefWidth="250"  />
                    </HBox>
                </HBox>
                <HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" text="组件类型：" userData="i18n:memshell.shelltype"/>
                        <ComboBox fx:id="shellTypeBox" prefHeight="20.0" prefWidth="250"  />
                    </HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="输出格式：" userData="i18n:memshell.outputformat"/>
                        <ComboBox fx:id="outputFormatBox" prefHeight="20.0" prefWidth="250"  />
                    </HBox>
                </HBox>
            </VBox>

            <HBox styleClass="tipInfo" alignment="BOTTOM_LEFT">
                <Label styleClass="pt-h2" text="自定义选项" userData="i18n:memshell.custom.title"/>
            </HBox>

            <VBox styleClass="pt-panel" spacing="15" prefWidth="${sPane.width - 10}">
                <HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="密码：" userData="i18n:memshell.password"/>
                        <TextField styleClass="pt-input" fx:id="passTextField" promptText="请输入密码，空则随机" userData="i18n-prompt:memshell.password.placeholder" prefHeight="20.0" prefWidth="250"/>
                    </HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="密钥：" userData="i18n:memshell.key"/>
                        <TextField styleClass="pt-input" fx:id="keyTextField" promptText="请输入密钥，空则随机" userData="i18n-prompt:memshell.key.placeholder" prefHeight="20.0" prefWidth="250"/>
                    </HBox>
                </HBox>
                <HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="请求头Key：" userData="i18n:memshell.headerkey"/>
                        <TextField styleClass="pt-input" fx:id="headerNameTextField" promptText="请输入请求头Key，空则随机" userData="i18n-prompt:memshell.headerkey.placeholder" prefHeight="20.0" prefWidth="250"/>
                    </HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="请求头Value：" userData="i18n:memshell.headervalue"/>
                        <TextField styleClass="pt-input" fx:id="headerValueTextField" promptText="请输入请求头Value，空则随机" userData="i18n-prompt:memshell.headervalue.placeholder" prefHeight="20.0" prefWidth="250"/>
                    </HBox>
                </HBox>
                <HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="内存马类名：" userData="i18n:memshell.shellclass"/>
                        <TextField styleClass="pt-input" fx:id="shellClassNameTextField" promptText="请输入内存马类名，空则随机" userData="i18n-prompt:memshell.shellclass.placeholder" prefHeight="20.0" prefWidth="250"/>
                    </HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="注入器类名：" userData="i18n:memshell.injectorclass"/>
                        <TextField styleClass="pt-input" fx:id="injectorClassNameTextField" promptText="请输入注入器类名，空则随机" userData="i18n-prompt:memshell.injectorclass.placeholder" prefHeight="20.0" prefWidth="250"/>
                    </HBox>
                </HBox>
                <HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="请求路径：" userData="i18n:memshell.urlpattern"/>
                        <TextField styleClass="pt-input" fx:id="urlPatternTextField" promptText="请输入请求路径，空则随机" userData="i18n-prompt:memshell.urlpattern.placeholder" text="/*" prefHeight="20.0" prefWidth="250"/>
                    </HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="输出路径：" userData="i18n:memshell.output.path"/>
                        <TextField styleClass="pt-input" fx:id="outputPathTextField" promptText="请输入输出目录或文件路径，空则当前目录" userData="i18n-prompt:memshell.output.path.placeholder" prefHeight="20.0" prefWidth="250"/>
                    </HBox>
                </HBox>
                <HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <CFCheckBox fx:id="bypassJdkModuleCheckBox" text="Bypass JDK Module" userData="i18n:memshell.bypass.jdk.module"/>
                    </HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Button styleClass="pt-btn" minHeight="25.0" minWidth="100" text="清空" userData="i18n:app.clear" onAction="#clearInput">
                            <effect>
                                <DropShadow />
                            </effect>
                        </Button>
                    </HBox>
                </HBox>
            </VBox>

            <HBox styleClass="tipInfo" alignment="BOTTOM_LEFT">
                <Label styleClass="pt-h2" text="专项利用" userData="i18n:memshell.exploit.title"/>
            </HBox>

            <VBox styleClass="pt-panel" spacing="15" prefWidth="${sPane.width - 10}">
                <HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" text="漏洞选择：" userData="i18n:memshell.gadget"/>
                        <ComboBox fx:id="gadgetTypeBox" prefHeight="20.0" prefWidth="250"  />
                    </HBox>
                    <HBox prefWidth="${sPane.width/2 - 5}" alignment="CENTER" spacing="10">
                        <Label styleClass="pt-body" minWidth="${leftLabel.width}" text="表达式选择：" userData="i18n:memshell.expression"/>
                        <ComboBox fx:id="exprEncoderBox" prefHeight="20.0" prefWidth="250"  />
                    </HBox>
                </HBox>
            </VBox>

            <Button styleClass="pt-btn-primary" minHeight="48.0" minWidth="${sPane.width - 10}" text="生成" userData="i18n:memshell.generate" onAction="#toGenerateMemoryShell"/>

            <!-- OUTPUT 分区头 (对齐 Penpot) -->
            <HBox styleClass="payload-output-header" alignment="CENTER_LEFT" spacing="8" prefWidth="${sPane.width - 10}">
                <Label text="OUTPUT" styleClass="payload-output-label"/>
                <Label fx:id="outputFormatBadge" text="—" styleClass="payload-output-badge"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="outputStatusBadge" text="" styleClass="payload-status-dot" visible="false"/>
            </HBox>
            <SmoothTextArea fx:id="outTextArea" styleClass="pt-input,pt-mono" wrapText="true"
                            prefHeight="${sPane.height * 0.4}" prefWidth="${sPane.width - 10}"/>
            <Label fx:id="outputBreadcrumb" text="" styleClass="payload-breadcrumb" prefWidth="${sPane.width - 10}"/>

        </VBox>
    </SmoothScrollPane>

    <!-- 右侧 MEMSHELL 面板 -->
    <SmoothScrollPane fx:id="memshellPanelScroll"
                      maxHeight="${sPane.height}" maxWidth="195"
                      hbarPolicy="NEVER"
                      StackPane.alignment="TOP_RIGHT"
                      style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox styleClass="payload-panel-root" spacing="0">
            <VBox styleClass="payload-panel-header">
                <Label text="MEMSHELL" styleClass="payload-panel-section-label"/>
                <Label text="内存马生成" styleClass="payload-panel-title" userData="i18n:memshell.panel.title"/>
            </VBox>
            <VBox styleClass="payload-panel-items" spacing="0">
                <VBox styleClass="payload-panel-item,payload-panel-selected">
                    <Label text="Godzilla" styleClass="payload-panel-item-name"/>
                    <Label text="Tomcat Filter 注入" styleClass="payload-panel-item-sub" userData="i18n:memshell.panel.godzilla.sub"/>
                </VBox>
                <VBox styleClass="payload-panel-item">
                    <Label text="参数配置" styleClass="payload-panel-item-name" userData="i18n:memshell.panel.params"/>
                    <Label text="5 个自定义字段" styleClass="payload-panel-item-sub" userData="i18n:memshell.panel.params.sub"/>
                </VBox>
                <VBox styleClass="payload-panel-item">
                    <Label text="专项利用" styleClass="payload-panel-item-name" userData="i18n:memshell.panel.exploit"/>
                    <Label text="Gadget 链选择" styleClass="payload-panel-item-sub" userData="i18n:memshell.panel.exploit.sub"/>
                </VBox>
                <VBox styleClass="payload-panel-item">
                    <Label text="输出区" styleClass="payload-panel-item-name" userData="i18n:memshell.panel.output"/>
                    <Label text="等宽字节码预览" styleClass="payload-panel-item-sub" userData="i18n:memshell.panel.output.sub"/>
                </VBox>
            </VBox>
            <Label text="STATES" styleClass="payload-panel-states-label"/>
            <VBox styleClass="payload-panel-states" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="payload-state-dot,payload-state-success"/>
                    <Label text="已生成" styleClass="payload-state-label" userData="i18n:payload.state.generated"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="payload-state-dot,payload-state-format"/>
                    <Label fx:id="memshellStateLabel" text="Godzilla/Tomcat" styleClass="payload-state-label"/>
                </HBox>
            </VBox>
        </VBox>
    </SmoothScrollPane>

</StackPane>
