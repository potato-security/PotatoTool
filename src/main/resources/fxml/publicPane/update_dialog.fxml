<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane fx:id="an"
            onMouseDragged="#topBarDraggedAction"
            onMousePressed="#topBarPressedAction"
            maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="580"
            prefWidth="520"
            style="-fx-background-color: transparent"
            xmlns="http://javafx.com/javafx/"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../../css/common.css, @../../css/components.css, @../../css/updateDialog.css"
            fx:controller="com.potato.potatotool.controller.publicPane.PaneUpdateDialog">
    <children>
        <StackPane AnchorPane.topAnchor="9" AnchorPane.bottomAnchor="9"
                   AnchorPane.leftAnchor="9" AnchorPane.rightAnchor="9">
            <effect><DropShadow blurType="GAUSSIAN" color="#000000" radius="18" spread="0.1"/></effect>

            <!-- 四角取景框 -->
            <Region styleClass="pt-corner-tl" StackPane.alignment="TOP_LEFT"/>
            <Region styleClass="pt-corner-tr" StackPane.alignment="TOP_RIGHT"/>
            <Region styleClass="pt-corner-bl" StackPane.alignment="BOTTOM_LEFT"/>
            <Region styleClass="pt-corner-br" StackPane.alignment="BOTTOM_RIGHT"/>

            <VBox styleClass="upd-dialog" fx:id="outerBorderPane">

                <!-- 标题栏 -->
                <BorderPane fx:id="topBar" styleClass="upd-header"
                            prefHeight="48" prefWidth="${an.width - 18}">
                    <left>
                        <Label fx:id="titleLabel" styleClass="upd-title"
                               text="发现更新" userData="i18n:update.available.title"
                               BorderPane.alignment="CENTER"/>
                    </left>
                    <right>
                        <HBox alignment="CENTER" prefHeight="${topBar.height}" spacing="0">
                            <Button styleClass="upd-close-btn" mnemonicParsing="false"
                                    onAction="#exitAction" text="✕"
                                    prefHeight="20" prefWidth="20"/>
                            <Pane minWidth="12"/>
                        </HBox>
                    </right>
                </BorderPane>

                <!-- 版本信息条 -->
                <BorderPane styleClass="upd-version-bar">
                    <left>
                        <Label fx:id="versionInfoLabel"
                               styleClass="upd-version-info"
                               text="正在检查更新..." wrapText="true"
                               BorderPane.alignment="CENTER"/>
                    </left>
                    <right>
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="updateCountLabel"
                                   styleClass="upd-count-chip"
                                   text="" visible="false" managed="false"/>
                            <Pane minWidth="4"/>
                        </HBox>
                    </right>
                </BorderPane>

                <!-- 主体内容 -->
                <VBox styleClass="upd-body" VBox.vgrow="ALWAYS">

                    <!-- 更新项列表 -->
                    <VBox fx:id="updateItemsBox" managed="false" visible="false">
                        <VBox fx:id="updateItemsContainer" spacing="0"/>
                    </VBox>

                    <!-- 更新日志 - 可折叠 -->
                    <VBox fx:id="changelogBox" managed="false" visible="false"
                          styleClass="upd-changelog-card">
                        <BorderPane styleClass="upd-changelog-header"
                                    onMouseClicked="#toggleChangelog">
                            <left>
                                <HBox spacing="6" alignment="CENTER_LEFT"
                                      BorderPane.alignment="CENTER">
                                    <Label fx:id="changelogArrow" text="▶"
                                           styleClass="upd-changelog-arrow"/>
                                    <Label text="更新日志"
                                           styleClass="upd-changelog-title"
                                           userData="i18n:update.available.changelog"/>
                                </HBox>
                            </left>
                            <right>
                                <Label fx:id="changelogToggleBtn"
                                       text="展开"
                                       styleClass="upd-changelog-toggle-btn"
                                       userData="i18n:update.changelog.expand"
                                       BorderPane.alignment="CENTER"/>
                            </right>
                        </BorderPane>
                        <VBox fx:id="changelogContent" visible="false" managed="false"
                              styleClass="upd-changelog-content">
                            <SmoothTextArea fx:id="changelogText" editable="false" wrapText="true"
                                            prefHeight="90" styleClass="pt-input,upd-changelog-text"/>
                        </VBox>
                    </VBox>

                    <!-- 下载进度 -->
                    <VBox spacing="8" fx:id="progressBox" managed="false" visible="false"
                          styleClass="upd-progress-card">
                        <Label fx:id="progressLabel" text="正在下载..." styleClass="pt-caption"/>
                        <ProgressBar fx:id="progressBar" prefWidth="${an.width - 62}" prefHeight="6"
                                     styleClass="upd-progress-bar" progress="0"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="sizeLabel" text="0 MB / 0 MB" styleClass="pt-caption"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="speedLabel" text="0 KB/s" styleClass="pt-caption"/>
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- 底部按钮区 -->
                    <VBox spacing="10" styleClass="upd-btn-area">

                        <!-- 重启提示 -->
                        <HBox spacing="10" alignment="CENTER_LEFT" fx:id="restartBox"
                              managed="false" visible="false" styleClass="upd-restart-row">
                            <Label fx:id="restartLabel"
                                   text="更新已就绪，点击重启应用完成更新"
                                   userData="i18n:update.install.app.message"
                                   styleClass="upd-restart-text"
                                   HBox.hgrow="ALWAYS" wrapText="true"/>
                            <Button fx:id="restartNowButton" text="立即重启"
                                    styleClass="pt-btn-solid"
                                    userData="i18n:update.install.app.restart.now"
                                    onAction="#onRestartNowClick"
                                    minWidth="100" minHeight="38"/>
                        </HBox>

                        <!-- 主按钮 -->
                        <HBox fx:id="buttonBox" alignment="CENTER">
                            <Button fx:id="updateButton" text="立即更新"
                                    styleClass="pt-btn-solid,upd-primary-btn"
                                    userData="i18n:update.available.button.update.selected"
                                    onAction="#onUpdateClick"
                                    maxWidth="Infinity" minHeight="42"
                                    HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <!-- 次要按钮 -->
                        <HBox alignment="CENTER" spacing="10">
                            <Button fx:id="laterButton" text="稍后提醒"
                                    styleClass="pt-btn,upd-secondary-btn"
                                    userData="i18n:update.available.button.later"
                                    onAction="#onLaterClick"
                                    maxWidth="Infinity" minHeight="36"
                                    HBox.hgrow="ALWAYS"/>
                            <Button fx:id="skipButton" text="跳过选中项"
                                    styleClass="pt-btn,upd-secondary-btn"
                                    userData="i18n:update.available.button.skip.selected"
                                    onAction="#onSkipClick"
                                    maxWidth="Infinity" minHeight="36"
                                    HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                </VBox>
            </VBox>

            <!-- 提示组件 -->
            <StackPane fx:id="promptPane" visible="false" managed="false"
                       maxHeight="-Infinity" maxWidth="-Infinity" alignment="CENTER">
                <Label fx:id="prompt" text=""
                       wrapText="true" textAlignment="CENTER" alignment="CENTER"
                       minHeight="-Infinity" maxWidth="500"/>
            </StackPane>
        </StackPane>
    </children>
</AnchorPane>
