<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import com.dlsc.gemsfx.CFSwitch?>
<AnchorPane xmlns="http://javafx.com/javafx/"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.potato.potatotool.controller.publicPane.PaneSetting"
            fx:id="an"
            stylesheets="@../../css/setting.css"
            style="-fx-background-color: transparent;"
            onMouseDragged="#topBarDraggedAction"
            onMousePressed="#topBarPressedAction"
            prefWidth="750"
            prefHeight="620"
>
    <children>
        <StackPane fx:id="outerBorderPane" layoutX="9.0" layoutY="9.0">
            <effect>
                <DropShadow/>
            </effect>
            <VBox>
                <BorderPane fx:id="topBar" style="-fx-background-color: -pt-bg-elevated;" prefHeight="45" prefWidth="${an.width - 18}" BorderPane.alignment="CENTER">
                    <center>
                        <Label styleClass="pt-h1" style="-fx-padding: 0 0 0 30;" alignment="CENTER" prefHeight="${topBar.height}" prefWidth="${topBar.width}" text="修改配置" userData="i18n:setting.title" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    </center>
                    <right>
                        <HBox alignment="CENTER"  fx:id="appController" prefHeight="${topBar.height}">
                            <Button id="btnExitSmall" styleClass="setting-close-btn"
                                    mnemonicParsing="false" onAction="#exitAction"
                                    text="×">
                                <tooltip>
                                    <Tooltip text="关闭" userData="i18n:tooltip.close"/>
                                </tooltip>
                            </Button>
                            <Pane minWidth="10"/>
                        </HBox>
                    </right>
                </BorderPane>
                <SmoothScrollPane prefHeight="550" styleClass="SPane" prefWidth="${an.width - 18}">
                    <VBox styleClass="content" alignment="CENTER" spacing="10" prefWidth="${an.width - 28}">
                        <VBox fx:id="vBoxBar">
                            <Accordion fx:id="settingAccordion" prefWidth="${an.width - 38}">
                                <panes>
                                    <!-- 基础配置 -->
                                    <TitledPane fx:id="basicPane" text="基础配置" userData="i18n:setting.basic.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="20" style="-fx-padding: 15;">
                                            <StackPane>
                                                <Label fx:id="maxWidthlabel" style="-fx-text-fill: -pt-bg-panel;" textAlignment="RIGHT" text="长格式占位符：" userData="i18n:setting.basic.placeholder.long"/>
                                                <Label fx:id="maxWidthlabelSuper" style="-fx-text-fill: -pt-bg-panel;" textAlignment="RIGHT" text="超长版格式占位符：" userData="i18n:setting.basic.placeholder.long"/>
                                                <HBox alignment="CENTER" spacing="10">
                                                    <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="语言设置：" userData="i18n:setting.basic.language"/>
                                                    <ComboBox fx:id="languageComboBox" prefHeight="20.0" prefWidth="250">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="简体中文" />
                                                                <String fx:value="English" />
                                                            </FXCollections>
                                                        </items>
                                                    </ComboBox>
                                                </HBox>
                                            </StackPane>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="启动动画：" userData="i18n:setting.basic.bootAnimation">
                                                    <tooltip>
                                                        <Tooltip text="完整版：5 秒指挥舱仪式。极简版：约 2 秒只显示 Logo。关闭：跳过启动页直接进入主界面。" userData="i18n:setting.basic.bootAnimation.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <ComboBox fx:id="bootAnimationComboBox" prefHeight="20.0" prefWidth="250">
                                                    <tooltip>
                                                        <Tooltip text="完整版：5 秒指挥舱仪式。极简版：约 2 秒只显示 Logo。关闭：跳过启动页直接进入主界面。" userData="i18n:setting.basic.bootAnimation.tooltip"/>
                                                    </tooltip>
                                                </ComboBox>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="设置总代理：" userData="i18n:setting.basic.proxy">
                                                    <tooltip>
                                                        <Tooltip text="主代理为总开关，关闭后子服务代理不可用；开启后按子开关决定是否使用代理" userData="i18n:setting.basic.proxy.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <StackPane>
                                                    <TextField fx:id="proxy" styleClass="pt-input" prefWidth="250" promptText="[http/socks]://IP:端口" userData="i18n-prompt:setting.basic.proxy.placeholder" StackPane.alignment="CENTER">
                                                        <tooltip>
                                                            <Tooltip text="主代理为总开关，关闭后子服务代理不可用；开启后按子开关决定是否使用代理" userData="i18n:setting.basic.proxy.tooltip"/>
                                                        </tooltip>
                                                    </TextField>
                                                    <CFSwitch fx:id="proxyButton" StackPane.alignment="CENTER_RIGHT">
                                                        <tooltip>
                                                            <Tooltip text="主代理为总开关，关闭后子服务代理不可用；开启后按子开关决定是否使用代理" userData="i18n:setting.basic.proxy.tooltip"/>
                                                        </tooltip>
                                                    </CFSwitch>
                                                </StackPane>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="默认反编译器：" userData="i18n:setting.basic.decompile"/>
                                                <ComboBox fx:id="decompileType" prefHeight="20.0" prefWidth="250">
                                                    <items>
                                                        <FXCollections fx:factory="observableArrayList">
                                                            <String fx:value="idea" />
                                                            <String fx:value="procyon" />
                                                        </FXCollections>
                                                    </items>
                                                </ComboBox>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="浏览器路径：" userData="i18n:setting.browser.path"/>
                                                <TextField fx:id="browserRuntimePath" styleClass="pt-input" prefWidth="250" promptText="留空则启动后自动探测并保存 Chrome/Chromium" userData="i18n-prompt:setting.browser.path.placeholder"/>
                                                <Button styleClass="pt-btn" text="浏览" minHeight="28" minWidth="72" prefWidth="72" onAction="#browseBrowserRuntimePath" userData="i18n:app.browse"/>
                                                <Button styleClass="pt-btn" text="检测" minHeight="28" minWidth="72" prefWidth="72" onAction="#testBrowserRuntimeCompatibility" userData="i18n:setting.browser.test"/>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="Python 路径：" userData="i18n:setting.python.path"/>
                                                <TextField fx:id="pythonRuntimePath" styleClass="pt-input" prefWidth="250" promptText="留空则启动后自动探测并保存 Python" userData="i18n-prompt:setting.python.path.placeholder"/>
                                                <Button styleClass="pt-btn" text="浏览" minHeight="28" minWidth="72" prefWidth="72" onAction="#browsePythonRuntimePath" userData="i18n:app.browse"/>
                                            </HBox>

        <!--                            <HBox alignment="CENTER" spacing="10">-->
        <!--                                <Button fx:id="viewProfileButton" minHeight="38.0" minWidth="150" text="查看配置文件" onAction="#viewProfile">-->
        <!--                                    <effect>-->
        <!--                                        <DropShadow />-->
        <!--                                    </effect>-->
        <!--                                </Button>-->
        <!--                            </HBox>-->

                                            <HBox alignment="CENTER">
                                                <Button styleClass="pt-btn-primary" minHeight="38.0" minWidth="150" text="保存" userData="i18n:app.save" onAction="#save">
                                                    <effect>
                                                        <DropShadow />
                                                    </effect>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </TitledPane>

                                    <!-- AI配置 -->
                                    <TitledPane fx:id="aiPane" text="AI配置" userData="i18n:setting.ai.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="20" style="-fx-padding: 15;">
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="内置 AI 网关：" userData="i18n:setting.ai.mode">
                                                    <tooltip>
                                                        <Tooltip text="开启后使用 PotatoTool 内置 AI 网关与客户端证书；关闭后按自定义 AI 配置直连。" userData="i18n:setting.ai.mode.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <HBox prefWidth="250">
                                                    <CFSwitch fx:id="aiUseBuiltinGateway"/>
                                                </HBox>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="AI Base URL：" userData="i18n:setting.ai.api.base">
                                                    <tooltip>
                                                        <Tooltip text="自定义模式下填写完整 API Base；启用内置 AI 网关时此项无需填写。" userData="i18n:setting.ai.api.base.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <TextField fx:id="aiApiBase" styleClass="pt-input" promptText="自定义模式下填写" prefWidth="250" userData="i18n-prompt:setting.ai.api.base.placeholder">
                                                    <tooltip>
                                                        <Tooltip text="自定义模式下填写完整 API Base；启用内置 AI 网关时此项无需填写。" userData="i18n:setting.ai.api.base.tooltip"/>
                                                    </tooltip>
                                                </TextField>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="AI API Key：" userData="i18n:setting.ai.api.key">
                                                    <tooltip>
                                                        <Tooltip text="自定义模式下填写 API Key；启用内置 AI 网关时此项无需填写。" userData="i18n:setting.ai.api.key.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <TextField fx:id="aiApiKey" styleClass="pt-input" promptText="自定义模式下填写" prefWidth="250" userData="i18n-prompt:setting.ai.api.key.placeholder">
                                                    <tooltip>
                                                        <Tooltip text="自定义模式下填写 API Key；启用内置 AI 网关时此项无需填写。" userData="i18n:setting.ai.api.key.tooltip"/>
                                                    </tooltip>
                                                </TextField>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label  minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="AI Model：" userData="i18n:setting.ai.model">
                                                    <tooltip>
                                                        <Tooltip text="自定义模式下填写模型名；启用内置 AI 网关时使用内置 alias，无需填写。" userData="i18n:setting.ai.model.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <TextField fx:id="aiModel" styleClass="pt-input" promptText="自定义模式下填写" prefWidth="250" userData="i18n-prompt:setting.ai.model.placeholder">
                                                    <tooltip>
                                                        <Tooltip text="自定义模式下填写模型名；启用内置 AI 网关时使用内置 alias，无需填写。" userData="i18n:setting.ai.model.tooltip"/>
                                                    </tooltip>
                                                </TextField>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label  minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="接口协议：" userData="i18n:setting.ai.provider"/>
                                                <ComboBox fx:id="aiProvider" prefWidth="250">
                                                    <items>
                                                        <FXCollections fx:factory="observableArrayList">
                                                            <String fx:value="OPENAI"/>
                                                            <String fx:value="ANTHROPIC"/>
                                                            <String fx:value="GEMINI"/>
                                                        </FXCollections>
                                                    </items>
                                                </ComboBox>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label  minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="Timeout(ms)：" userData="i18n:setting.ai.timeout"/>
                                                <TextField fx:id="aiTimeoutMs" styleClass="pt-input" promptText="60000" prefWidth="250" userData="i18n-prompt:setting.ai.timeout.placeholder"/>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label  minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="默认开启 Thinking：" userData="i18n:setting.ai.thinking.enabled"/>
                                                <HBox prefWidth="250">
                                                    <CFSwitch fx:id="aiThinkingEnabled"/>
                                                </HBox>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label  minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="Thinking Budget：" userData="i18n:setting.ai.thinking.budget"/>
                                                <TextField fx:id="aiThinkingBudgetTokens" styleClass="pt-input" promptText="1024" prefWidth="250" userData="i18n-prompt:setting.ai.thinking.budget.placeholder"/>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label  minWidth="${maxWidthlabelSuper.width}" textAlignment="RIGHT" text="代理：" userData="i18n:setting.ai.proxy"/>
                                                <HBox prefWidth="250">
                                                    <CFSwitch fx:id="aiProxy"/>
                                                </HBox>
                                            </HBox>

                                            <HBox alignment="CENTER">
                                                <Button styleClass="pt-btn-primary" minHeight="38.0" minWidth="150" text="保存" userData="i18n:app.save" onAction="#save">
                                                    <effect>
                                                        <DropShadow />
                                                    </effect>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </TitledPane>

                                    <!-- 资产测绘配置 -->
                                    <TitledPane fx:id="assetPane" text="资产测绘配置" userData="i18n:setting.asset.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="20" style="-fx-padding: 15;">
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" visible="false"/>
                                                <TextField visible="false" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <Label text="  代理" userData="i18n:setting.basic.proxy.label"/>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label fx:id="newMaxWidthlabel" textAlignment="RIGHT" text="Aiqicha_Cookie：" userData="i18n:setting.asset.aiqicha">
                                                    <tooltip>
                                                        <Tooltip text="使用BP直接抓包获取，或浏览器访问view-source:https://aiqicha.baidu.com获取Cookie" userData="i18n:setting.asset.aiqicha.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <TextField fx:id="aiqichaCookie" styleClass="pt-input" prefWidth="250">
                                                    <tooltip>
                                                        <Tooltip text="使用BP直接抓包获取，或浏览器访问view-source:https://aiqicha.baidu.com获取Cookie" userData="i18n:setting.asset.aiqicha.tooltip"/>
                                                    </tooltip>
                                                </TextField>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="aiqichaProxy">
                                                    <tooltip>
                                                        <Tooltip text="需要中国IP,建议关闭代理" userData="i18n:setting.asset.aiqicha.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Chinaz_Cookie：" userData="i18n:setting.asset.chinaz"/>
                                                <TextField fx:id="chinazCookie" styleClass="pt-input" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="chinazProxy"/>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Fofa_Key：" userData="i18n:setting.asset.fofa"/>
                                                <TextField fx:id="fofaKey" styleClass="pt-input" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="fofaProxy"/>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Hunter_Key：" userData="i18n:setting.asset.hunter"/>
                                                <VBox fx:id="hunterVBox" alignment="CENTER_LEFT"  spacing="10">
                                                    <StackPane>
                                                        <TextField styleClass="paddingRightButton" prefWidth="250" StackPane.alignment="CENTER"/>
                                                        <Label alignment="CENTER" translateX="35" styleClass="rightButton" onMouseClicked="#addTextField" StackPane.alignment="CENTER_RIGHT">
                                                            <graphic>
                                                                <Region styleClass="addIcon"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="添加" userData="i18n:tooltip.add"/>
                                                            </tooltip>
                                                        </Label>
                                                    </StackPane>
                                                </VBox>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="hunterProxy">
                                                    <tooltip>
                                                        <Tooltip text="需要中国IP,建议关闭代理" userData="i18n:setting.asset.hunter.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Quake_Key：" userData="i18n:setting.asset.quake"/>
                                                <VBox fx:id="quakeVBox" alignment="CENTER_LEFT"  spacing="10">
                                                    <StackPane>
                                                        <TextField styleClass="paddingRightButton" prefWidth="250" StackPane.alignment="CENTER"/>
                                                        <Label alignment="CENTER" translateX="35" styleClass="rightButton" onMouseClicked="#addTextField" StackPane.alignment="CENTER_RIGHT">
                                                            <graphic>
                                                                <Region styleClass="addIcon"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="添加" userData="i18n:tooltip.add"/>
                                                            </tooltip>
                                                        </Label>
                                                    </StackPane>
                                                </VBox>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="quakeProxy"/>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Shodan_Key：" userData="i18n:setting.asset.shodan"/>
                                                <TextField fx:id="shodanKey" styleClass="pt-input" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="shodanProxy"/>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Zoomeye_Key：" userData="i18n:setting.asset.zoomeye"/>
                                                <TextField fx:id="zoomeyeKey" styleClass="pt-input" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="zoomeyeProxy">
                                                    <tooltip>
                                                        <Tooltip text="需要国外IP,建议开启代理" userData="i18n:setting.asset.zoomeye.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Google_API：" userData="i18n:setting.asset.google"/>
                                                <VBox fx:id="googleVBox" alignment="CENTER_LEFT"  spacing="10">
                                                    <StackPane>
                                                        <TextField styleClass="paddingRightButton" promptText="格式为Google_Key:Google_Cx" prefWidth="250" StackPane.alignment="CENTER" userData="i18n-prompt:setting.asset.google.placeholder">
                                                            <tooltip>
                                                                <Tooltip text="格式为Google_Key:Google_Cx" userData="i18n:setting.asset.google.tooltip"/>
                                                            </tooltip>
                                                        </TextField>
                                                        <Label alignment="CENTER" translateX="35" styleClass="rightButton" onMouseClicked="#addTextField" StackPane.alignment="CENTER_RIGHT">
                                                            <graphic>
                                                                <Region styleClass="addIcon"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="添加" userData="i18n:tooltip.add"/>
                                                            </tooltip>
                                                        </Label>
                                                    </StackPane>
                                                </VBox>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="googleProxy">
                                                    <tooltip>
                                                        <Tooltip text="需要国外IP,建议开启代理" userData="i18n:setting.asset.google.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="GitHub_Token：" userData="i18n:setting.asset.github"/>
                                                <VBox fx:id="githubVBox" alignment="CENTER_LEFT"  spacing="10">
                                                    <StackPane>
                                                        <TextField styleClass="paddingRightButton" prefWidth="250" StackPane.alignment="CENTER"/>
                                                        <Label alignment="CENTER" translateX="35" styleClass="rightButton" onMouseClicked="#addTextField" StackPane.alignment="CENTER_RIGHT">
                                                            <graphic>
                                                                <Region styleClass="addIcon"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="添加" userData="i18n:tooltip.add"/>
                                                            </tooltip>
                                                        </Label>
                                                    </StackPane>
                                                </VBox>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="githubProxy">
                                                    <tooltip>
                                                        <Tooltip text="国外IP更稳定，建议开启代理" userData="i18n:setting.asset.github.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}"/>
                                                <Label minWidth="250" alignment="CENTER" text="通过SSL获取子域" userData="i18n:setting.asset.ssl"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="sslProxy">
                                                    <tooltip>
                                                        <Tooltip text="存在国外平台,建议开启代理" userData="i18n:setting.asset.ssl.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}"/>
                                                <Label minWidth="250" alignment="CENTER" text="对网站进行本地深度扫描" userData="i18n:setting.asset.crawl"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="crawlProxy">
                                                    <tooltip>
                                                        <Tooltip text="多为中国资产,建议关闭代理" userData="i18n:setting.asset.crawl.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="CENTER">
                                                <Button styleClass="pt-btn-primary" minHeight="38.0" minWidth="150" text="保存" userData="i18n:app.save" onAction="#saveAsset">
                                                    <effect>
                                                        <DropShadow />
                                                    </effect>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </TitledPane>

                                    <!-- 漏洞扫描配置 -->
                                    <TitledPane fx:id="vulnScanPane" text="漏洞扫描配置" userData="i18n:setting.vulnscan.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="12" style="-fx-padding: 14 15 12 15;">
                                            
                                            <!-- 性能配置区 -->
                                            <VBox spacing="8" styleClass="pt-panel">
                                                <HBox alignment="CENTER_LEFT" spacing="8">
