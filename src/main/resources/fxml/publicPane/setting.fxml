                                                                    styleClass="pt-btn" onAction="#checkMd5"
                                                                    minWidth="72" minHeight="28"/>
                                                            <Button fx:id="md5UpdateButton" text="下载"
                                                                    userData="i18n:setting.update.md5.download"
                                                                    styleClass="pt-btn-primary" onAction="#updateMd5"
                                                                    minWidth="72" minHeight="28"
                                                                    visible="false" managed="false"/>
                                                            <Button fx:id="md5StopUpdateButton" text="取消"
                                                                    userData="i18n:setting.update.md5.cancel"
                                                                    styleClass="pt-btn" onAction="#stopMd5"
                                                                    minWidth="72" minHeight="28"
                                                                    visible="false" managed="false"/>
                                                        </HBox>
                                                        <VBox fx:id="md5ProgressVBox" spacing="4" visible="false" managed="false">
                                                            <ProgressBar fx:id="md5ProgressBar" maxWidth="Infinity" prefHeight="6" progress="0"/>
                                                            <Label fx:id="md5ProgressLabel" text="" styleClass="pt-caption"/>
                                                        </VBox>
                                                    </VBox>
                                                    <Separator orientation="VERTICAL"/>
                                                    <!-- KB 库 -->
                                                    <VBox HBox.hgrow="ALWAYS" spacing="6">
                                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                                            <Label text="微软kb库：" userData="i18n:setting.update.kb"/>
                                                            <Label fx:id="kbTips" text="" styleClass="pt-caption" style="-fx-text-fill: -pt-text-tertiary;"/>
                                                        </HBox>
                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                            <Button fx:id="kbCheckButton" text="检测"
                                                                    userData="i18n:setting.update.kb.check"
                                                                    styleClass="pt-btn" onAction="#checkKb"
                                                                    minWidth="72" minHeight="28"/>
                                                            <Button fx:id="kbUpdateButton" text="下载"
                                                                    userData="i18n:setting.update.kb.download"
                                                                    styleClass="pt-btn-primary" onAction="#updateKb"
                                                                    minWidth="72" minHeight="28"
                                                                    visible="false" managed="false"/>
                                                            <Button fx:id="kbStopUpdateButton" text="取消"
                                                                    userData="i18n:setting.update.kb.cancel"
                                                                    styleClass="pt-btn" onAction="#stopKb"
                                                                    minWidth="72" minHeight="28"
                                                                    visible="false" managed="false"/>
                                                        </HBox>
                                                        <VBox fx:id="kbProgressVBox" spacing="4" visible="false" managed="false">
                                                            <ProgressBar fx:id="kbProgressBar" maxWidth="Infinity" prefHeight="6" progress="0"/>
                                                            <Label fx:id="kbProgressLabel" text="" styleClass="pt-caption"/>
                                                        </VBox>
                                                    </VBox>
                                                </HBox>
                                            </VBox>

                                            <Separator prefWidth="${an.width - 58}"/>

                                            <!-- 存储位置管理 -->
                                            <VBox spacing="8" styleClass="pt-panel">
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <Region prefWidth="16" prefHeight="16" maxWidth="16" maxHeight="16" style="-fx-shape: 'M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 1.99 2H20c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z'; -fx-background-color: -pt-accent;"/>
                                                    <Label styleClass="pt-h2"
                                                          text="存储位置管理" userData="i18n:update.storage.title"/>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT"
                                                          text="配置文件位置（不可修改）："
                                                          userData="i18n:update.storage.config.path"/>
                                                    <Label fx:id="configPathLabel" style="-fx-text-fill: -pt-text-muted;"/>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT"
                                                          text="资源文件位置："
                                                          userData="i18n:update.storage.resource.path"/>
                                                    <TextField fx:id="resourcePathField" styleClass="pt-input" prefWidth="350" editable="false"/>
                                                    <Button styleClass="pt-btn" text="浏览..." userData="i18n:update.storage.button.browse"
                                                           onAction="#browseResourcePath" minWidth="80" minHeight="25">
                                                        <effect><DropShadow /></effect>
                                                    </Button>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT"
                                                          text="当前占用空间："
                                                          userData="i18n:update.storage.current.size"/>
                                                    <Label fx:id="currentSizeLabel" text="计算中..."/>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT"
                                                          text="可用空间："
                                                          userData="i18n:update.storage.available.size"/>
                                                    <Label fx:id="availableSizeLabel" text="计算中..."/>
                                                </HBox>

                                                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
                                                    <Button styleClass="pt-btn" text="迁移资源文件" userData="i18n:update.storage.button.migrate"
                                                           fx:id="migrateButton"
                                                           onAction="#migrateResources" minWidth="120" minHeight="30">
                                                        <effect><DropShadow /></effect>
                                                    </Button>
                                                    <Button styleClass="pt-btn" text="恢复默认位置" userData="i18n:update.storage.button.reset"
                                                           fx:id="resetPathButton"
                                                           onAction="#resetResourcePath" minWidth="120" minHeight="30">
                                                        <effect><DropShadow /></effect>
                                                    </Button>
                                                    <Button styleClass="pt-btn" text="检查软件更新"
                                                           fx:id="checkAppUpdateButton"
                                                           onAction="#checkAppUpdate" minWidth="120" minHeight="30">
                                                        <effect><DropShadow /></effect>
                                                    </Button>
                                                </HBox>
                                            </VBox>
                                        </VBox>
                                    </TitledPane>
                                </panes>
                            </Accordion>
                        </VBox>
                    </VBox>
                </SmoothScrollPane>
            </VBox>
            <StackPane fx:id="promptPane" visible="false" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" alignment="CENTER" StackPane.alignment="CENTER" onMouseClicked="#closePromptPane">
                <Label fx:id="prompt" wrapText="true" textAlignment="CENTER" alignment="CENTER" minHeight="-Infinity" maxWidth="600"/>
            </StackPane>
        </StackPane>
    </children>

</AnchorPane>
