<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import com.dlsc.gemsfx.CFSwitch?>
<AnchorPane xmlns="http://javafx.com/javafx/"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.potato.potatotool.controller.publicPane.PaneSetting"
            fx:id="an"
            stylesheets="@../../css/setting.css"
            style="-fx-background-color: transparent;"
            onMouseDragged="#topBarDraggedAction"
            onMousePressed="#topBarPressedAction"
            prefWidth="750"
            prefHeight="620"
>
    <children>
        <StackPane fx:id="outerBorderPane" layoutX="9.0" layoutY="9.0">
            <effect>
                <DropShadow/>
            </effect>
            <VBox>
                <BorderPane fx:id="topBar" style="-fx-background-color: -main-btnContent-color;" prefHeight="45" prefWidth="${an.width - 18}" BorderPane.alignment="CENTER">
                    <center>
                        <Label style="-fx-padding: 0 0 0 30;-fx-font-size: 23;-fx-font-weight: bold;" alignment="CENTER" prefHeight="${topBar.height}" prefWidth="${topBar.width}" text="修改配置" userData="i18n:setting.title" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    </center>
                    <right>
                        <HBox alignment="CENTER"  fx:id="appController" prefHeight="${topBar.height}">
                            <Button id="btnExitSmall" mnemonicParsing="false" onAction="#exitAction" prefHeight="25.0" prefWidth="25.0">
                                <graphic>
                                    <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@../../img/close.png" />
                                        </image>
                                    </ImageView>
                                </graphic>
                                <tooltip>
                                    <Tooltip text="关闭" userData="i18n:tooltip.close"/>
                                </tooltip>
                            </Button>
                            <Pane minWidth="10"/>
                        </HBox>
                    </right>
                </BorderPane>
                <SmoothScrollPane prefHeight="550" styleClass="SPane" prefWidth="${an.width - 18}">
                    <VBox styleClass="content" alignment="CENTER" spacing="10" prefWidth="${an.width - 28}">
                        <VBox fx:id="vBoxBar">
                            <Accordion fx:id="settingAccordion" prefWidth="${an.width - 38}">
                                <panes>
                                    <!-- 基础配置 -->
                                    <TitledPane fx:id="basicPane" text="基础配置" userData="i18n:setting.basic.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="20" style="-fx-padding: 15;">
                                            <StackPane>
                                                <Label fx:id="maxWidthlabel" style="-fx-text-fill: -main-topBar-color;" textAlignment="RIGHT" text="长格式占位符：" userData="i18n:setting.basic.placeholder.long"/>
                                                <HBox alignment="CENTER" spacing="10">
                                                    <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="语言设置：" userData="i18n:setting.basic.language"/>
                                                    <ComboBox fx:id="languageComboBox" prefHeight="20.0" prefWidth="250">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="简体中文" />
                                                                <String fx:value="English" />
                                                            </FXCollections>
                                                        </items>
                                                    </ComboBox>
                                                </HBox>
                                            </StackPane>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="设置总代理：" userData="i18n:setting.basic.proxy">
                                                    <tooltip>
                                                        <Tooltip text="主代理为总开关，关闭后子服务代理不可用；开启后按子开关决定是否使用代理" userData="i18n:setting.basic.proxy.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <StackPane>
                                                    <TextField fx:id="proxy" prefWidth="250" promptText="[http/socks]://IP:端口" userData="i18n-prompt:setting.basic.proxy.placeholder" StackPane.alignment="CENTER">
                                                        <tooltip>
                                                            <Tooltip text="主代理为总开关，关闭后子服务代理不可用；开启后按子开关决定是否使用代理" userData="i18n:setting.basic.proxy.tooltip"/>
                                                        </tooltip>
                                                    </TextField>
                                                    <CFSwitch fx:id="proxyButton" onMouseClicked="#proxyBtn" StackPane.alignment="CENTER_RIGHT">
                                                        <tooltip>
                                                            <Tooltip text="主代理为总开关，关闭后子服务代理不可用；开启后按子开关决定是否使用代理" userData="i18n:setting.basic.proxy.tooltip"/>
                                                        </tooltip>
                                                    </CFSwitch>
                                                </StackPane>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="默认反编译器：" userData="i18n:setting.basic.decompile"/>
                                                <ComboBox fx:id="decompileType" prefHeight="20.0" prefWidth="250">
                                                    <items>
                                                        <FXCollections fx:factory="observableArrayList">
                                                            <String fx:value="idea" />
                                                            <String fx:value="procyon" />
                                                        </FXCollections>
                                                    </items>
                                                </ComboBox>
                                            </HBox>

        <!--                            <HBox alignment="CENTER" spacing="10">-->
        <!--                                <Button fx:id="viewProfileButton" minHeight="38.0" minWidth="150" text="查看配置文件" onAction="#viewProfile">-->
        <!--                                    <effect>-->
        <!--                                        <DropShadow />-->
        <!--                                    </effect>-->
        <!--                                </Button>-->
        <!--                            </HBox>-->

                                            <HBox alignment="CENTER">
                                                <Button minHeight="38.0" minWidth="150" text="保存" userData="i18n:app.save" onAction="#save">
                                                    <effect>
                                                        <DropShadow />
                                                    </effect>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </TitledPane>

                                    <!-- AI配置 -->
                                    <TitledPane fx:id="aiPane" text="AI配置" userData="i18n:setting.ai.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="20" style="-fx-padding: 15;">
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="AI_API_Base：" userData="i18n:setting.ai.api.base">
                                                    <tooltip>
                                                        <Tooltip text="请输入API接口。 不输入则使用本工具默认免费接口" userData="i18n:setting.ai.api.base.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <TextField fx:id="aiApiBase" promptText="不输入则使用默认接口" prefWidth="250" userData="i18n-prompt:setting.ai.api.base.placeholder">
                                                    <tooltip>
                                                        <Tooltip text="请输入API接口。 不输入则使用本工具默认免费接口" userData="i18n:setting.ai.api.base.tooltip"/>
                                                    </tooltip>
                                                </TextField>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="AI_API_Key：" userData="i18n:setting.ai.api.key">
                                                    <tooltip>
                                                        <Tooltip text="请输入API密钥。 不输入则使用本工具默认免费接口" userData="i18n:setting.ai.api.key.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <TextField fx:id="aiApiKey" promptText="不输入则使用默认接口" prefWidth="250" userData="i18n-prompt:setting.ai.api.key.placeholder">
                                                    <tooltip>
                                                        <Tooltip text="请输入API密钥。 不输入则使用本工具默认免费接口" userData="i18n:setting.ai.api.key.tooltip"/>
                                                    </tooltip>
                                                </TextField>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label  minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="AI_Model：" userData="i18n:setting.ai.model">
                                                    <tooltip>
                                                        <Tooltip text="请输入模型版本，（请和Key对应）如：gpt-5、gpt-4o-mini、gpt-4o、gpt-4-0314、gpt-3.5-turbo-16k-0613" userData="i18n:setting.ai.model.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <TextField fx:id="aiModel" promptText="不输入则使用默认接口" prefWidth="250" userData="i18n-prompt:setting.ai.model.placeholder">
                                                    <tooltip>
                                                        <Tooltip text="请输入模型版本。 不输入则使用本工具默认免费接口" userData="i18n:setting.ai.model.tooltip"/>
                                                    </tooltip>
                                                </TextField>
                                            </HBox>

                                            <HBox alignment="CENTER" spacing="10">
                                                <Label  minWidth="${maxWidthlabel.width}" textAlignment="RIGHT" text="代理：" userData="i18n:setting.ai.proxy"/>
                                                <HBox prefWidth="250">
                                                    <CFSwitch fx:id="aiProxy"/>
                                                </HBox>
                                            </HBox>

                                            <HBox alignment="CENTER">
                                                <Button minHeight="38.0" minWidth="150" text="保存" userData="i18n:app.save" onAction="#save">
                                                    <effect>
                                                        <DropShadow />
                                                    </effect>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </TitledPane>

                                    <!-- 资产测绘配置 -->
                                    <TitledPane fx:id="assetPane" text="资产测绘配置" userData="i18n:setting.asset.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="20" style="-fx-padding: 15;">
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${maxWidthlabel.width}" visible="false"/>
                                                <TextField visible="false" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <Label text="  代理" userData="i18n:setting.basic.proxy.label"/>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label fx:id="newMaxWidthlabel" textAlignment="RIGHT" text="Aiqicha_Cookie：" userData="i18n:setting.asset.aiqicha">
                                                    <tooltip>
                                                        <Tooltip text="使用BP直接抓包获取，或浏览器访问view-source:https://aiqicha.baidu.com获取Cookie" userData="i18n:setting.asset.aiqicha.tooltip"/>
                                                    </tooltip>
                                                </Label>
                                                <TextField fx:id="aiqichaCookie" prefWidth="250">
                                                    <tooltip>
                                                        <Tooltip text="使用BP直接抓包获取，或浏览器访问view-source:https://aiqicha.baidu.com获取Cookie" userData="i18n:setting.asset.aiqicha.tooltip"/>
                                                    </tooltip>
                                                </TextField>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="aiqichaProxy">
                                                    <tooltip>
                                                        <Tooltip text="需要中国IP,建议关闭代理" userData="i18n:setting.asset.aiqicha.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Chinaz_Cookie：" userData="i18n:setting.asset.chinaz"/>
                                                <TextField fx:id="chinazCookie" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="chinazProxy"/>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Fofa_Key：" userData="i18n:setting.asset.fofa"/>
                                                <TextField fx:id="fofaKey" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="fofaProxy"/>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Hunter_Key：" userData="i18n:setting.asset.hunter"/>
                                                <VBox fx:id="hunterVBox" alignment="CENTER_LEFT"  spacing="10">
                                                    <StackPane>
                                                        <TextField styleClass="paddingRightButton" prefWidth="250" StackPane.alignment="CENTER"/>
                                                        <Label alignment="CENTER" translateX="35" styleClass="rightButton" onMouseClicked="#addTextField" StackPane.alignment="CENTER_RIGHT">
                                                            <graphic>
                                                                <Region styleClass="addIcon"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="添加" userData="i18n:tooltip.add"/>
                                                            </tooltip>
                                                        </Label>
                                                    </StackPane>
                                                </VBox>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="hunterProxy">
                                                    <tooltip>
                                                        <Tooltip text="需要中国IP,建议关闭代理" userData="i18n:setting.asset.hunter.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Quake_Key：" userData="i18n:setting.asset.quake"/>
                                                <VBox fx:id="quakeVBox" alignment="CENTER_LEFT"  spacing="10">
                                                    <StackPane>
                                                        <TextField styleClass="paddingRightButton" prefWidth="250" StackPane.alignment="CENTER"/>
                                                        <Label alignment="CENTER" translateX="35" styleClass="rightButton" onMouseClicked="#addTextField" StackPane.alignment="CENTER_RIGHT">
                                                            <graphic>
                                                                <Region styleClass="addIcon"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="添加" userData="i18n:tooltip.add"/>
                                                            </tooltip>
                                                        </Label>
                                                    </StackPane>
                                                </VBox>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="quakeProxy"/>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Shodan_Key：" userData="i18n:setting.asset.shodan"/>
                                                <TextField fx:id="shodanKey" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="shodanProxy"/>
                                            </HBox>
                                            <HBox alignment="CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Zoomeye_Key：" userData="i18n:setting.asset.zoomeye"/>
                                                <TextField fx:id="zoomeyeKey" prefWidth="250"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="zoomeyeProxy">
                                                    <tooltip>
                                                        <Tooltip text="需要国外IP,建议开启代理" userData="i18n:setting.asset.zoomeye.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="Google_API：" userData="i18n:setting.asset.google"/>
                                                <VBox fx:id="googleVBox" alignment="CENTER_LEFT"  spacing="10">
                                                    <StackPane>
                                                        <TextField styleClass="paddingRightButton" promptText="格式为Google_Key:Google_Cx" prefWidth="250" StackPane.alignment="CENTER" userData="i18n-prompt:setting.asset.google.placeholder">
                                                            <tooltip>
                                                                <Tooltip text="格式为Google_Key:Google_Cx" userData="i18n:setting.asset.google.tooltip"/>
                                                            </tooltip>
                                                        </TextField>
                                                        <Label alignment="CENTER" translateX="35" styleClass="rightButton" onMouseClicked="#addTextField" StackPane.alignment="CENTER_RIGHT">
                                                            <graphic>
                                                                <Region styleClass="addIcon"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="添加" userData="i18n:tooltip.add"/>
                                                            </tooltip>
                                                        </Label>
                                                    </StackPane>
                                                </VBox>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="googleProxy">
                                                    <tooltip>
                                                        <Tooltip text="需要国外IP,建议开启代理" userData="i18n:setting.asset.google.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" text="GitHub_Token：" userData="i18n:setting.asset.github"/>
                                                <VBox fx:id="githubVBox" alignment="CENTER_LEFT"  spacing="10">
                                                    <StackPane>
                                                        <TextField styleClass="paddingRightButton" prefWidth="250" StackPane.alignment="CENTER"/>
                                                        <Label alignment="CENTER" translateX="35" styleClass="rightButton" onMouseClicked="#addTextField" StackPane.alignment="CENTER_RIGHT">
                                                            <graphic>
                                                                <Region styleClass="addIcon"/>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="添加" userData="i18n:tooltip.add"/>
                                                            </tooltip>
                                                        </Label>
                                                    </StackPane>
                                                </VBox>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="githubProxy">
                                                    <tooltip>
                                                        <Tooltip text="国外IP更稳定，建议开启代理" userData="i18n:setting.asset.github.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}"/>
                                                <Label minWidth="250" alignment="CENTER" text="通过SSL获取子域" userData="i18n:setting.asset.ssl"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="sslProxy">
                                                    <tooltip>
                                                        <Tooltip text="存在国外平台,建议开启代理" userData="i18n:setting.asset.ssl.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>
                                            <HBox alignment="TOP_CENTER" spacing="10">
                                                <Label minWidth="${newMaxWidthlabel.width}"/>
                                                <Label minWidth="250" alignment="CENTER" text="对网站进行本地深度扫描" userData="i18n:setting.asset.crawl"/>
                                                <Label minWidth="20"/>
                                                <CFSwitch fx:id="crawlProxy">
                                                    <tooltip>
                                                        <Tooltip text="多为中国资产,建议关闭代理" userData="i18n:setting.asset.crawl.proxy.tooltip"/>
                                                    </tooltip>
                                                </CFSwitch>
                                            </HBox>

                                            <HBox alignment="CENTER">
                                                <Button minHeight="38.0" minWidth="150" text="保存" userData="i18n:app.save" onAction="#saveAsset">
                                                    <effect>
                                                        <DropShadow />
                                                    </effect>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </TitledPane>

                                    <!-- 漏洞扫描配置 -->
                                    <TitledPane fx:id="vulnScanPane" text="漏洞扫描配置" userData="i18n:setting.vulnscan.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="15" style="-fx-padding: 15;">
                                            
                                            <!-- 性能配置区 -->
                                            <VBox spacing="8" style="-fx-background-color: -main-topBar-color; -fx-background-radius: 8; -fx-padding: 12;">
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <Region prefWidth="16" prefHeight="16" maxWidth="16" maxHeight="16" style="-fx-shape: 'M11.11 23.569a1.2 1.2 0 0 1-.447-.087 1.19 1.19 0 0 1-.741-1.074l-.545-7.569H3.2a1.2 1.2 0 0 1-1.056-1.776l8.4-15.6a1.2 1.2 0 0 1 2.244.696l-.545 7.569h6.157a1.2 1.2 0 0 1 1.056 1.776l-8.4 15.6a1.2 1.2 0 0 1-.946.465z'; -fx-background-color: -main-border-color;"/>
                                                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -main-border-color;"
                                                          text="性能配置" userData="i18n:setting.vulnscan.performance"/>
                                                </HBox>
                                                <FlowPane hgap="25" vgap="12" alignment="CENTER_LEFT">
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="核心线程:" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.core.threads"/>
                                                        <TextField fx:id="vulnScanCoreThreads" prefWidth="70" promptText="10" style="-fx-font-size: 12px;">
                                                            <tooltip><Tooltip text="并发扫描的基础线程数 (建议: 2-20)" userData="i18n:setting.vulnscan.core.threads.tip"/></tooltip>
                                                        </TextField>
                                                    </HBox>
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="最大线程:" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.max.threads"/>
                                                        <TextField fx:id="vulnScanMaxThreads" prefWidth="70" promptText="50" style="-fx-font-size: 12px;">
                                                            <tooltip><Tooltip text="高负载时的最大线程数 (建议: 10-100)" userData="i18n:setting.vulnscan.max.threads.tip"/></tooltip>
                                                        </TextField>
                                                    </HBox>
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="队列容量:" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.queue.size"/>
                                                        <TextField fx:id="vulnScanQueueSize" prefWidth="80" promptText="1000" style="-fx-font-size: 12px;">
                                                            <tooltip><Tooltip text="等待执行的任务队列大小" userData="i18n:setting.vulnscan.queue.size.tip"/></tooltip>
                                                        </TextField>
                                                    </HBox>
                                                </FlowPane>
                                            </VBox>
                                            
                                            <!-- 网络配置区 -->
                                            <VBox spacing="8" style="-fx-background-color: -main-topBar-color; -fx-background-radius: 8; -fx-padding: 12;">
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <Region prefWidth="16" prefHeight="16" maxWidth="16" maxHeight="16" style="-fx-shape: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z'; -fx-background-color: -main-border-color;"/>
                                                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -main-border-color;"
                                                          text="网络配置" userData="i18n:setting.vulnscan.network"/>
                                                </HBox>
                                                <FlowPane hgap="25" vgap="12" alignment="CENTER_LEFT">
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="超时(秒):" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.timeout"/>
                                                        <TextField fx:id="vulnScanTimeout" prefWidth="60" promptText="15" style="-fx-font-size: 12px;">
                                                            <tooltip><Tooltip text="HTTP请求超时时间" userData="i18n:setting.vulnscan.timeout.tip"/></tooltip>
                                                        </TextField>
                                                    </HBox>
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="重试次数:" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.retries"/>
                                                        <TextField fx:id="vulnScanRetries" prefWidth="50" promptText="2" style="-fx-font-size: 12px;">
                                                            <tooltip><Tooltip text="请求失败后的重试次数" userData="i18n:setting.vulnscan.retries.tip"/></tooltip>
                                                        </TextField>
                                                    </HBox>
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="使用代理:" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.proxy"/>
                                                        <CFSwitch fx:id="vulnScanProxySwitch">
                                                            <tooltip><Tooltip text="需先启用主代理，开启后将使用全局代理进行扫描" userData="i18n:setting.vulnscan.proxy.tip"/></tooltip>
                                                        </CFSwitch>
                                                    </HBox>
                                                </FlowPane>
                                            </VBox>
                                            
                                            <!-- 报告配置区 -->
                                            <VBox spacing="8" style="-fx-background-color: -main-topBar-color; -fx-background-radius: 8; -fx-padding: 12;">
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <Region prefWidth="16" prefHeight="16" maxWidth="16" maxHeight="16" style="-fx-shape: 'M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z'; -fx-background-color: -main-border-color;"/>
                                                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -main-border-color;"
                                                          text="报告配置" userData="i18n:setting.vulnscan.report"/>
                                                </HBox>
                                                <FlowPane hgap="25" vgap="12" alignment="CENTER_LEFT">
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="输出目录:" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.report.dir"/>
                                                        <TextField fx:id="vulnScanReportDir" prefWidth="150" promptText="reports" style="-fx-font-size: 12px;">
                                                            <tooltip><Tooltip text="扫描报告的保存目录" userData="i18n:setting.vulnscan.report.dir.tip"/></tooltip>
                                                        </TextField>
                                                    </HBox>
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="导出格式:" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.report.format"/>
                                                        <ComboBox fx:id="vulnScanReportFormat" prefWidth="90" style="-fx-font-size: 12px;">
                                                            <items>
                                                                <FXCollections fx:factory="observableArrayList">
                                                                    <String fx:value="HTML" />
                                                                    <String fx:value="JSON" />
                                                                    <String fx:value="CSV" />
                                                                    <String fx:value="Excel" />
                                                                </FXCollections>
                                                            </items>
                                                        </ComboBox>
                                                    </HBox>
                                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                                        <Label text="自动导出:" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.auto.export"/>
                                                        <CFSwitch fx:id="vulnScanAutoExport">
                                                            <tooltip><Tooltip text="扫描完成后自动生成报告" userData="i18n:setting.vulnscan.auto.export.tip"/></tooltip>
                                                        </CFSwitch>
                                                    </HBox>
                                                </FlowPane>
                                            </VBox>
                                            
                                            <!-- 操作按钮 -->
                                            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 5 0 0 0;">
                                                <Button minHeight="32" minWidth="100" text="恢复默认" onAction="#resetVulnScanDefaults" style="-fx-font-size: 12px;" userData="i18n:setting.vulnscan.reset">
                                                    <tooltip><Tooltip text="将所有配置恢复为默认值" userData="i18n:setting.vulnscan.reset.tip"/></tooltip>
                                                    <effect><DropShadow color="#00000020" radius="3" offsetY="1"/></effect>
                                                </Button>
                                                <Button minHeight="32" minWidth="100" text="保存配置" userData="i18n:app.save" onAction="#saveVulnScan" style="-fx-font-size: 12px; -fx-base: -main-border-color;">
                                                    <effect><DropShadow color="#00000030" radius="3" offsetY="1"/></effect>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </TitledPane>
                                    
                                    <!-- HTTP Headers 管理 -->
                                    <TitledPane fx:id="headerPane" text="HTTP Headers 管理" userData="i18n:setting.headers.title">
                                        <VBox styleClass="contentCell" alignment="CENTER" spacing="15" style="-fx-padding: 15;">

                                            <!-- Header模板 -->
                                            <VBox spacing="8" style="-fx-background-color: -main-topBar-color; -fx-background-radius: 8; -fx-padding: 12;">
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <Region prefWidth="16" prefHeight="16" maxWidth="16" maxHeight="16" style="-fx-shape: 'M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z'; -fx-background-color: -main-border-color;"/>
                                                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -main-border-color;"
                                                          text="Header 模板" userData="i18n:setting.headers.template"/>
                                                </HBox>
                                                <FlowPane fx:id="headerTemplatePane" hgap="10" vgap="8">
                                                </FlowPane>
                                            </VBox>

                                            <!-- Headers 编辑区 -->
                                            <VBox spacing="8" style="-fx-background-color: -main-topBar-color; -fx-background-radius: 8; -fx-padding: 12;">
                                                <HBox alignment="CENTER_LEFT" spacing="8">
                                                    <Region prefWidth="16" prefHeight="16" maxWidth="16" maxHeight="16" style="-fx-shape: 'M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z'; -fx-background-color: -main-border-color;"/>
                                                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -main-border-color;"
                                                          text="Headers 配置（全局生效）" userData="i18n:setting.headers.edit"/>
                                                </HBox>
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;"
                                                      text="提示：如果自定义了 User-Agent 则会覆盖随机UA；此处配置对所有HTTP请求全局生效" userData="i18n:setting.headers.edit.tip"/>
                                                <SmoothTextArea fx:id="defaultHeadersArea" prefHeight="120" promptText="Accept: */*&#10;Accept-Language: zh-CN,zh;q=0.9,en;q=0.8&#10;User-Agent: 自定义UA（可选，会覆盖随机UA）"
                                                          style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px;">
                                                    <tooltip><Tooltip text="每行一个Header，格式: Header-Name: Header-Value" userData="i18n:setting.headers.default.tip"/></tooltip>
                                                </SmoothTextArea>
                                            </VBox>

                                            <!-- 操作按钮 -->
                                            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 5 0 0 0;">
                                                <Button minHeight="32" minWidth="100" text="重置为默认" onAction="#resetHeaders" style="-fx-font-size: 12px;" userData="i18n:setting.headers.reset">
                                                    <effect><DropShadow color="#00000020" radius="3" offsetY="1"/></effect>
                                                </Button>
                                                <Button minHeight="32" minWidth="100" text="保存" onAction="#saveHeaders" style="-fx-font-size: 12px; -fx-base: -main-border-color;" userData="i18n:setting.headers.save">
                                                    <effect><DropShadow color="#00000030" radius="3" offsetY="1"/></effect>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </TitledPane>

                                    <!-- 在线更新 -->
                                    <TitledPane fx:id="updatePane" text="在线更新" userData="i18n:setting.update.title">
                                        <VBox styleClass="contentCellLast" alignment="CENTER" spacing="20" style="-fx-padding: 15;">
                                            <!-- 更新设置 -->
                                            <VBox spacing="10" alignment="CENTER_LEFT">
                                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" 
                                                      text="更新设置" userData="i18n:update.settings.title"/>
                                                
                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" 
                                                          text="启动时自动检查更新：" 
                                                          userData="i18n:update.settings.auto.check"/>
                                                    <CFSwitch fx:id="autoCheckUpdateSwitch">
                                                        <tooltip>
                                                            <Tooltip text="关闭后将不会在启动时自动检查更新，但仍可手动检查" 
                                                                    userData="i18n:update.settings.auto.check.tip"/>
                                                        </tooltip>
                                                    </CFSwitch>
                                                    <HBox prefWidth="125"></HBox>
                                                    <Button fx:id="saveUpdateSettingsButton"
                                                           text="保存"
                                                           userData="i18n:app.save"
                                                           onAction="#saveUpdateSettings" 
                                                           minWidth="80" 
                                                           prefHeight="30"
                                                           styleClass="checkButton">
                                                        <tooltip>
                                                            <Tooltip text="保存更新设置" 
                                                                    userData="i18n:update.settings.save.tip"/>
                                                        </tooltip>
                                                        <effect>
                                                            <DropShadow />
                                                        </effect>
                                                    </Button>
                                                </HBox>
                                            </VBox>
                                            
                                            <!-- 分隔线 -->
                                            <Separator prefWidth="${an.width - 58}"/>
                                            
                                            <!-- 存储位置管理 -->
                                            <VBox spacing="15" alignment="CENTER_LEFT">
                                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" 
                                                      text="存储位置管理" userData="i18n:update.storage.title"/>
                                                
                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" 
                                                          text="配置文件位置（不可修改）：" 
                                                          userData="i18n:update.storage.config.path"/>
                                                    <Label fx:id="configPathLabel" style="-fx-text-fill: gray;"/>
                                                </HBox>
                                                
                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" 
                                                          text="资源文件位置：" 
                                                          userData="i18n:update.storage.resource.path"/>
                                                    <TextField fx:id="resourcePathField" prefWidth="350" editable="false"/>
                                                    <Button text="浏览..." userData="i18n:update.storage.button.browse" 
                                                           onAction="#browseResourcePath" minWidth="80" minHeight="25">
                                                        <effect><DropShadow /></effect>
                                                    </Button>
                                                </HBox>
                                                
                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" 
                                                          text="当前占用空间：" 
                                                          userData="i18n:update.storage.current.size"/>
                                                    <Label fx:id="currentSizeLabel" text="计算中..."/>
                                                </HBox>
                                                
                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <Label minWidth="${newMaxWidthlabel.width}" textAlignment="RIGHT" 
                                                          text="可用空间：" 
                                                          userData="i18n:update.storage.available.size"/>
                                                    <Label fx:id="availableSizeLabel" text="计算中..."/>
                                                </HBox>
                                                
                                                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
                                                    <Button text="迁移资源文件" userData="i18n:update.storage.button.migrate" 
                                                           fx:id="migrateButton"
                                                           onAction="#migrateResources" minWidth="120" minHeight="30">
                                                        <effect><DropShadow /></effect>
                                                    </Button>
                                                    <Button text="恢复默认位置" userData="i18n:update.storage.button.reset" 
                                                           fx:id="resetPathButton"
                                                           onAction="#resetResourcePath" minWidth="120" minHeight="30">
                                                        <effect><DropShadow /></effect>
                                                    </Button>
                                                    <Button text="检查软件更新" 
                                                           fx:id="checkAppUpdateButton"
                                                           onAction="#checkAppUpdate" minWidth="120" minHeight="30">
                                                        <effect><DropShadow /></effect>
                                                    </Button>
                                                </HBox>
                                            </VBox>
                                        </VBox>
                                    </TitledPane>
                                </panes>
                            </Accordion>
                        </VBox>
                    </VBox>
                </SmoothScrollPane>
            </VBox>
            <StackPane fx:id="promptPane" visible="false" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" alignment="CENTER" StackPane.alignment="CENTER">
                <Label fx:id="prompt" maxWidth="600"/>
            </StackPane>
        </StackPane>
    </children>

</AnchorPane>
