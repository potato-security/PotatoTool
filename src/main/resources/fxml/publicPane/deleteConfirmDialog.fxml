<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane xmlns="http://javafx.com/javafx/"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.potato.potatotool.controller.publicPane.PaneDeleteConfirmDialog"
            fx:id="an"
            stylesheets="@../../css/common.css"
            style="-fx-background-color: transparent;"
            onMouseDragged="#topBarDraggedAction"
            onMousePressed="#topBarPressedAction"
            prefWidth="380"
            prefHeight="430"
>
    <children>
    <Pane fx:id="outerBorderPane" layoutX="9.0" layoutY="9.0">
    <effect>
        <DropShadow/>
    </effect>
    <VBox>
    <BorderPane fx:id="topBar" style="-fx-background-color: -main-btnContent-color;" prefHeight="45" prefWidth="${an.width - 18}" BorderPane.alignment="CENTER">
        <center>
            <Label style="-fx-padding: 0 0 0 30;-fx-font-size: 23;-fx-font-weight: bold;" alignment="CENTER" prefHeight="${topBar.height}" prefWidth="${topBar.width}" text="删除确认" userData="i18n:delete.title" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        </center>
        <right>
            <HBox alignment="CENTER"  fx:id="appController" prefHeight="${topBar.height}">
                <Button id="btnExitSmall" mnemonicParsing="false" onAction="#exitAction" prefHeight="25.0" prefWidth="25.0">
                    <graphic>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../img/close.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="关闭" userData="i18n:tooltip.close"/>
                    </tooltip>
                </Button>
                <Pane minWidth="10"/>
            </HBox>
        </right>
    </BorderPane>
    <VBox alignment="CENTER" spacing="25" prefWidth="${an.width - 18}" prefHeight="235" style="-fx-padding: 30;-fx-background-color: -main-topBar-color;-fx-background-radius: 0 0 4 4;">
        <VBox alignment="CENTER" spacing="15">
            <!-- 警告图标 -->
            <Label style="-fx-font-size: 48; -fx-text-fill: #e74c3c;">⚠</Label>
            
            <!-- 确认信息 -->
            <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="您确定要删除以下模块吗？" userData="i18n:delete.confirm"/>
            
            <!-- 显示要删除的项目信息 -->
            <VBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 15; -fx-background-color: -main-cell-color; -fx-background-radius: 5;">
                <HBox spacing="10">
                    <Label style="-fx-font-weight: bold; -fx-min-width: 60;" text="名称：" userData="i18n:delete.name"/>
                    <Label fx:id="titleLabel" style="-fx-text-fill: -main-font-color;"/>
                </HBox>
                <HBox spacing="10">
                    <Label style="-fx-font-weight: bold; -fx-min-width: 60;" text="描述：" userData="i18n:delete.description"/>
                    <Label fx:id="describeLabel" style="-fx-text-fill: -main-font-color;"/>
                </HBox>
            </VBox>
            
            <Label style="-fx-font-size: 13; -fx-text-fill: #95a5a6;" text="此操作无法撤销，请谨慎操作！" userData="i18n:delete.warning"/>
        </VBox>

        <!-- 按钮区域 -->
        <HBox alignment="CENTER" spacing="20">
            <Button minHeight="40.0" minWidth="120" text="取消" userData="i18n:app.cancel" onAction="#exitAction" style="-fx-background-color: #95a5a6;">
                <effect>
                    <DropShadow />
                </effect>
            </Button>
            <Button fx:id="deleteBtn" minHeight="40.0" minWidth="120" text="确认删除" userData="i18n:delete.confirm.button" onAction="#confirmDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white;">
                <effect>
                    <DropShadow />
                </effect>
            </Button>
        </HBox>

    </VBox>
    </VBox>
    </Pane>
    </children>

</AnchorPane>

