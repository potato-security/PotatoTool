<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane xmlns="http://javafx.com/javafx/"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.potato.potatotool.controller.publicPane.PaneDeleteConfirmDialog"
            fx:id="an"
            stylesheets="@../../css/common.css, @../../css/deleteConfirm.css"
            style="-fx-background-color: transparent;"
            onMouseDragged="#topBarDraggedAction"
            onMousePressed="#topBarPressedAction"
            prefWidth="400"
            prefHeight="310">

    <Pane fx:id="outerBorderPane" layoutX="9.0" layoutY="9.0">
        <effect><DropShadow/></effect>
        <VBox>
            <!-- Title bar -->
            <BorderPane fx:id="topBar" styleClass="del-topbar"
                        prefHeight="45" prefWidth="${an.width - 18}">
                <center>
                    <Label styleClass="pt-h2,del-title" alignment="CENTER"
                           prefHeight="${topBar.height}" prefWidth="${topBar.width}"
                           text="危险操作确认" userData="i18n:delete.title"/>
                </center>
                <right>
                    <HBox alignment="CENTER" prefHeight="${topBar.height}">
                        <Button styleClass="del-close-btn" mnemonicParsing="false" onAction="#exitAction"
                                prefHeight="25.0" prefWidth="25.0" text="✕"/>
                        <Pane minWidth="10"/>
                    </HBox>
                </right>
            </BorderPane>

            <!-- Content area -->
            <VBox alignment="CENTER" spacing="16" prefWidth="${an.width - 18}"
                  styleClass="del-body" style="-fx-padding: 28 32 24 32;">

                <!-- Warning row -->
                <HBox alignment="CENTER" spacing="10">
                    <Label styleClass="del-warn-icon" text="⚠"/>
                    <Label styleClass="pt-caption,del-warn-text"
                           text="此操作不可撤销" userData="i18n:delete.warning"/>
                </HBox>

                <!-- Item title (dynamic) -->
                <Label fx:id="titleLabel" styleClass="pt-h2,del-item-title"
                       maxWidth="Infinity" alignment="CENTER"/>

                <!-- Item description (dynamic) -->
                <Label fx:id="describeLabel" styleClass="pt-caption,del-item-desc"
                       wrapText="true" maxWidth="Infinity" alignment="CENTER"/>

                <!-- Buttons -->
                <HBox alignment="CENTER" spacing="16" style="-fx-padding: 8 0 0 0;">
                    <Button styleClass="pt-btn,del-cancel-btn" minHeight="40" minWidth="120"
                            text="取消" userData="i18n:app.cancel" onAction="#exitAction"/>
                    <Button fx:id="deleteBtn" styleClass="pt-btn-danger,del-confirm-btn"
                            minHeight="40" minWidth="120"
                            text="确认删除" userData="i18n:delete.confirm.button"
                            onAction="#confirmDelete"/>
                </HBox>

            </VBox>
        </VBox>
    </Pane>

</AnchorPane>
