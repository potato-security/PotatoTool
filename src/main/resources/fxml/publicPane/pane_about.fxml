<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/about.css"
           fx:controller="com.potato.potatotool.controller.publicPane.PaneAbout"
           fx:id="sPane"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <SmoothScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                      prefHeight="${sPane.height}" prefWidth="${sPane.width}">
        <VBox fx:id="contentVBox" styleClass="about-content" spacing="20" style="-fx-padding: 20 28 28 28;">

            <!-- 版本信息条 -->
            <HBox styleClass="about-info-bar" alignment="CENTER_LEFT" spacing="0">
                <VBox styleClass="about-bar-cell" alignment="CENTER" spacing="2">
                    <Label text="VERSION" styleClass="about-bar-key"/>
                    <Label fx:id="versionLabel" text="v8.0.0" styleClass="about-bar-value"/>
                </VBox>
                <Region styleClass="about-bar-sep"/>
                <VBox styleClass="about-bar-cell" alignment="CENTER" spacing="2">
                    <Label text="BUILD" styleClass="about-bar-key"/>
                    <Label fx:id="buildLabel" text="—" styleClass="about-bar-value"/>
                </VBox>
                <Region styleClass="about-bar-sep"/>
                <VBox styleClass="about-bar-cell" alignment="CENTER" spacing="2">
                    <Label text="CHANNEL" styleClass="about-bar-key"/>
                    <Label fx:id="channelLabel" text="stable" styleClass="about-bar-value"/>
                </VBox>
                <Region styleClass="about-bar-sep"/>
                <VBox styleClass="about-bar-cell" alignment="CENTER" spacing="2">
                    <Label text="LICENSE" styleClass="about-bar-key"/>
                    <Label text="MIT" styleClass="about-bar-value"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="checkUpdateBtn" styleClass="pt-btn" text="检查更新"
                        userData="i18n:about.check.update" onAction="#checkUpdate" minHeight="30" minWidth="90">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </HBox>

            <!-- 页面标题 -->
            <VBox spacing="4">
                <Label text="关于" styleClass="about-page-title" userData="i18n:about.title"/>
                <Label text="系统身份与维护信息 · 版本 / 许可 / 反馈渠道" styleClass="pt-caption"
                       userData="i18n:about.subtitle"/>
            </VBox>

            <!-- 品牌卡片 -->
            <HBox styleClass="about-brand-card" alignment="CENTER_LEFT" spacing="20">
                <StackPane styleClass="about-pt-logo" alignment="CENTER" minWidth="72" maxWidth="72"
                           minHeight="72" maxHeight="72">
                    <Label text="PT" styleClass="about-pt-logo-text"/>
                </StackPane>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="PotatoTool" styleClass="about-brand-name"/>
                    <Label text="RED &amp; BLUE SECURITY TOOLKIT" styleClass="about-brand-subtitle"/>
                    <Label fx:id="buildInfoLabel" text="v8.0.0 · build —" styleClass="pt-caption"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" spacing="8">
                    <Label fx:id="updateStatusChip" text="已是最新" styleClass="about-status-chip-latest"
                           userData="i18n:about.status.latest"/>
                    <Label text="MIT LICENSE" styleClass="about-license-badge"/>
                </VBox>
            </HBox>

            <!-- 信息面板行 -->
            <HBox spacing="16">
                <!-- 基本信息 -->
                <VBox styleClass="about-panel" HBox.hgrow="ALWAYS" spacing="0">
                    <HBox styleClass="about-panel-header" alignment="CENTER_LEFT" spacing="8">
                        <Label text="BASIC" styleClass="about-panel-tag"/>
                        <Label text="基本信息" styleClass="about-panel-title" userData="i18n:about.basic.title"/>
                    </HBox>
                    <HBox styleClass="about-info-row" alignment="CENTER_LEFT">
                        <Label text="作者" styleClass="about-info-key" userData="i18n:about.basic.author" minWidth="72"/>
                        <Label text="HotBoy" styleClass="about-info-value"/>
                    </HBox>
                    <HBox styleClass="about-info-row" alignment="CENTER_LEFT">
                        <Label text="许可" styleClass="about-info-key" userData="i18n:about.basic.license" minWidth="72"/>
                        <Label text="MIT" styleClass="about-info-value"/>
                    </HBox>
                    <HBox styleClass="about-info-row" alignment="CENTER_LEFT">
                        <Label text="官网" styleClass="about-info-key" userData="i18n:about.basic.site" minWidth="72"/>
                        <Hyperlink text="HotBoy-java/PotatoTool" onAction="#openGitHub" styleClass="about-info-link">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Hyperlink>
                    </HBox>
                    <HBox styleClass="about-info-row" alignment="CENTER_LEFT">
                        <Label text="更新通道" styleClass="about-info-key" userData="i18n:about.basic.channel" minWidth="72"/>
                        <Label fx:id="channelInfoLabel" text="stable" styleClass="about-info-value"/>
                    </HBox>
                </VBox>

                <!-- 运行环境 -->
                <VBox styleClass="about-panel" HBox.hgrow="ALWAYS" spacing="0">
                    <HBox styleClass="about-panel-header" alignment="CENTER_LEFT" spacing="8">
                        <Label text="RUNTIME" styleClass="about-panel-tag"/>
                        <Label text="运行环境" styleClass="about-panel-title" userData="i18n:about.runtime.title"/>
                    </HBox>
                    <HBox styleClass="about-info-row" alignment="CENTER_LEFT">
                        <Label text="平台" styleClass="about-info-key" userData="i18n:about.runtime.platform" minWidth="72"/>
                        <Label fx:id="platformLabel" text="—" styleClass="about-info-value"/>
                    </HBox>
                    <HBox styleClass="about-info-row" alignment="CENTER_LEFT">
                        <Label text="JDK" styleClass="about-info-key" userData="i18n:about.runtime.jdk" minWidth="72"/>
                        <Label fx:id="jdkLabel" text="—" styleClass="about-info-value"/>
                    </HBox>
                    <HBox styleClass="about-info-row" alignment="CENTER_LEFT">
                        <Label text="内核" styleClass="about-info-key" userData="i18n:about.runtime.kernel" minWidth="72"/>
                        <Label text="JavaFX" styleClass="about-info-value"/>
                    </HBox>
                    <HBox styleClass="about-info-row" alignment="CENTER_LEFT">
                        <Label text="数据目录" styleClass="about-info-key" userData="i18n:about.runtime.datadir" minWidth="72"/>
                        <Label fx:id="dataPathLabel" text="~/.potatotool" styleClass="about-info-value" wrapText="true"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- 反馈与社区 -->
            <VBox styleClass="about-panel" spacing="12">
                <HBox styleClass="about-panel-header" alignment="CENTER_LEFT" spacing="8">
                    <Label text="FEEDBACK" styleClass="about-panel-tag"/>
                    <Label text="反馈与社区" styleClass="about-panel-title" userData="i18n:about.feedback.title"/>
                </HBox>
                <Label text="通过以下渠道反馈问题、获取文档或加入社区交流。" styleClass="pt-caption"
                       userData="i18n:about.feedback.desc" wrapText="true"/>
                <Label text="CHANNELS" styleClass="about-panel-tag" style="-fx-padding: 4 0 0 0;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button styleClass="pt-btn" text="GitHub Issues" onAction="#openGitHubIssues" minHeight="30">
                        <cursor><Cursor fx:constant="HAND"/></cursor>
                    </Button>
                    <Button styleClass="pt-btn" text="官方文档" userData="i18n:about.feedback.docs"
                            onAction="#openDocs" minHeight="30">
                        <cursor><Cursor fx:constant="HAND"/></cursor>
                    </Button>
                    <Button styleClass="pt-btn" text="QQ 群" userData="i18n:about.feedback.qq"
                            onAction="#openQQGroup" minHeight="30">
                        <cursor><Cursor fx:constant="HAND"/></cursor>
                    </Button>
                    <Button styleClass="pt-btn" text="Telegram" onAction="#openTelegram" minHeight="30">
                        <cursor><Cursor fx:constant="HAND"/></cursor>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button styleClass="pt-btn-primary" text="提交反馈" userData="i18n:about.feedback.submit"
                            onAction="#openGitHubIssues" minHeight="30" minWidth="88">
                        <cursor><Cursor fx:constant="HAND"/></cursor>
                    </Button>
                </HBox>
            </VBox>

        </VBox>
    </SmoothScrollPane>

</StackPane>
