<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Accordion?>
<?import com.potato.potatotool.utils.ui.SmoothListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/extension.css"
           fx:controller="com.potato.potatotool.controller.publicPane.PaneExtension"
           fx:id="sPane"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <BorderPane>

        <left>
            <SmoothScrollPane maxHeight="${sPane.height - 10}" hbarPolicy="NEVER">
                <VBox fx:id="vBoxBar">
                    <Accordion fx:id="accordionPane"/>
                </VBox>
            </SmoothScrollPane>
        </left>

        <right>
            <SmoothListView fx:id="listView" prefWidth="${sPane.width - 210}" maxHeight="${sPane.height - 10}" />
        </right>
    </BorderPane>

    <StackPane fx:id="promptPane" visible="false" managed="false" translateY="-25" maxHeight="-Infinity" maxWidth="-Infinity" alignment="CENTER" StackPane.alignment="CENTER">
        <effect>
            <DropShadow/>
        </effect>
        <Label fx:id="prompt" wrapText="true" textAlignment="CENTER" alignment="CENTER" maxWidth="600"/>
    </StackPane>

</StackPane>
