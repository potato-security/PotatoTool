<?xml version="1.0" encoding="UTF-8"?>
<?import com.dlsc.gemsfx.CFCheckBox?>
<?import com.leewyatt.rxcontrols.controls.RXPasswordField?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<AnchorPane fx:id="an"
            onMouseDragged="#topBarDraggedAction"
            onMousePressed="#topBarPressedAction"
            maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="268"
            prefWidth="380"
            style="-fx-background-color: transparent"
            xmlns="http://javafx.com/javafx/"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../../css/common.css, @../../css/components.css, @../../css/passwd.css"
            fx:controller="com.potato.potatotool.controller.publicPane.PanePasswd">
    <StackPane AnchorPane.topAnchor="4" AnchorPane.bottomAnchor="4"
               AnchorPane.leftAnchor="4" AnchorPane.rightAnchor="4">
    <VBox styleClass="passwd-card" spacing="0" StackPane.alignment="CENTER">
        <effect>
            <DropShadow color="#000000" radius="28" spread="0.08"/>
        </effect>

        <!-- 标题行 -->
        <BorderPane fx:id="topBar" styleClass="passwd-header">
            <left>
                <Label text="启动验证" styleClass="passwd-title" userData="i18n:passwd.dialog.title"/>
            </left>
            <right>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="关闭即退出应用" styleClass="passwd-exit-hint" userData="i18n:passwd.exit.hint"/>
                    <Button id="passwdCloseBtn" onAction="#exitAction" text="✕" styleClass="passwd-close-btn">
                        <cursor>
                            <Cursor fx:constant="HAND"/>
                        </cursor>
                    </Button>
                </HBox>
            </right>
        </BorderPane>

        <Region styleClass="passwd-divider"/>

        <!-- 内容 -->
        <VBox spacing="12" styleClass="passwd-content">
            <Label text="启动密码" styleClass="pt-caption" userData="i18n:passwd.label"/>
            <RXPasswordField fx:id="passwd" styleClass="pt-input" buttonDisplayMode="AUTO"
                             promptText="请输入密码……" userData="i18n-prompt:passwd.placeholder"
                             maxWidth="Infinity"/>
            <CFCheckBox fx:id="checkBox" mnemonicParsing="false" selected="false"
                        text="记住密码" userData="i18n:passwd.remember"/>
            <Button fx:id="startButton" styleClass="pt-btn-primary" minHeight="42" maxWidth="Infinity"
                    text="启 动" userData="i18n:passwd.start" onAction="#start">
                <cursor>
                    <Cursor fx:constant="HAND"/>
                </cursor>
            </Button>
            <Label fx:id="tipTitle" styleClass="passwd-error-label" maxWidth="Infinity" alignment="CENTER"/>
        </VBox>

    </VBox>
        <!-- 四角取景框叠加在最上层，translate 留出呼吸空间 -->
        <Region styleClass="pt-corner-tl" mouseTransparent="true" StackPane.alignment="TOP_LEFT" translateX="4" translateY="4"/>
        <Region styleClass="pt-corner-tr" mouseTransparent="true" StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
        <Region styleClass="pt-corner-bl" mouseTransparent="true" StackPane.alignment="BOTTOM_LEFT" translateX="4" translateY="-4"/>
        <Region styleClass="pt-corner-br" mouseTransparent="true" StackPane.alignment="BOTTOM_RIGHT" translateX="-4" translateY="-4"/>
    </StackPane>
</AnchorPane>
