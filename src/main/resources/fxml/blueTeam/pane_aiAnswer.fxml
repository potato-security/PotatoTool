<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/aiAnswer.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.blueTeam.PaneAiAnswer"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <VBox fx:id="rootContainer" spacing="18" styleClass="ai-answer-root">
        <StackPane alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
            <VBox fx:id="chatColumn" spacing="16" maxWidth="780" fillWidth="true">
                <SmoothScrollPane fx:id="scrollPane"
                                  fitToWidth="true"
                                  vvalue="1.0"
                                  hbarPolicy="NEVER"
                                  styleClass="ai-chat-scroll"
                                  VBox.vgrow="ALWAYS">
                    <StackPane alignment="TOP_CENTER">
                        <VBox spacing="20" fx:id="msgBox" maxWidth="760" fillWidth="true"/>
                    </StackPane>
                </SmoothScrollPane>
            </VBox>
        </StackPane>

        <StackPane alignment="CENTER">
            <StackPane fx:id="composerCard" maxWidth="780" styleClass="ai-composer-card">
                <VBox spacing="10" maxWidth="748" fillWidth="true">
                    <FlowPane fx:id="attachmentPreviewPane"
                              hgap="8"
                              vgap="8"
                              visible="false"
                              managed="false"
                              styleClass="ai-attachment-pane"/>

                    <HBox fx:id="attachmentBar" spacing="8" alignment="CENTER_LEFT" styleClass="ai-composer-footer">
                        <Button fx:id="attachButton" onAction="#toggleComposerMenu" styleClass="ai-plus-button">
                            <graphic>
                                <SVGPath content="M6 1.5h2v4.5h4.5v2H8v4.5H6V8H1.5V6H6z"
                                         styleClass="ai-plus-button-glyph"/>
                            </graphic>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <SmoothTextArea fx:id="question"
                                        wrapText="true"
                                        prefHeight="44"
                                        minHeight="44"
                                        maxHeight="220"
                                        HBox.hgrow="ALWAYS"
                                        promptText="输入分析目标，或直接粘贴文件后提问"
                                        userData="i18n-prompt:ai.input.prompt"/>

                        <Button fx:id="sendAction" onAction="#handlePrimaryAction" styleClass="ai-send-button">
                            <graphic>
                                <Region fx:id="sendActionIcon" styleClass="send"/>
                            </graphic>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </HBox>

                    <HBox fx:id="composerMetaRow"
                          spacing="8"
                          alignment="CENTER_LEFT"
                          visible="false"
                          managed="false"
                          styleClass="ai-composer-meta-row">
                        <Label fx:id="thinkingBadge"
                               text="思考"
                               userData="i18n:ai.thinking.badge"
                               visible="false"
                               managed="false"
                               styleClass="ai-thinking-badge"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Hyperlink fx:id="clearAttachmentLink"
                                   text="清空附件"
                                   userData="i18n:ai.attach.clear"
                                   visible="false"
                                   managed="false"
                                   onAction="#clearAttachments"
                                   styleClass="ai-clear-link"/>
                        <Label fx:id="statusLabel" text="" visible="false" managed="false"/>
                        <Hyperlink fx:id="retryLink"
                                   text="重试"
                                   visible="false"
                                   managed="false"
                                   onAction="#retryLastQuestion"
                                   userData="i18n:common.retry"/>
                    </HBox>
                </VBox>

                <VBox fx:id="dropHintBox"
                      visible="false"
                      managed="false"
                      mouseTransparent="true"
                      spacing="6"
                      alignment="CENTER"
                      styleClass="ai-drop-overlay">
                    <Label fx:id="dropHintTitle" text="拖拽文件到这里" userData="i18n:ai.attach.drop.title" styleClass="pt-h2"/>
                    <Label fx:id="dropHintText" text="松手即可把文件加入当前消息，最多 5 个文件" userData="i18n:ai.attach.drop.desc" styleClass="pt-caption"/>
                </VBox>
            </StackPane>
        </StackPane>
    </VBox>

</StackPane>
