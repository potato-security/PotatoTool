<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothListView?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Cursor?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/exif.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.blueTeam.PaneExif"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <VBox fx:id="paneBox" alignment="CENTER" spacing="16" style="-fx-padding: 18 20 20 20;">

        <!-- SOURCE FILE 卡片 (对齐 Penpot: 标题 + 选择按钮 + 支持格式提示) -->
        <VBox styleClass="exif-source" spacing="10" alignment="CENTER" maxWidth="Infinity">
            <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                <Label text="SOURCE FILE" styleClass="pt-section-label" userData="i18n:exif.source.title"/>
            </HBox>
            <Button prefHeight="44.0" prefWidth="240" styleClass="pt-btn-primary" text="选择文件" userData="i18n:exif.selectfile" onAction="#getExifFx">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>
            <Label text="不支持拖拽 · JPG / PNG / TIFF / HEIC / RAW" styleClass="pt-caption" userData="i18n:exif.formats"/>
        </VBox>

        <SmoothListView fx:id="listView"  prefWidth="${sPane.width - 20}" prefHeight="${sPane.height - 200}">
            <HBox prefHeight="${sPane.height - 220}"  alignment="CENTER">
                <Label id="tipTitle" text="请上传需要获取元信息的文件……" userData="i18n:exif.tip"/>
            </HBox>
        </SmoothListView>

    </VBox>

    <!-- Right EXIF summary panel (slides in from right) -->
    <SmoothScrollPane fx:id="exifPanelScrollPane"
                      maxHeight="${sPane.height}" maxWidth="200"
                      translateX="200" hbarPolicy="NEVER"
                      StackPane.alignment="TOP_RIGHT"
                      style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox styleClass="exif-panel-root" spacing="0">
            <VBox styleClass="exif-panel-header">
                <Label text="EXIF" styleClass="exif-panel-section-label"/>
                <Label text="EXIF 文件元信息" styleClass="exif-panel-title" userData="i18n:exif.panel.title"/>
            </VBox>
            <VBox fx:id="exifSummaryBox" styleClass="exif-summary-items" spacing="0"/>
            <Label text="STATES" styleClass="exif-panel-states-label" userData="i18n:exif.panel.states"/>
            <VBox fx:id="exifStatesBox" styleClass="exif-panel-states" spacing="8"/>
        </VBox>
    </SmoothScrollPane>

</StackPane>
