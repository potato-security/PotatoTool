<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>
<?import com.potato.potatotool.utils.ui.SmoothTextArea?>

<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import org.fxmisc.richtext.CodeArea?>
<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<StackPane fx:id="sPane"
           stylesheets="@../../css/getIpInfo.css"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.potato.potatotool.controller.blueTeam.PaneGetIpInfo">
   <children>
      <VBox styleClass="ipinfo-root" spacing="14">
         <children>

            <!-- 输入 + 提取按钮 -->
            <HBox spacing="12" alignment="CENTER_LEFT">
               <SmoothTextArea fx:id="inputText" styleClass="pt-input,pt-mono" wrapText="true" prefHeight="76" minHeight="76" HBox.hgrow="ALWAYS" maxWidth="Infinity" promptText="请输入netstat -ano或者net -pantu执行后的内容" userData="i18n-prompt:ipinfo.input.placeholder"/>
               <Button minHeight="76.0" minWidth="104" styleClass="pt-btn-primary" text="提取 IP" userData="i18n:ipinfo.extract" onAction="#getIpInfo"/>
            </HBox>

            <!-- 过滤规则 -->
            <HBox spacing="12" alignment="CENTER_LEFT">
               <Label text="过滤规则" styleClass="pt-section-label" minWidth="72" userData="i18n:ipinfo.filter.label"/>
               <ComboBox fx:id="rulesComboBox" prefHeight="30.0" prefWidth="240" onAction="#rulesComboChoose"
                         promptText="提取后可用" userData="i18n-prompt:ipinfo.filter.prompt"/>
               <TextField fx:id="customTextField" styleClass="pt-input" prefHeight="30.0" prefWidth="240" promptText="IP/Pos前缀内容" userData="i18n-prompt:ipinfo.filter.placeholder"/>
            </HBox>

            <!-- 结果双面板: 左 IP 列表 / 右 原始文本 -->
            <SmoothScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER"
                              style="-fx-background-color: transparent; -fx-background: transparent;">
               <FlowPane fx:id="flowPane" hgap="16" vgap="16" prefWidth="${sPane.width - 20}">
                  <children>

                     <!-- 左: IP 列表 (result1/2/5/6) -->
                     <VBox styleClass="ipinfo-panel" spacing="10">
                        <Label text="IP 列表" styleClass="ipinfo-panel-title" userData="i18n:ipinfo.panel.iplist"/>
                        <VBox spacing="3">
                           <Label fx:id="ipLabel" styleClass="ipinfo-cap" text="IP提取" userData="i18n:ipinfo.extract.title"/>
                           <StackPane styleClass="codeAreaPane">
                              <VirtualizedScrollPane fx:id="virScrollPane1" styleClass="virtualizedScrollPane">
                                 <content><CodeArea fx:id="result1" editable="false" styleClass="codeArea"/></content>
                              </VirtualizedScrollPane>
                           </StackPane>
                        </VBox>
                        <VBox spacing="3">
                           <Label styleClass="ipinfo-cap" text="IP提取+归属" userData="i18n:ipinfo.extract.location"/>
                           <StackPane styleClass="codeAreaPane">
                              <VirtualizedScrollPane fx:id="virScrollPane2" styleClass="virtualizedScrollPane">
                                 <content><CodeArea fx:id="result2" editable="false" styleClass="codeArea"/></content>
                              </VirtualizedScrollPane>
                           </StackPane>
                        </VBox>
                        <VBox spacing="3">
                           <Label fx:id="ipLabelSelect" styleClass="ipinfo-cap" text="筛选-IP提取" userData="i18n:ipinfo.filter.extract"/>
                           <StackPane styleClass="codeAreaPane">
                              <VirtualizedScrollPane fx:id="virScrollPane5" styleClass="virtualizedScrollPane">
                                 <content><CodeArea fx:id="result5" editable="false" styleClass="codeArea"/></content>
                              </VirtualizedScrollPane>
                           </StackPane>
                        </VBox>
                        <VBox spacing="3">
                           <Label styleClass="ipinfo-cap" text="筛选-IP提取+归属" userData="i18n:ipinfo.filter.location"/>
                           <StackPane styleClass="codeAreaPane">
                              <VirtualizedScrollPane fx:id="virScrollPane6" styleClass="virtualizedScrollPane">
                                 <content><CodeArea fx:id="result6" editable="false" styleClass="codeArea"/></content>
                              </VirtualizedScrollPane>
                           </StackPane>
                        </VBox>
                     </VBox>

                     <!-- 右: 原始文本 (result3/4/7/8) -->
                     <VBox styleClass="ipinfo-panel" spacing="10">
                        <Label text="原始文本" styleClass="ipinfo-panel-title" userData="i18n:ipinfo.panel.rawtext"/>
                        <VBox spacing="3">
                           <Label styleClass="ipinfo-cap" text="原文标识IP" userData="i18n:ipinfo.mark.ip"/>
                           <StackPane styleClass="codeAreaPane">
                              <VirtualizedScrollPane fx:id="virScrollPane3" styleClass="virtualizedScrollPane">
                                 <content><CodeArea fx:id="result3" editable="false" styleClass="codeArea"/></content>
                              </VirtualizedScrollPane>
                           </StackPane>
                        </VBox>
                        <VBox spacing="3">
                           <Label styleClass="ipinfo-cap" text="原文标识IP+归属" userData="i18n:ipinfo.mark.location"/>
                           <StackPane styleClass="codeAreaPane">
                              <VirtualizedScrollPane fx:id="virScrollPane4" styleClass="virtualizedScrollPane">
                                 <content><CodeArea fx:id="result4" editable="false" styleClass="codeArea"/></content>
                              </VirtualizedScrollPane>
                           </StackPane>
                        </VBox>
                        <VBox spacing="3">
                           <Label styleClass="ipinfo-cap" text="筛选-原文标识IP" userData="i18n:ipinfo.filter.mark"/>
                           <StackPane styleClass="codeAreaPane">
                              <VirtualizedScrollPane fx:id="virScrollPane7" styleClass="virtualizedScrollPane">
                                 <content><CodeArea fx:id="result7" editable="false" styleClass="codeArea"/></content>
                              </VirtualizedScrollPane>
                           </StackPane>
                        </VBox>
                        <VBox spacing="3">
                           <Label styleClass="ipinfo-cap" text="筛选-原文标识IP+归属" userData="i18n:ipinfo.filter.mark.location"/>
                           <StackPane styleClass="codeAreaPane">
                              <VirtualizedScrollPane fx:id="virScrollPane8" styleClass="virtualizedScrollPane">
                                 <content><CodeArea fx:id="result8" editable="false" styleClass="codeArea"/></content>
                              </VirtualizedScrollPane>
                           </StackPane>
                        </VBox>
                     </VBox>

                  </children>
               </FlowPane>
            </SmoothScrollPane>
         </children>
      </VBox>
   </children>
    <!-- 四角取景框叠加在最上层 -->
    <Region styleClass="pt-corner-tl" mouseTransparent="true" StackPane.alignment="TOP_LEFT" translateX="4" translateY="4"/>
    <Region styleClass="pt-corner-tr" mouseTransparent="true" StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
    <Region styleClass="pt-corner-bl" mouseTransparent="true" StackPane.alignment="BOTTOM_LEFT" translateX="4" translateY="-4"/>
    <Region styleClass="pt-corner-br" mouseTransparent="true" StackPane.alignment="BOTTOM_RIGHT" translateX="-4" translateY="-4"/>
</StackPane>
