<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../../css/PaneInfoGeneration.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.blueTeam.PaneLocationQuery"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <SmoothScrollPane fx:id="scrollPane" fitToWidth="true" prefHeight="${sPane.height}" prefWidth="${sPane.width}"
                      style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="20" style="-fx-padding: 18 20 20 20;">

            <!-- 身份证查询 -->
            <VBox styleClass="loc-card" spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <Label text="身份证查询" styleClass="loc-card-title" userData="i18n:location.card.idcard"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="SYNC" styleClass="pt-caption"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField styleClass="pt-input" HBox.hgrow="ALWAYS" maxWidth="Infinity" fx:id="idCardInput" promptText="请输入身份证号" userData="i18n-prompt:location.idcard.placeholder"/>
                    <Button styleClass="pt-btn-primary" minHeight="36.0" minWidth="96" text="查询" userData="i18n:location.query" onAction="#getIdCardInfoFx"/>
                    <Button styleClass="pt-btn" minHeight="36.0" minWidth="96" text="批量导出" userData="i18n:location.batch" onAction="#getIdCardInfoFx_batch"/>
                </HBox>
                <HBox spacing="16">
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="生日" styleClass="loc-field-label" userData="i18n:location.birthday"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="idCardTF_born"/></VBox>
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="性别" styleClass="loc-field-label" userData="i18n:location.gender"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="idCardTF_sex"/></VBox>
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="地区" styleClass="loc-field-label" userData="i18n:location.region"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="idCardTF_att"/></VBox>
                </HBox>
            </VBox>

            <!-- 银行卡查询 -->
            <VBox styleClass="loc-card" spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <Label text="银行卡查询" styleClass="loc-card-title" userData="i18n:location.card.bankcard"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="SYNC" styleClass="pt-caption"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField styleClass="pt-input" HBox.hgrow="ALWAYS" maxWidth="Infinity" fx:id="bankCardInput" promptText="请输入银行卡号" userData="i18n-prompt:location.bankcard.placeholder"/>
                    <Button styleClass="pt-btn-primary" minHeight="36.0" minWidth="96" text="查询" userData="i18n:location.query" onAction="#getBankCardInfoFx"/>
                    <Button styleClass="pt-btn" minHeight="36.0" minWidth="96" text="批量导出" userData="i18n:location.batch" onAction="#getBankCardInfoFx_batch"/>
                </HBox>
                <HBox spacing="16">
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="归属" styleClass="loc-field-label" userData="i18n:location.attribution"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="bankCardTF_position"/></VBox>
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="银行" styleClass="loc-field-label" userData="i18n:location.bank"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="bankCardTF_bank"/></VBox>
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="类型" styleClass="loc-field-label" userData="i18n:location.type"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="bankCardTF_type"/></VBox>
                </HBox>
            </VBox>

            <!-- 手机号查询 -->
            <VBox styleClass="loc-card" spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <Label text="手机号查询" styleClass="loc-card-title" userData="i18n:location.card.phone"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="SYNC" styleClass="pt-caption"/>
                    <Label text=" · 批量进度→输入栏" styleClass="pt-caption" style="-fx-text-fill: -pt-text-tertiary;"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField styleClass="pt-input" HBox.hgrow="ALWAYS" maxWidth="Infinity" fx:id="phoneInput" promptText="请输入手机号" userData="i18n-prompt:location.phone.placeholder"/>
                    <Button styleClass="pt-btn-primary" minHeight="36.0" minWidth="96" text="查询" userData="i18n:location.query" onAction="#getPhoneInfoFx"/>
                    <Button styleClass="pt-btn" minHeight="36.0" minWidth="96" text="批量导出" userData="i18n:location.batch" onAction="#getPhoneInfoFx_batch"/>
                </HBox>
                <HBox spacing="16">
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="省份" styleClass="loc-field-label" userData="i18n:location.province"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="phoneTF_Province"/></VBox>
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="城市" styleClass="loc-field-label" userData="i18n:location.city"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="phoneTF_City"/></VBox>
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="运商" styleClass="loc-field-label" userData="i18n:location.operator"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="phoneTF_Operator"/></VBox>
                </HBox>
                <HBox spacing="16">
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="区号" styleClass="loc-field-label" userData="i18n:location.areacode"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="phoneTF_AreaCode"/></VBox>
                    <VBox styleClass="loc-field" spacing="4" HBox.hgrow="ALWAYS"><Label text="邮编" styleClass="loc-field-label" userData="i18n:location.zipcode"/><TextField styleClass="pt-input" maxWidth="Infinity" fx:id="phoneTF_PostalCode"/></VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

        </VBox>
    </SmoothScrollPane>

</StackPane>
