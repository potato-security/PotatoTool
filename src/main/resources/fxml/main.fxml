<?xml version="1.0" encoding="UTF-8"?>
<?import com.potato.potatotool.utils.ui.SmoothScrollPane?>

<?import com.leewyatt.rxcontrols.controls.RXCarousel?>
<?import com.leewyatt.rxcontrols.controls.RXToggleButton?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Screen?>


<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.Cursor?>
<AnchorPane fx:id="root"
            onMouseDragged="#topBarDraggedAction"
            onMousePressed="#topBarPressedAction"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="${screen.visualBounds.height* 0.8}"
            prefWidth="${screen.visualBounds.width* 0.8}"
            xmlns="http://javafx.com/javafx/"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.potato.potatotool.controller.MainController">
   <fx:define>
      <Screen fx:factory="getPrimary" fx:id="screen"/>
   </fx:define>
   <children>
      <StackPane fx:id="outerBorderPane" layoutX="9.0" layoutY="9.0" alignment="CENTER">
         <effect>
            <DropShadow/>
         </effect>
         <BorderPane fx:id="borderPane" prefHeight="${root.height - 18}" prefWidth="${root.width - 18}">
            <top>
               <VBox>
                  <children>
                     <!--头部-->
                     <BorderPane fx:id="topBar" prefHeight="${(root.prefHeight - 18) * 0.1}" prefWidth="${root.width - 18}">
                        <left>
                           <!-- 头部左侧：MODE 标签 + 模式切换胶囊（对齐 Penpot 稿头部布局） -->
                           <VBox alignment="CENTER_LEFT" prefHeight="${topBar.height}" spacing="4" style="-fx-padding: 0 0 0 20;">
                              <Label text="MODE" styleClass="header-mode-label"/>
                              <HBox fx:id="changeBtn" styleClass="mode-toggle-group" spacing="6" alignment="CENTER_LEFT">
                                 <Button fx:id="btnBlueMode" text="Blue" mnemonicParsing="false" onAction="#changeModeBlue" styleClass="mode-pill,mode-pill-blue"/>
                                 <Button fx:id="btnRedMode" text="Red" mnemonicParsing="false" onAction="#changeModeRed" styleClass="mode-pill,mode-pill-red"/>
                              </HBox>
                              <!-- 保留 fx:id 供 controller 旧引用（已废弃的滑动动画），避免 NPE -->
                              <HBox fx:id="topBarLeft" managed="false" visible="false"/>
                           </VBox>
                        </left>
                        <center>
                           <VBox alignment="CENTER" spacing="2" BorderPane.alignment="CENTER">
                              <ImageView fx:id="wordmarkImg" fitHeight="40.0" fitWidth="250.0"  pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../img/PotatoTool.png" />
                                 </image>
                                 <effect>
                                    <DropShadow fx:id="wordmarkGlow" color="#4FE3FF" radius="22" spread="0.38"/>
                                 </effect>
                              </ImageView>
                              <Label fx:id="wordmarkSubtitle" text="SECURITY · COMMAND · CENTER" styleClass="wordmark-subtitle"/>
                           </VBox>
                        </center>
                        <right>
                           <HBox alignment="CENTER" spacing="10" prefHeight="${topBar.height}">
                              <HBox alignment="CENTER" spacing="7" styleClass="header-status">
                                 <Label text="● LOCAL" styleClass="status-pill,status-pill-local"/>
                                 <Label fx:id="proxyStatusLabel" text="PROXY OFF" styleClass="status-pill"/>
                              </HBox>
                              <Pane minWidth="6"/>
                              <Button id="btnSet" mnemonicParsing="false" onAction="#showSet" prefHeight="35.0" prefWidth="35.0">
                                 <graphic>
                                    <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../img/set.png" />
                                       </image>
                                    </ImageView>
                                 </graphic>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                                 <tooltip>
                                    <Tooltip text="设置" userData="i18n:main.setting"/>
                                 </tooltip>
                              </Button>
                              <Pane minWidth="1"/>

                              <Button fx:id="fullScreen" id="btnExit" onAction="#fullScreenAction" prefHeight="35.0" prefWidth="35.0">
                                 <graphic>
                                    <ImageView  fx:id="fullScreenImgView" fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../img/fullScreen.png" />
                                       </image>
                                    </ImageView>
                                 </graphic>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                                 <tooltip>
                                    <Tooltip text="全屏化" userData="i18n:main.fullscreen"/>
                                 </tooltip>
                              </Button>

                              <Button fx:id="reduceScreen" id="btnExit" mnemonicParsing="false" onAction="#reduceScreenAction" prefHeight="35.0" prefWidth="35.0">
                                 <graphic>
                                    <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../img/reduce.png" />
                                       </image>
                                    </ImageView>
                                 </graphic>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                                 <tooltip>
                                    <Tooltip text="缩小化" userData="i18n:main.minimize"/>
                                 </tooltip>
                              </Button>

                              <Button id="btnExit" mnemonicParsing="false" onAction="#exitAction" prefHeight="35.0" prefWidth="35.0">
                                 <graphic>
                                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../img/close.png" />
                                       </image>
                                    </ImageView>
                                 </graphic>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                                 <tooltip>
                                    <Tooltip text="关闭" userData="i18n:tooltip.close"/>
                                 </tooltip>
                              </Button>

                              <Pane minWidth="10"/>
                           </HBox>
                        </right>
                     </BorderPane>
                  </children>
               </VBox>
            </top>
            <center>
               <!--主体: 左侧竖向导航 + 右侧内容-->
               <BorderPane BorderPane.alignment="CENTER">
                  <left>
                     <VBox fx:id="sideNav" styleClass="side-nav" prefWidth="230" minWidth="230" maxWidth="230">
                        <children>
                           <!-- 保留旧动画矩形 fx:id 供 controller 引用（动画废弃，0尺寸不可见） -->
                           <Rectangle fx:id="blueModePane" width="0" height="0" managed="false" visible="false"/>
                           <Rectangle fx:id="redModePane" width="0" height="0" managed="false" visible="false"/>
                           <!--队伍分区标签-->
                           <Label fx:id="modeSectionLabel" text="BLUE OPERATIONS" styleClass="side-nav-section"/>
                           <!--导航列表-->
                           <StackPane VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
                              <!-- 蓝队导航 -->
                              <FlowPane fx:id="blueBar" orientation="VERTICAL" prefWrapLength="4000" alignment="TOP_CENTER" hgap="10" vgap="6" styleClass="box-nav">
                                 <children>
                                    <RXToggleButton selected="true" text="一键解密" userData="i18n:main.blue.webshell">
                                       <toggleGroup>
                                          <ToggleGroup fx:id="navGroup" />
                                       </toggleGroup>
                                    </RXToggleButton>
                                    <RXToggleButton text="专项加解密" userData="i18n:main.blue.separate" toggleGroup="$navGroup" />
                                    <RXToggleButton text="IP信息筛选" userData="i18n:main.blue.ip" toggleGroup="$navGroup" />
                                    <RXToggleButton text="AI分析" userData="i18n:main.blue.ai" toggleGroup="$navGroup" />
                                    <RXToggleButton text="反编译" userData="i18n:main.blue.decompile" toggleGroup="$navGroup" />
                                    <RXToggleButton text="区块链溯源" userData="i18n:main.blue.blockchain" toggleGroup="$navGroup" />
                                    <RXToggleButton text="归属地查询" userData="i18n:main.blue.location" toggleGroup="$navGroup" />
                                    <RXToggleButton text="文件元信息" userData="i18n:main.blue.exif" toggleGroup="$navGroup"/>
                                    <RXToggleButton text="扩展模块" userData="i18n:main.extension" toggleGroup="$navGroup" />
                                    <RXToggleButton text="关于" userData="i18n:main.about" toggleGroup="$navGroup"/>
                                 </children>
                              </FlowPane>
                              <!-- 红队导航 -->
                              <FlowPane fx:id="redBar" orientation="VERTICAL" prefWrapLength="4000" alignment="TOP_CENTER" hgap="10" vgap="6" styleClass="box-nav-red">
                                 <children>
                                    <RXToggleButton text="AI自动渗透" userData="i18n:main.red.aipentest" toggleGroup="$navGroup" />
                                    <RXToggleButton text="资产测绘" userData="i18n:main.red.infosearch" toggleGroup="$navGroup" />
                                    <RXToggleButton text="端口扫描" userData="i18n:main.red.portscan" toggleGroup="$navGroup" />
                                    <RXToggleButton text="漏洞扫描" userData="i18n:main.red.vulnscan" toggleGroup="$navGroup" />
                                    <RXToggleButton text="免杀" userData="i18n:main.red.freekill" toggleGroup="$navGroup" />
                                    <RXToggleButton text="自定义内存马" userData="i18n:main.red.memshell" toggleGroup="$navGroup" />
                                    <RXToggleButton text="Payload 工具箱" userData="i18n:main.red.payload" toggleGroup="$navGroup" />
                                    <RXToggleButton text="命令生成" userData="i18n:main.red.cmdgen" toggleGroup="$navGroup" />
                                    <RXToggleButton text="命令查询" userData="i18n:main.red.cmdquery" toggleGroup="$navGroup" />
                                    <RXToggleButton text="KB提权查询" userData="i18n:main.red.kbquery" toggleGroup="$navGroup" />
                                    <RXToggleButton text="进程分析" userData="i18n:main.red.process" toggleGroup="$navGroup" />
                                    <RXToggleButton text="信息生成" userData="i18n:main.red.infogen" toggleGroup="$navGroup" />
                                    <RXToggleButton text="扩展模块" userData="i18n:main.extension" toggleGroup="$navGroup" />
                                    <RXToggleButton text="关于" userData="i18n:main.about" toggleGroup="$navGroup"/>
                                 </children>
                              </FlowPane>
                           </StackPane>
                        </children>
                     </VBox>
                  </left>
                  <center>
                     <StackPane prefWidth="${root.width - 248}" maxWidth="${root.width - 248}" BorderPane.alignment="CENTER">
                        <RXCarousel fx:id="mainCarousel" arrowDisplayMode="HIDE" autoSwitch="false" hoverPause="false" navDisplayMode="HIDE" prefWidth="${root.width - 248}" maxWidth="${root.width - 248}" prefHeight="${(root.height - 18) - topBar.height - 40}" styleClass="main-pane"/>
                        <!-- HUD 取景框角标 -->
                        <Region styleClass="pt-corner-tl" mouseTransparent="true" StackPane.alignment="TOP_LEFT" translateX="4" translateY="4"/>
                        <Region styleClass="pt-corner-tr" mouseTransparent="true" StackPane.alignment="TOP_RIGHT" translateX="-4" translateY="4"/>
                        <Region styleClass="pt-corner-bl" mouseTransparent="true" StackPane.alignment="BOTTOM_LEFT" translateX="4" translateY="-4"/>
                        <Region styleClass="pt-corner-br" mouseTransparent="true" StackPane.alignment="BOTTOM_RIGHT" translateX="-4" translateY="-4"/>
                     </StackPane>
                  </center>
               </BorderPane>
            </center>
         </BorderPane>
         <StackPane fx:id="promptPane" visible="false" managed="false"
                    maxHeight="-Infinity" maxWidth="-Infinity"
                    alignment="CENTER" StackPane.alignment="CENTER"
                    onMouseClicked="#closePromptPane">
            <Label fx:id="promptLabel" styleClass="pt-body" wrapText="true" textAlignment="CENTER"
                   alignment="CENTER" maxWidth="720"/>
         </StackPane>
      </StackPane>
   </children>
</AnchorPane>
