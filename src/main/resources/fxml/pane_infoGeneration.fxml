<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../css/PaneInfoGeneration.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.PaneInfoGeneration"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <VBox alignment="CENTER" spacing="20">

        <Button minHeight="48.0" minWidth="${sPane.width}" text="生成信息" onAction="#generation">
            <effect>
                <DropShadow />
            </effect>
        </Button>

        <FlowPane styleClass="flowPane" alignment="CENTER" hgap="20"  vgap="30"  prefWidth="${sPane.width - 20}">
            <HBox>
                <Label id="tipTitle" text="           姓名          "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="nameTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="           拼音          "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="nameToPinYinTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="         手机号        "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="phoneTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="         邮箱号        "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="emailTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="       居住地址       "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="addressTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="       身份证号       "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="idCardTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="       银行卡号       "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="bankCardTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="         邮编号        "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="postalCodeTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="统一社会信用代码"/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="unifiedSocialCreditCodeTF"/>
            </HBox>
            <HBox>
                <Label id="tipTitle" text="   组织机构代码   "/>
                <Label id="tipSymbol" text="："/>
                <TextField prefWidth="${sPane.width / 2 -225}" fx:id="organizationCodeTF"/>
            </HBox>
        </FlowPane>
        <Pane minHeight="40"/>

    </VBox>

</StackPane>
