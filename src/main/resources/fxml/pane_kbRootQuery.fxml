<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../css/PaneKbRootQuery.css"
           fx:id="sPane"
           fx:controller="com.potato.potatotool.controller.PaneKbRootQuery"
           maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">

    <VBox fx:id="vBox" alignment="CENTER" prefWidth="${sPane.width}" prefHeight="${sPane.height}" spacing="15">

        <Pane style="-fx-background-radius: 10;-fx-background-color: null" minHeight="${sPane.height * 0.4 - 75}">
            <TextArea  fx:id="inputText" wrapText="true" prefHeight="${sPane.height * 0.4 - 75}" prefWidth="${sPane.width}" promptText="请粘贴补丁号或systeminfo信息"  />
        </Pane>

        <Button minHeight="48.0" minWidth="${sPane.width}" text="提取查询" onAction="#searchKb">
            <effect>
                <DropShadow />
            </effect>
        </Button>

    </VBox>

    <Label prefWidth="${sPane.width}" prefHeight="${sPane.height}"/>
    <Label prefWidth="550" prefHeight="500">
        <graphic>
            <Region styleClass="closeImg"/>
        </graphic>
    </Label>



</StackPane>
