    "id": "wireguard-private-key",
    "info": {
      "name": "WireGuard Private Key",
      "author": "DhiyaneshDK",
      "severity": "info",
      "reference": [
        "https://github.com/praetorian-inc/noseyparker/blob/main/crates/noseyparker/data/default/builtin/rules/wireguard.yml",
        "https://www.wireguard.com/quickstart/",
        "https://manpages.debian.org/testing/wireguard-tools/wg.8.en.html",
        "https://gist.github.com/lanceliao/5d2977f417f34dda0e3d63ac7e217fd"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "wireguard,exposure,tokens"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "PrivateKey\\s*\u003d\\s*([A-Za-z0-9+/]{43}\u003d)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}