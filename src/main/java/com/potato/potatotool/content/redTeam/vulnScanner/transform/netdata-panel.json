      "severity": "info",
      "description": "Netdata panel was detected.\n",
      "reference": [
        "https://github.com/netdata/netdata",
        "https://www.netdata.cloud/"
      ],
      "classification": {
        "cvss_metrics": "CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:N",
        "cwe_id": "CWE-200"
      },
      "metadata": {
        "max_request": 1,
        "shodan_query": [
          "http.title:\"netdata dashboard\"",
          "http.title:\"Netdata Console\"",
          "server: netdata embedded http server"
        ],
        "fofa_query": "title\u003d\"netdata dashboard\"",
        "google_query": "intitle:\"netdata dashboard\""
      },
      "tags": "panel,netdata"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/api/v1/info",
          "{{BaseURL}}/sign-in"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "or",
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "status_code \u003d\u003d 200",
              "contains(to_lower(header), \"application/json\")",
              "contains(to_lower(body), \"netdata\")"
            ],
            "condition": "and"
          },
          {
            "type": "dsl",
            "dsl": [
              "status_code \u003d\u003d 200",
              "contains(to_lower(body), \"\u003ctitle\u003enetdata console\u003c/title\u003e\")"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)version:\\s+\"([0-9.]+)\""
            ],
            "group": 1,
            "internal": true
          },
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)nodeEnv:\\s+\"([a-z0-9]+)\""
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
