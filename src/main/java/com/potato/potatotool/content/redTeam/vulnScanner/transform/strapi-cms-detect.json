  "originalPoc": {
    "id": "strapi-cms-detect",
    "info": {
      "name": "Strapi CMS detect",
      "author": "cyllective,daffainfo,idealphase",
      "severity": "info",
      "description": "Open source Node.js Headless CMS to easily build customisable APIs",
      "reference": [
        "https://github.com/strapi/strapi"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "tech,strapi,cms"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/admin/init"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "\"data\"",
              "\"uuid\"",
              "\"hasAdmin\""
            ],
            "condition": "and",
            "case_insensitive": false
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\"strapiVersion\":\"([0-9.]+)\""
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}