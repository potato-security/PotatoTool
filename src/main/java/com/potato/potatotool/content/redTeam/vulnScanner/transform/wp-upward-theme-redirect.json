{
  "id": "wp-upward-theme-redirect",
  "name": "WordPress Upward Themes \u003c1.5 - Open Redirect",
  "author": "r3Y3r53",
  "severity": "MEDIUM",
  "description": "WordPress Upward Themes 1.5 accepts a user-controlled input that specifies a link to an external site, and uses that link in a Redirect. This simplifies phishing attacks. An http parameter may contain a URL value and could cause the web application to redirect the request to the specified URL. By modifying the URL value to a malicious site, an attacker may successfully launch a phishing scam and steal user credentials.\n",
  "references": [
    "https://cxsecurity.com/issue/WLB-2020030133"
  ],
  "tags": [
    "wordpress",
    "wp-theme",
    "wp",
    "upward",
    "redirect"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "google": "inurl:\"/wp-content/themes/Upward/\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/wp-content/themes/Upward/go.php?https://interact.sh",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "REGEX",
          "part": "header",
          "values": [
            "(?m)^(?:Location\\s*?:\\s*?)(?:https?://|//)?(?:[a-zA-Z0-9\\-_\\.@]*)interact\\.sh.*$"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
