      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "\u003ctitle\u003e.*?Apache(|\\d+) .*?(Default|Test).*?\u003c/title\u003e",
            "\u003ctitle\u003e(Default|Test).*? Apache(|\\d+).*?\u003c/title\u003e"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
