    "id": "phplist-detect",
    "info": {
      "name": "phpList - Detect",
      "author": "ricardomaia",
      "severity": "info",
      "description": "phpList is an open source newsletter manager.\n",
      "reference": [
        "https://www.phplist.org/"
      ],
      "classification": {},
      "metadata": {
        "max_request": 1,
        "shodan_query": "html:\"phplist\""
      },
      "tags": "tech,phplist,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "content\u003d\"phpList",
              "phpList Ltd",
              "phpList\u003c/a\u003e"
            ],
            "condition": "or",
            "case_insensitive": true
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)version.((\\d\\.?)+)"
            ],
            "group": 1,
            "name": "version",
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}