{
  "id": "fuji-xerox-default-login",
  "name": "Fuji Xerox ApeosPort - Default Login",
  "author": "Morgan Robertson",
  "severity": "HIGH",
  "description": "This template checks for the default credentials (username: 11111, password: x-admin) on Fuji Xerox ApeosPort series printers. If the credentials are valid, the response will have a 200 HTTP status code. Tested on a Fuji Xerox ApeosPort-V C2275 T2.\n",
  "references": [
    "https://4it.com.au/kb/article/fuji-xerox-default-password/"
  ],
  "tags": [
    "default-login",
    "fuji",
    "fuji-xerox",
    "printer"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "fofa": "\"prop.htm\" \u0026\u0026 \"docucentre\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "GET /prop.htm HTTP/1.1\nHost: {{Hostname}}\nAuthorization: Basic MTExMTE6eC1hZG1pbg\u003d\u003d\nConnection: close\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "Configuration Overview",
            "Description",
            "System Administrator Settings"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "STATUS",
          "values": [
            "200"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
