{
  "id": "springboot-heapdump",
  "name": "Spring Boot Actuator - Heap Dump Detection",
  "author": "that_juan_,dwisiswant0,wdahlenb",
  "severity": "CRITICAL",
  "description": "A Spring Boot Actuator heap dump was detected. A heap dump is a snapshot of JVM memory, which could expose environment variables and HTTP requests.\n",
  "references": [
    "https://github.com/pyn3rd/Spring-Boot-Vulnerability"
  ],
  "tags": [
    "springboot",
    "exposure",
    "misconfig"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
  "variables": {
    "str": [
      "{{rand_base(6)}}"
    ]
  },
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "GET /{{str}} HTTP/1.1\nHost: {{Hostname}}\n",
        "GET /heapdump HTTP/1.1\nHost: {{Hostname}}\n",
        "GET /actuator/heapdump HTTP/1.1\nHost: {{Hostname}}\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "!contains(hex_encode(body_1), \u00271f8b080000000000\u0027)",
            "contains(hex_encode(body_2), \u00271f8b080000000000\u0027)"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "DSL",
          "values": [
            "!contains(hex_encode(body_1), \u00271f8b080000000000\u0027)",
            "contains(hex_encode(body_3), \u00271f8b080000000000\u0027)"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "DSL",
          "values": [
            "contains(hex_encode(body_2), \u00274a4156412050524f46494c45\u0027) || contains(hex_encode(body_2), \u00274850524f46\u0027)",
            "contains(hex_encode(body_3), \u00274a4156412050524f46494c45\u0027) || contains(hex_encode(body_3), \u00274850524f46\u0027)"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
