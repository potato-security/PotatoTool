    "id": "fusionauth-admin-panel",
    "info": {
      "name": "FusionAuth Admin Panel - Detect",
      "author": "ritikchaddha",
      "severity": "info",
      "classification": {},
      "metadata": {
        "max_request": 2,
        "shodan_query": [
          "title:\"FusionAuth\"",
          "http.title:\"fusionauth\""
        ],
        "fofa_query": "title\u003d\"fusionauth\"",
        "google_query": "intitle:\"fusionauth\""
      },
      "tags": "panel,fusionauth,detect,login"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}",
          "{{BaseURL}}/oauth2/authorize"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "\u003ctitle\u003eLogin | FusionAuth",
              "FusionAuth.OAuth2",
              "content\u003d\"FusionAuth"
            ],
            "condition": "or",
            "case_insensitive": false
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "FusionAuth\\.Version \u003d \"([0-9.]+)\";"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
