{
  "id": "aix-websm-detect",
  "name": "AIX WebSM - Detect",
  "author": "righettod",
  "severity": "INFO",
  "description": "Detects IBM AIX Web-based System Manager services.\n",
  "references": [
    "https://en.wikipedia.org/wiki/IBM_Web-based_System_Manager",
    "https://www.filibeto.org/unix/aix/lib/rel/5.2/wsmadmn.pdf"
  ],
  "tags": [
    "network",
    "aix",
    "detect",
    "detection",
    "tcp"
  ],
  "protocol": "tcp",
  "selfContained": false,
  "searchQueries": {
    "shodan": "/websm/"
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "host": "{{Hostname}}",
      "port": "9090",
      "inputs": [
        {
          "data": "en_US\r\n",
          "read": "1024"
        }
      ],
      "stepId": "tcp_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 4096,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "data",
          "values": [
            "/var/websm/",
            "startNewWServer"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "aix-websm-detect",
    "info": {
      "name": "AIX WebSM - Detect",
      "author": "righettod",
      "severity": "info",
      "description": "Detects IBM AIX Web-based System Manager services.\n",
