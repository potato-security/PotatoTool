{
  "id": "shiro-deserialization-detection",
  "name": "Shiro \u003c\u003d 1.2.4 Deserialization Detection",
  "author": "hotpot,j4vaovo",
  "severity": "UNKNOWN",
  "description": "This template is designed to detect the Shiro framework\u0027s default key vulnerabilities. It leverages 51 built-in Shiro keys to probe for potential vulnerabilities.\n",
  "references": [
    "https://github.com/sv3nbeast/ShiroScan"
  ],
  "tags": [
    "shiro",
    "deserialization",
    "rce",
    "apache"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
  "variables": {
    "key": [
      "helpers/wordlists/shiro_encrypted_keys.txt"
    ]
  },
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "GET / HTTP/1.1\nHost: {{Hostname}}\nCookie: JSESSIONID\u003d{{randstr}};rememberMe\u003d123;\n",
        "GET / HTTP/1.1\nHost: {{Hostname}}\nCookie: JSESSIONID\u003d{{randstr}};rememberMe\u003d{{key}};\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "contains(header_1, \"Set-Cookie\") \u0026\u0026 (contains(header_1, \"rememberMe\u003d\") || contains(header_1, \"\u003ddeleteMe\"))",
            "!contains(header_2, \"rememberMe\u003d\") \u0026\u0026 !contains(header_2, \"\u003ddeleteMe\")"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "DSL",
          "values": [
            "!contains(body_2, \"\u003cp\u003e当前访问疑似黑客攻击，已被网站管理员设置拦截并记录\u003c/p\u003e\")",
            "!contains(body_2, \"很抱歉，由于您访问的URL有可能对网站造成安全威胁，您的访问被阻断\")"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": true,
    "threads": 0,
