{
  "id": "cloudfoundry-detect",
  "name": "Cloudfoundry Detect",
  "author": "uomogrande",
  "severity": "INFO",
  "description": "Detects cloudfoundry based on response headers",
  "references": [
    "https://docs.cloudfoundry.org/concepts/cf-routing-architecture.html"
  ],
  "tags": [
    "cloudfoundry",
    "tech"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "GET / HTTP/1.1\nHost: {{Hostname}}\n",
        "GET / HTTP/1.1\nHost: {{randstr}}.com\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "contains(header, \"X-Vcap-Request-Id:\") || contains(header, \"X-Cf-Routererror:\")"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": true,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "cloudfoundry-detect",
