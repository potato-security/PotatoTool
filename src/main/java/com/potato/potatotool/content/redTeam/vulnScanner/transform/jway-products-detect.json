    "id": "jway-products-detect",
    "info": {
      "name": "JWay Products - Detect",
      "author": "righettod",
      "severity": "info",
      "description": "JWay products was detected.\n",
      "reference": [
        "https://www.jway.eu/produits-services"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "panel,jway,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/generatedHomepage.html"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "status_code \u003d\u003d 200",
              "contains_any(to_lower(body), \"jway.footer.url.help\", \"jway.footer.url.contact\", \"jway.footer.url.legal\")"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)Produced\\s+by\\s+Form([a-z]+)"
            ],
            "group": 1,
            "internal": true
          },
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "Form(?:[a-zA-Z]+)\\s+v([0-9.]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
