{
  "id": "gitlab-explore",
  "name": "GitLab Instance Explore - Detect",
  "author": "Sujal Tuladhar",
  "severity": "INFO",
  "description": "This template checks for GitLab instances by verifying if /explore and /api/v4/projects endpoints are accessible with a 200 response.\n",
  "tags": [
    "gitlab",
    "explore",
    "panel",
    "detect"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "fofa": "title\u003d\"GitLab\"",
    "shodan": "title:\"GitLab\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/explore",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "contains_all(body, \"\u003eMost stars\", \"Hide archived projects\")",
            "contains_all(body, \"description\\\":\", \"name_with_namespace\\\":\")"
          ],
          "negative": false,
          "condition": "OR",
          "name": "gitlab-community",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "DSL",
          "values": [
            "contains_all(body, \"\u003eMost starred\", \"Explore public groups\")",
            "status_code \u003d\u003d 200"
          ],
          "negative": false,
          "condition": "AND",
          "name": "gitlab-enterprise",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": true,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "gitlab-explore",
    "info": {
      "name": "GitLab Instance Explore - Detect",
      "author": "Sujal Tuladhar",
      "severity": "info",
      "description": "This template checks for GitLab instances by verifying if /explore and /api/v4/projects endpoints are accessible with a 200 response.\n",
      "metadata": {
        "max_request": 2,
        "shodan_query": "title:\"GitLab\"",
        "fofa_query": "title\u003d\"GitLab\""
      },
      "tags": "gitlab,explore,panel,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/explore",
          "{{BaseURL}}/api/v4/projects"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "dsl",
            "name": "gitlab-community",
            "dsl": [
              "contains_all(body, \"\u003eMost stars\", \"Hide archived projects\")",
              "contains_all(body, \"description\\\":\", \"name_with_namespace\\\":\")"
            ],
            "condition": "or"
          },
          {
            "type": "dsl",
            "name": "gitlab-enterprise",
            "dsl": [
              "contains_all(body, \"\u003eMost starred\", \"Explore public groups\")",
              "status_code \u003d\u003d 200"
            ],
            "condition": "and"
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}