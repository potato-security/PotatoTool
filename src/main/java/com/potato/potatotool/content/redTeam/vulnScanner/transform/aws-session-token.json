  "originalPoc": {
    "id": "aws-session-token",
    "info": {
      "name": "AWS Session Token",
      "author": "DhiyaneshDK",
      "severity": "info",
      "reference": [
        "https://github.com/praetorian-inc/noseyparker/blob/main/data/default/rules/aws.yml"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "aws,amazon,token,exposure,session"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)(?:aws.?session|aws.?session.?token|aws.?token)[\"\u0027`]?\\s{0,30}(?::|\u003d\u003e|\u003d)\\s{0,30}[\"\u0027`]?([a-z0-9/+\u003d]{16,200})[^a-z0-9/+\u003d]"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}