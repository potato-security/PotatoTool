          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "REGEX",
          "part": "header",
          "values": [
            "Microsoft-HTTPAPI\\/[0-9\\.]+"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        },
        {
          "type": "WORD",
          "part": "header",
          "values": [
            "Www-Authenticate: NTLM",
