    "id": "prometheus-flags",
    "info": {
      "name": "Prometheus flags API endpoint",
      "author": "geeknik",
      "severity": "info",
      "description": "The flags endpoint provides a full path to the configuration file. If the file is stored in the home directory, it may leak a username.",
      "reference": [
        "https://jfrog.com/blog/dont-let-prometheus-steal-your-fire/"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "prometheus,leak,misconfig"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/api/v1/status/flags"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "status",
            "status": [
              200
            ]
          },
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "\"data\":",
              "\"config.file\":"
            ],
            "condition": "and",
            "case_insensitive": false
          },
          {
            "type": "word",
            "negative": false,
            "part": "header",
            "words": [
              "application/json"
            ],
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\\\"web\\.enable\\-admin\\-api\\\"\\: \\\"true\\\""
            ],
            "group": 1,
            "name": "web_admin_enabled",
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
