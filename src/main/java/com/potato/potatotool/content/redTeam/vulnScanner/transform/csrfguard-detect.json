    "id": "csrf-guard-detect",
    "info": {
      "name": "OWASP CSRFGuard 3.x/4.x - Detect",
      "author": "forgedhallpass",
      "severity": "info",
      "description": "OWASP CSRFGuard 3.x and 4.x were checked for whether token-per-page support is enabled based on default configuration.",
      "reference": [
        "https://github.com/OWASP/www-project-csrfguard"
      ],
      "classification": {
        "cvss_metrics": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:N",
        "cvss_score": "0",
        "cwe_id": "CWE-200"
      },
      "metadata": {
        "max_request": 3
      },
      "tags": "tech,csrfguard,owasp"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "redirects": false,
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "raw": [
          "GET / HTTP/1.1\nHost: {{Hostname}}\n",
          "GET /JavaScriptServlet HTTP/1.1\nHost: {{Hostname}}\nReferer: {{BaseURL}}\n",
          "POST /JavaScriptServlet HTTP/1.1\nHost: {{Hostname}}\nOWASP-CSRFTOKEN: {{masterToken}}\n"
        ],
        "matchers_condition": "or",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "FETCH-CSRF-TOKEN"
            ],
            "case_insensitive": false
          },
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "masterTokenValue"
            ],
            "case_insensitive": false
          },
          {
            "type": "dsl",
            "name": "Disabled-token-per-page",
            "dsl": [
              "status_code_3\u003d\u003d400",
              "contains(body, \"Token-Per-Page functionality is disabled\")"
            ],
            "condition": "and"
          },
          {
            "type": "dsl",
            "name": "Enabled-token-per-page",
            "dsl": [
              "status_code_3\u003d\u003d200",
              "contains(body, \"{\\\"pageTokens\")"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?:masterTokenValue\\s*\u003d\\s*\u0027)([^\u0027]+)\u0027;"
            ],
            "group": 1,
            "name": "masterToken",
            "internal": true
          },
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?:masterTokenValue\\s*\u003d\\s*\u0027)([^\u0027]+)\u0027;"
            ],
            "group": 1,
            "name": "master-token",
            "internal": true
          },
          {
            "type": "json",
            "json": [
              ".pageTokens"
            ]
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}