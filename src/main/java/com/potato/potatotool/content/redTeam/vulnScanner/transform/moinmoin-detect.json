            "\u003ca href\u003d\"http://moinmo.in/Python\" title\u003d\"MoinMoin is written in Python.\"\u003ePython Powered\u003c/a\u003e"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
