{
  "id": "magento-downloader-panel",
  "name": "Magento Connect Manager Installer - Detect",
  "author": "5up3r541y4n",
  "severity": "INFO",
  "description": "Magento Connect Manager installer was detected. The software, available via /downloader/ location, requires Magento admin rights and uses the same authorization methods as for backend. If an attacker locates a matching pair of login/password, the installation will be compromised. An attacker can then discover backend URL for login (even if it is customized as described in Securing Magento /admin/) and install a Filesystem extension to obtain full access to all files and finally the database.\n",
  "references": [
    "https://magentary.com/kb/restrict-access-to-magento-downloader/",
    "https://www.mageplaza.com/kb/how-to-stop-brute-force-attacks-magento.html#solution-3"
  ],
  "tags": [
    "magento",
    "exposure",
    "panel"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "shodan": "http.component:\"Magento\" cpe:\"cpe:2.3:a:magento:magento\" http.component:\"magento\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/downloader/",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "Magento Downloader",
            "Log In"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "WORD",
          "part": "header",
          "values": [
            "text/html"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "STATUS",
          "values": [
            "200"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
