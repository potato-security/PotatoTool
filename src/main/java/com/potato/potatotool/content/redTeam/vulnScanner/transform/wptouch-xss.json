{
  "id": "wptouch-xss",
  "name": "WordPress WPtouch \u003c4.3.44 - Cross-Site Scripting",
  "author": "akincibor",
  "severity": "MEDIUM",
  "description": "WordPress WPtouch plugin prior to 4.3.44 contains a cross-site scripting vulnerability. The plugin does not escape some URLs before outputting them back in attributes. An attacker can inject arbitrary script in the browser of an unsuspecting user in the context of the affected site. This can allow the attacker to steal cookie-based authentication credentials and launch other attacks.\n",
  "references": [
    "https://wpscan.com/vulnerability/7dbd8348-9c5d-4d62-a0f4-2b7c2b7e58e4",
    "https://wordpress.org/plugins/wptouch/advanced/"
