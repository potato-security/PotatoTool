    "id": "cups-detect",
    "info": {
      "name": "CUPS - Detect",
      "author": "rxerium",
      "severity": "info",
      "description": "An instance running CUPS was detected.\n",
      "metadata": {
        "max_request": 1,
        "shodan_query": "product:\"CUPS (IPP)\""
      },
      "tags": "cups,tech,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "Web Interface is Disabled - CUPS",
              "Forbidden - CUPS",
              "Server: CUPS"
            ],
            "condition": "or",
            "case_insensitive": false
          },
          {
            "type": "status",
            "status": [
              200,
              404,
              403
            ],
            "condition": "or"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "CUPS v([0-9.]+)\u003e"
            ],
            "group": 1,
            "name": "version",
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}