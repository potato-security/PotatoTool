    "mail",
    "exim",
    "detection",
    "tcp"
  ],
  "protocol": "tcp",
  "selfContained": false,
  "searchQueries": {
    "shodan": "product:\"Exim smtpd\""
  },
  "variables": {},
  "variablesType": "sniper",
  "cweId": "CWE-200",
  "cvssMetrics": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:N",
  "verifySteps": [
