{
  "id": "apache-server-status",
  "name": "Apache Server Status Disclosure",
  "author": "thabisocn",
  "severity": "LOW",
  "description": "Apache /server-status displays information about your Apache status. If you are not using this feature, disable it.\n",
  "references": [
