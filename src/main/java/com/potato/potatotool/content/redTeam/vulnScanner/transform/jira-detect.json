    "id": "jira-detect",
    "info": {
      "name": "Jira Detect",
      "author": "pdteam,philippedelteil,AdamCrosser",
      "severity": "info",
      "description": "Jira login panel was detected.",
      "classification": {
        "cvss_metrics": "CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:N",
        "cvss_score": "0",
        "cwe_id": "CWE-200"
      },
      "metadata": {
        "max_request": 3,
        "shodan_query": [
          "http.component:\"atlassian jira\"",
          "http.component:\"atlassian confluence\"",
          "cpe:\"cpe:2.3:a:atlassian:jira\""
        ]
      },
      "tags": "tech,panel,jira,atlassian"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/secure/Dashboard.jspa",
          "{{BaseURL}}/jira/secure/Dashboard.jspa",
          "{{BaseURL}}/login.jsp"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "Project Management Software"
            ],
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "title\u003d\"JiraVersion\" value\u003d\"([0-9.]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
