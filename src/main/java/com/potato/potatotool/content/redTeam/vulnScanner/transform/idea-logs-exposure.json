{
  "id": "idea-logs-exposure",
  "name": "Public .idea Folder containing http logs",
  "author": "martincodes-de",
  "severity": "INFO",
  "description": "Searches for .idea Folder for http-requests-log.http and http-client.cookies file",
  "tags": [
    "phpstorm",
    "jetbrains",
    "idea",
    "exposure"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/.idea/httpRequests/http-requests-log.http",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "(?m)^(GET|POST) https?:\\/\\/"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        },
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "# domain\tpath\tname\tvalue\tdate"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "idea-logs-exposure",
    "info": {
      "name": "Public .idea Folder containing http logs",
