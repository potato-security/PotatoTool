  "originalPoc": {
    "id": "yourls-detect",
    "info": {
      "name": "YOURLS - Detection",
      "author": "lstatro",
      "severity": "info",
      "description": "Detects if the target is running a YOURLS (Your Own URL Shortener) server\n",
      "reference": [
        "https://github.com/YOURLS/YOURLS"
      ],
      "classification": {},
      "metadata": {
        "max_request": 1,
        "shodan_query": "title:\"Your Own URL Shortener\"",
        "fofa_query": "title\u003d\"Your Own URL Shortener\""
      },
      "tags": "tech,yourls"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": true,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "\u003ctitle\u003eYOURLS",
              "content\u003d\"YOURLS",
              "alt\u003d\"YOURLS",
              "/yourls-logo"
            ],
            "condition": "or",
            "case_insensitive": false
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "YOURLS\u003c\\/a\u003e([ a-z0-9.-]+)",
              "content\u003d\"YOURLS([ 0-9.]+)\""
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}