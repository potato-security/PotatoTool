      "method": "GET",
      "path": "{{BaseURL}}/dns-query?dns\u003dq80BAAABAAAAAAAAA3d3dwdleGFtcGxlA2NvbQAAAQAB",
      "headers": {
        "Accept": "application/dns-message"
      },
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "STATUS",
          "values": [
            "200"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "WORD",
          "part": "header",
          "values": [
            "application/dns-message"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "REGEX",
          "part": "header",
          "values": [
            "(C|c)ontent-(L|l)ength: 49"
