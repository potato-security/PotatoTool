    "info": {
      "name": "Apache JSPWiki - Detect",
      "author": "icarot",
      "severity": "info",
      "description": "Detects a Apache JSPWiki web application, leading open source WikiWiki engine, feature-rich and built around standard JEE components (Java, servlets, JSP).\n",
      "classification": {},
      "metadata": {
        "max_request": 1,
        "shodan_query": "title:\"JSPWiki\""
      },
      "tags": "tech,jspwiki,apache,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
