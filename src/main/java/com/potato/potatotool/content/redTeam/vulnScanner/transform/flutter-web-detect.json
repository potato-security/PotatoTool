{
  "id": "flutter-web-detect",
  "name": "Flutter Web Application - Detect",
  "author": "incogbyte",
  "severity": "INFO",
  "description": "Detect flutter web apps looking for flutter_bootstrap.js,main.dart.js and flutter_service_worker.js files.\n",
  "tags": [
    "tech",
    "detect",
    "flutter"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "fofa": "body\u003d\"flutter_bootstrap.js\"",
    "shodan": "http.html:\"flutter_bootstrap.js\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/flutter_service_worker.js",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "_flutter.loader.didCreateEngineInitializer",
            "_flutter.buildConfig",
            "flutter-app-manifest",
            "flutter-temp-cache",
            "flutter-app-cache",
            "ext.flutter.disassemble",
            "#flutterweb-theme"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": true,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "flutter-web-detect",
    "info": {
      "name": "Flutter Web Application - Detect",
      "author": "incogbyte",
      "severity": "info",
      "description": "Detect flutter web apps looking for flutter_bootstrap.js,main.dart.js and flutter_service_worker.js files.\n",
      "metadata": {
        "max_request": 1,
        "shodan_query": "http.html:\"flutter_bootstrap.js\"",
        "fofa_query": "body\u003d\"flutter_bootstrap.js\""
      },
      "tags": "tech,detect,flutter"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/flutter_service_worker.js",
          "{{BaseURL}}/main.dart.js",
          "{{BaseURL}}/flutter_bootstrap.js"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "_flutter.loader.didCreateEngineInitializer",
              "_flutter.buildConfig",
              "flutter-app-manifest",
              "flutter-temp-cache",
              "flutter-app-cache",
              "ext.flutter.disassemble",
              "#flutterweb-theme"
            ],
            "condition": "or",
            "case_insensitive": false
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}