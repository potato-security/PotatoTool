{
  "id": "mappproxy-detect",
  "name": "Mapproxy - Detect",
  "author": "philippedelteil",
  "severity": "INFO",
  "description": "Checks for a running MapProxy instance and obtain version number. Also checks if the demo page is enabled. MapProxy is an open source proxy for geospatial data. It caches, accelerates and transforms data from existing map services and serves any desktop or web GIS client.\n",
  "references": [
    "https://github.com/mapproxy/mapproxy",
    "https://mapproxy.org"
  ],
  "tags": [
    "tech",
    "mapproxy",
    "detect"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "shodan": "http.html:\"Welcome to MapProxy\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "Welcome to MapProxy",
            "MapProxy Demo"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "WORD",
          "part": "header",
          "values": [
            "text/html"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "mappproxy-detect",
    "info": {
      "name": "Mapproxy - Detect",
      "author": "philippedelteil",
      "severity": "info",
      "description": "Checks for a running MapProxy instance and obtain version number. Also checks if the demo page is enabled. MapProxy is an open source proxy for geospatial data. It caches, accelerates and transforms data from existing map services and serves any desktop or web GIS client.\n",
      "reference": [
        "https://github.com/mapproxy/mapproxy",
        "https://mapproxy.org"
      ],
      "metadata": {
        "max_request": 2,
        "shodan_query": "http.html:\"Welcome to MapProxy\""
      },
      "tags": "tech,mapproxy,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}",
          "{{BaseURL}}/demo"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "Welcome to MapProxy",
              "MapProxy Demo"
            ],
            "condition": "or",
            "case_insensitive": false
          },
          {
            "type": "word",
            "negative": false,
            "part": "header",
            "words": [
              "text/html"
            ],
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "MapProxy(?i) ([0-9]+\\.[0-9]+\\.[0-9]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}