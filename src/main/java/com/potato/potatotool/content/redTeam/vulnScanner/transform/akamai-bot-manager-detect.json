{
  "id": "akamai-bot-manager-detect",
  "name": "Akamai Bot Manager Protection - Detect",
  "author": "Fazle Arefin",
  "severity": "INFO",
  "description": "Checks if the website is protected by Akamai Bot Manager\n",
  "references": [
    "https://www.akamai.com/legal/manage-cookie-preferences",
    "https://techdocs.akamai.com/identity-cloud/docs/hosted-login-cookies-and-local-storage-1"
  ],
  "tags": [
    "akamai",
    "bot",
    "security",
    "detect"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "REGEX",
          "part": "header",
          "values": [
            "Set-Cookie:\\s*_abck\u003d",
            "Set-Cookie:\\s*bm_sv\u003d",
            "Set-Cookie:\\s*ak_bmsc\u003d",
            "Set-Cookie:\\s*bm_sz\u003d",
            "Set-Cookie:\\s*bm_mi\u003d"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
