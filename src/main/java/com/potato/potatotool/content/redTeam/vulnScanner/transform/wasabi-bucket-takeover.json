    "id": "wasabi-bucket-takeover",
    "info": {
      "name": "wasabi Bucket Takeover - Detection",
      "author": "philippedelteil",
      "severity": "high",
      "description": "wasabi Bucket takeover was detected.\n",
      "reference": [
        "https://github.com/EdOverflow/can-i-take-over-xyz/issues/417"
      ],
      "metadata": {
        "max_request": 1,
        "shodan_query": "wasabis3"
      },
      "tags": "takeover,wasabi,bucket"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "Host !\u003d ip",
              "contains(tolower(header), \"wasabis3\")"
            ],
            "condition": "and"
          },
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "The specified bucket does not exist",
              "BucketName"
            ],
            "condition": "and",
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\u003cli\u003eBucketName: (.*?)\u003c/li\u003e",
              "\u003cBucketName\u003e(.*?)\u003c/BucketName\u003e"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
