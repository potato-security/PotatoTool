    "id": "eclipse-birt-panel",
    "info": {
      "name": "Eclipse BIRT Panel - Detect",
      "author": "Shiva (Strobes Security)",
      "severity": "info",
      "description": "Eclipse BIRT (Business Intelligence Reporting Tool) detected",
      "reference": [
        "https://eclipse.github.io/birt-website/"
      ],
      "classification": {
        "cvss_metrics": "CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:N",
        "cwe_id": "CWE-200"
      },
      "metadata": {
        "max_request": 2,
        "shodan_query": "title:\"Eclipse BIRT Home\"",
        "google_query": "intitle:\"Eclipse BIRT Home\""
      },
      "tags": "panel,eclipsebirt,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}",
          "{{BaseURL}}/reportviewer/"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "alt\u003d\"Eclipse Logo",
              "Eclipse BIRT Home"
            ],
            "condition": "or",
            "case_insensitive": true
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "Viewer Version : ([0-9.-]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
