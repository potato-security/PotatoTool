{
  "id": "cowrie-ssh-honeypot-detect",
  "name": "Cowrie SSH Honeypot - Detect",
  "author": "UnaPibaGeek",
  "severity": "INFO",
  "description": "A Cowrie (or Twisted) SSH honeypot has been identified.\nThe response to a wrong SSH version differs from real installations, signaling a possible deceptive setup.\n",
  "tags": [
    "cowrie",
    "twisted",
    "ssh",
    "honeypot",
    "ir",
    "cti",
    "network",
    "tcp"
  ],
  "protocol": "tcp",
  "selfContained": false,
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "host": "{{Hostname}}",
      "port": "22",
      "inputs": [
        {
          "data": "SSH-1337-OpenSSH_9.0\r\n",
          "read": "0"
        }
      ],
      "stepId": "tcp_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "SSH\\-([0-9.-A-Za-z_ ]+)"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        },
        {
          "type": "WORD",
          "part": "all",
          "values": [
            "Protocol major versions differ.",
            "bad version 1337"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
