{
  "id": "gitlab-login-check-self-hosted",
  "name": "Gitlab Login Check Self Hosted",
  "author": "parthmalhotra,pdresearch",
  "severity": "CRITICAL",
  "description": "Checks for a valid login on self hosted GitLab instance.",
  "references": [
    "https://owasp.org/www-community/attacks/Credential_stuffing"
  ],
  "tags": [
    "creds-stuffing",
    "login-check",
    "self-hosted",
    "gitlab"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "fofa": "product\u003d\"GitLab\"",
    "shodan": "product:\"GitLab Self-Managed\""
  },
  "variables": {
    "password": [
      "{{password}}"
    ],
    "username": [
      "{{username}}"
    ]
  },
  "variablesType": "pitchfork",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "GET /users/sign_in HTTP/1.1\nHost: {{Hostname}}\n",
        "POST /users/sign_in HTTP/1.1\nHost: {{Hostname}}\nCache-Control: max-age\u003d0\nOrigin: {{BaseURL}}\nDNT: 1\nContent-Type: application/x-www-form-urlencoded\nReferer: {{BaseURL}}/users/sign_in\nAccept-Language: en-US,en;q\u003d0.9,de;q\u003d0.8\n\nauthenticity_token\u003d{{url_encode(authenticity_token)}}\u0026user%5Blogin%5D\u003d{{username}}\u0026user%5Bpassword%5D\u003d{{password}}\u0026user%5Bremember_me%5D\u003d0\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "status_code_2 \u003d\u003d 302",
            "!contains(to_lower(body_2), \"invalid login\")"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "gitlab-login-check-self-hosted",
    "info": {
      "name": "Gitlab Login Check Self Hosted",
      "author": "parthmalhotra,pdresearch",
      "severity": "critical",
      "description": "Checks for a valid login on self hosted GitLab instance.",
      "reference": [
        "https://owasp.org/www-community/attacks/Credential_stuffing"
      ],
      "metadata": {
        "max_request": 2,
        "shodan_query": "product:\"GitLab Self-Managed\"",
        "fofa_query": "product\u003d\"GitLab\""
      },
      "tags": "creds-stuffing,login-check,self-hosted,gitlab"
    },
    "variables": {
      "username": "{{username}}",
      "password": "{{password}}"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "attack": "pitchfork",
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "redirects": false,
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "raw": [
          "GET /users/sign_in HTTP/1.1\nHost: {{Hostname}}\n",
          "POST /users/sign_in HTTP/1.1\nHost: {{Hostname}}\nCache-Control: max-age\u003d0\nOrigin: {{BaseURL}}\nDNT: 1\nContent-Type: application/x-www-form-urlencoded\nReferer: {{BaseURL}}/users/sign_in\nAccept-Language: en-US,en;q\u003d0.9,de;q\u003d0.8\n\nauthenticity_token\u003d{{url_encode(authenticity_token)}}\u0026user%5Blogin%5D\u003d{{username}}\u0026user%5Bpassword%5D\u003d{{password}}\u0026user%5Bremember_me%5D\u003d0\n"
        ],
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "status_code_2 \u003d\u003d 302",
              "!contains(to_lower(body_2), \"invalid login\")"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\"/users/sign_in\".*?authenticity_token\"\\s+value\u003d\"([^\"]+)\""
            ],
            "group": 1,
            "name": "authenticity_token",
            "internal": true
          },
          {
            "type": "dsl",
            "dsl": [
              "username",
              "password"
            ]
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}