        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "contains(tolower(header), \u0027www-authenticate: negotiate\u0027)"
            ]
          }
        ],
        "extractors": [
          {
            "type": "kval",
            "kval": [
              "www_authenticate"
            ]
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
