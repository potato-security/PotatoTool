    "id": "darkstat-detect",
    "info": {
      "name": "Detect Darkstat Reports",
      "author": "geeknik",
      "severity": "high",
      "description": "Darkstat captures network traffic, calculates statistics about usage, and serves reports over HTTP",
      "reference": [
        "https://unix4lyfe.org/darkstat/"
      ],
      "metadata": {
        "max_request": 2
      },
      "tags": "darkstat,logs,exposure"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}",
          "{{BaseURL}}/darkstat/"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "regex",
            "part": "header",
            "regex": [
              "[Ss]erver: darkstat.*"
            ],
            "group": 1,
            "internal": true
          },
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "darkstat",
              "\u003ctitle\u003eGraphs",
              "Measuring for",
              "hosts\u003c/a\u003e"
            ],
            "condition": "and",
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "kval",
            "kval": [
              "server"
            ]
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
