  "originalPoc": {
    "id": "confluence-detect",
    "info": {
      "name": "Confluence Detection",
      "author": "philippedelteil,AdamCrosser,6mile",
      "severity": "info",
      "description": "This nuclei template is used to detect the presence of Confluence, a popular collaboration software.\n",
      "classification": {},
      "metadata": {
        "max_request": 5,
        "shodan_query": [
          "http.component:\"Atlassian Confluence\"",
          "http.component:\"atlassian confluence\""
        ]
      },
      "tags": "tech,confluence,atlassian,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": true,
        "path": [
          "{{BaseURL}}/dologin.action",
          "{{BaseURL}}",
          "{{BaseURL}}/pages",
          "{{BaseURL}}/confluence",
          "{{BaseURL}}/wiki"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "contains(to_lower(header), \u0027-confluence-\u0027)",
              "contains(to_lower(body), \u0027confluence-base-url\u0027)"
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\u003cmeta name\u003d\"ajs-version-number\" content\u003d\"(.*)\"\u003e",
              "Atlassian Confluence ([a-z0-9-._]+)"
            ],
            "group": 1,
            "name": "version",
            "internal": true
          },
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\u003cmeta id\u003d\"confluence-base-url\" name\u003d\"confluence-base-url\" content\u003d\"https://(.*)\"\u003e",
              "\u003cmeta name\u003d\"ajs-base-url\" content\u003d\"https://(.*)\"\u003e",
              "\u003cmeta name\u003d\"ajs-server-name\" content\u003d\"(.*)\"\u003e"
            ],
            "group": 1,
            "name": "hostname",
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}