  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/dologin.action",
      "headers": {},
      "followRedirect": true,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
