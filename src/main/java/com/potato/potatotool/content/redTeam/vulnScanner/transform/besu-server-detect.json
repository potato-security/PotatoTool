{
  "id": "besu-server-detect",
  "name": "Besu JSON-RPC HTTP Server - Detect",
  "author": "Nullfuzz",
  "severity": "INFO",
  "description": "Besu is an open source Ethereum client developed under the Apache 2.0 license and written in Java. By default Besu runs a JSON-RPC HTTP server on port 8545/TCP\n",
  "references": [
    "https://besu.hyperledger.org/",
    "https://besu.hyperledger.org/public-networks/how-to/use-besu-api#service-ports"
  ],
  "tags": [
    "tech",
    "besu",
    "ethereum",
    "web3",
    "blockchain"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "shodan": "product:\"besu\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "POST / HTTP/1.1\nHost: {{Hostname}}\nContent-Type: application/json\n\n{\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1,\"jsonrpc\":\"2.0\"}\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "status_code \u003d\u003d 200",
            "contains(header, \"application/json\")",
            "contains(body, \"besu\")"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "besu-server-detect",
    "info": {
      "name": "Besu JSON-RPC HTTP Server - Detect",
      "author": "Nullfuzz",
      "severity": "info",
      "description": "Besu is an open source Ethereum client developed under the Apache 2.0 license and written in Java. By default Besu runs a JSON-RPC HTTP server on port 8545/TCP\n",
      "reference": [
        "https://besu.hyperledger.org/",
        "https://besu.hyperledger.org/public-networks/how-to/use-besu-api#service-ports"
      ],
      "metadata": {
        "max_request": 1,
        "shodan_query": "product:\"besu\""
      },
      "tags": "tech,besu,ethereum,web3,blockchain"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "redirects": false,
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "raw": [
          "POST / HTTP/1.1\nHost: {{Hostname}}\nContent-Type: application/json\n\n{\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1,\"jsonrpc\":\"2.0\"}\n"
        ],
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "status_code \u003d\u003d 200",
              "contains(header, \"application/json\")",
              "contains(body, \"besu\")"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(v[0-9.]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
