{
  "id": "grafana-login-check",
  "name": "Grafana Login Check",
  "author": "parthmalhotra,pdresearch",
  "severity": "CRITICAL",
  "description": "Checks for a valid login on self hosted Grafana instance.",
  "references": [
    "https://owasp.org/www-community/attacks/Credential_stuffing"
  ],
  "tags": [
    "self-hosted",
    "creds-stuffing",
    "login-check",
    "grafana"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "fofa": "title\u003d\"Grafana\"",
    "shodan": "title:\"Grafana\""
  },
  "variables": {
    "password": [
      "{{password}}"
    ],
    "username": [
      "{{username}}"
    ]
  },
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "POST /login HTTP/1.1\nHost: {{Hostname}}\naccept: application/json, text/plain, */*\nDNT: 1\ncontent-type: application/json\nOrigin: {{BaseURL}}\nReferer: {{BaseURL}}/login\nCookie: redirect_to\u003d%2F\n\n{\"user\":\"{{username}}\",\"password\":\"{{password}}\"}\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "Logged in"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "WORD",
          "part": "header",
          "values": [
            "grafana_session"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "STATUS",
          "values": [
            "200"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
