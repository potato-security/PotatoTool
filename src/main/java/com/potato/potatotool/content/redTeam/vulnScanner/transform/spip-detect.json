    "id": "spip-detect",
    "info": {
      "name": "SPIP - Detect",
      "author": "s4e-io",
      "severity": "info",
      "description": "Detects a SPIP and SPIP version.\n",
      "reference": [
        "https://www.spip.net/"
      ],
      "metadata": {
        "max_request": 1,
        "fofa_query": "app\u003d\"SPIP\""
      },
      "tags": "spip,tech,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "regex",
            "part": "header",
            "regex": [
              "Composed-By: SPIP",
              "X-Spip-Cache:"
            ],
            "condition": "or",
            "group": 1,
            "internal": true
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "header",
            "regex": [
              "Composed-By: SPIP ([0-9]{1,2}.[0-9]{1,2}.[0-9]{1,2}) @ www.spip.net"
            ],
            "group": 1,
            "name": "spip_version",
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
