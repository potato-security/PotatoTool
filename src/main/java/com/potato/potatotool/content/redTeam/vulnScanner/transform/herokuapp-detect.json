  "originalPoc": {
    "id": "herokuapp-detect",
    "info": {
      "name": "Detect websites using Herokuapp endpoints",
      "author": "alifathi-h1,righettod",
      "severity": "info",
      "description": "Detected endpoints might be vulnerable to subdomain takeover or disclose sensitive info",
      "metadata": {
        "max_request": 1
      },
      "tags": "heroku,tech"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "[a-z0-9.-]+\\.herokuapp\\.com",
              "[a-z0-9.-]+\\.herokucdn\\.com"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}