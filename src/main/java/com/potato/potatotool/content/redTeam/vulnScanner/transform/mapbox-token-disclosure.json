  "selfContained": false,
  "flow": "http(1) \u0026\u0026 http(2)",
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "sk\\.eyJ1Ijoi\\w+\\.[\\w-]*"
          ],
          "negative": false,
          "condition": "OR",
          "name": "token",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    },
    {
      "stepId": "http_1",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "@Host: https://api.mapbox.com:443\nGET /geocoding/v5/mapbox.places/Los%20Angeles.json?access_token\u003d{{token}} HTTP/1.1\nHost: api.mapbox.com\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": true,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "status_code \u003d\u003d 200",
            "contains_all(body, \"type\",\"query\",\"features\")"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
