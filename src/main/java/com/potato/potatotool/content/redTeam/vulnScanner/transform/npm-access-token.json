      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    },
    {
      "stepId": "http_1",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "@Host: https://registry.npmjs.org:443\nGET /-/whoami HTTP/1.1\nHost: registry.npmjs.org\nAuthorization: Bearer {{token}}\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": true,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "status_code \u003d\u003d 200",
            "contains(body, \"username\")",
            "contains(content_type, \"application/json\")"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
