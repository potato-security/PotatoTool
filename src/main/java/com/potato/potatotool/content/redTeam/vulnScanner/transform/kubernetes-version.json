{
  "id": "kubernetes-version",
  "name": "Kubernetes Version Exposure",
  "author": "raesene,idealphase",
  "severity": "INFO",
  "description": "Searches for exposed Kubernetes API servers which return version information unauthenticated. For Google Kubernetes Engine (GKE) and Amazon Elastic Kubernetes Service (EKS) this template will extract default patch version for you.",
  "references": [
    "https://cloud.google.com/kubernetes-engine/docs/release-notes",
    "https://docs.aws.amazon.com/eks/latest/userguide/kubernetes-versions.html"
  ],
  "tags": [
    "tech",
    "k8s",
    "kubernetes",
    "devops"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "shodan": "product:\"Kubernetes\" version:\"1.21.5-eks-bc4871b\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/version",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "all",
          "values": [
            "gitVersion",
            "goVersion",
            "platform"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "kubernetes-version",
    "info": {
      "name": "Kubernetes Version Exposure",
