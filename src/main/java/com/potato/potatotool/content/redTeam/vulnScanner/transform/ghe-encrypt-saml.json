{
  "id": "ghe-encrypt-saml",
  "name": "GitHub Enterprise - Encrypted SAML",
  "author": "rootxharsh,iamnoooob,pdresearch",
  "severity": "INFO",
  "description": "This template checks if Encrypted SAML (Security Assertion Markup Language) is enabled on a GitHub Enterprise instance.\n",
  "references": [
    "https://docs.github.com/en/enterprise-server@3.10/admin/managing-iam/using-saml-for-enterprise-iam/enabling-encrypted-assertions"
  ],
  "tags": [
    "github",
    "ghe",
    "saml"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "shodan": "title:\"GitHub Enterprise\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/saml/metadata",
      "headers": {},
      "followRedirect": true,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "EntityDescriptor",
            "KeyDescriptor",
            "use\u003d\"encryption\""
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
