{
  "id": "blazor-webassembly-detect",
  "name": "Blazor WebAssembly - Detect",
  "author": "righettod",
  "severity": "INFO",
  "description": "Blazor WebAssembly application was detected.\n",
  "references": [
    "https://dotnet.microsoft.com/en-us/apps/aspnet/web-apps/blazor",
    "https://github.com/righettod/burp-piper-custom-scripts/issues/1"
  ],
  "tags": [
    "blazor",
    "webassembly",
    "detect"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "shodan": "html:\"blazor.boot.json\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/_framework/blazor.boot.json",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "dotnet.wasm",
            "\"entryAssembly\"",
            "\"Microsoft.JSInterop.WebAssembly.dll\""
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": true,
          "greedy": false,
          "group": 0
        },
        {
          "type": "STATUS",
          "values": [
            "200"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": true,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "blazor-webassembly-detect",
    "info": {
      "name": "Blazor WebAssembly - Detect",
      "author": "righettod",
      "severity": "info",
      "description": "Blazor WebAssembly application was detected.\n",
      "reference": [
        "https://dotnet.microsoft.com/en-us/apps/aspnet/web-apps/blazor",
        "https://github.com/righettod/burp-piper-custom-scripts/issues/1"
      ],
      "metadata": {
        "max_request": 1,
        "shodan_query": "html:\"blazor.boot.json\""
      },
      "tags": "blazor,webassembly,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/_framework/blazor.boot.json"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "dotnet.wasm",
              "\"entryAssembly\"",
              "\"Microsoft.JSInterop.WebAssembly.dll\""
            ],
            "condition": "and",
            "case_insensitive": true
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "dotnet.([0-9.]+).[a-z0-9]+.js"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}