    "info": {
      "name": "Tixeo Login Panel - Detect",
      "author": "righettod",
      "severity": "info",
      "description": "Tixeo login panel was detected.\n",
      "reference": [
        "https://www.tixeo.com/en/"
      ],
      "metadata": {
        "max_request": 3,
        "shodan_query": "http.title:\"tixeo\""
      },
      "tags": "panel,tixeo,login,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/meet/services/json/v1/settings",
          "{{BaseURL}}/meet/login.html",
          "{{BaseURL}}/meet/"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "contains(header, \"Tixeo\")",
              "contains_any(to_lower(body), \"tixeo-button\", \"tixeoclient\")"
            ],
            "condition": "or"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\"applicationVersion\"\\s*:\\s*\"([0-9.]+)\""
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
