              ".fortinet.com",
              "Certificate Authority"
            ],
            "condition": "and",
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "[a-z0-9.-]+\\.fortinet\\.com"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
