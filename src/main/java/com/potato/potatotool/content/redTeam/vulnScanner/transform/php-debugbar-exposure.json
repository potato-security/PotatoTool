              "contains_all(body, \"\\\"utime\\\"\",\"\\\"datetime\\\"\",\"{\\\"id\") \u0026\u0026 contains(content_type, \"application/json\")"
            ],
            "condition": "or"
          }
        ]
      }
    ]
  },
