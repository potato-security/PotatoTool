{
  "id": "gitlab-uninitialized-password",
  "name": "Uninitialized GitLab instances",
  "author": "GitLab Red Team",
  "severity": "HIGH",
  "description": "Prior to version 14, GitLab installations required a root password to be\nset via the web UI. If the administrator skipped this step, any visitor\ncould set a password and control the instance.\n",
  "references": [
    "https://gitlab.com/gitlab-org/gitlab/-/issues/211328",
    "https://gitlab.com/gitlab-org/omnibus-gitlab/-/merge_requests/5331",
    "https://docs.gitlab.com/omnibus/installation/#set-up-the-initial-password"
  ],
  "tags": [
    "gitlab",
    "misconfig",
    "unauth"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
