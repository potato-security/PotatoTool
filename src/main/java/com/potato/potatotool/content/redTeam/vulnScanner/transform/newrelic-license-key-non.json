        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)associated\\ with\\ your\\ New\\ Relic\\ account\\.\\s+license_key:\\s*([a-f0-9]{40})\\b"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
