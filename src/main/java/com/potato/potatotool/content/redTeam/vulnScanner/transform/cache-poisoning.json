{
  "id": "cache-poisoning",
  "name": "Cache Poisoning Detection",
  "author": "melbadry9,xelkomy,akincibor,dogasantos",
  "severity": "LOW",
  "description": "This template detects Cache poisoning.",
  "references": [
    "https://web.archive.org/web/20210422000653/https://blog.melbadry9.xyz/fuzzing/nuclei-cache-poisoning",
    "https://portswigger.net/research/practical-web-cache-poisoning",
    "https://portswigger.net/web-security/web-cache-poisoning"
  ],
  "tags": [
    "cache",
    "generic"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
  "variables": {
    "cache_header": [
      "{{to_lower(rand_base(6))}}"
    ],
    "cache_key": [
      "{{to_lower(rand_base(6))}}"
    ]
  },
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "GET /?{{cache_key}}\u003d9 HTTP/1.1\nHost: {{Hostname}}\nX-Forwarded-Prefix: {{cache_header}}.xfp\nX-Forwarded-Host: {{cache_header}}.xfh\nX-Forwarded-For: {{cache_header}}.xff\n",
        "GET /?{{cache_key}}\u003d9 HTTP/1.1\nHost: {{Hostname}}\n"
      ],
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "contains(body_2, cache_header)"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "cache-poisoning",
    "info": {
      "name": "Cache Poisoning Detection",
      "author": "melbadry9,xelkomy,akincibor,dogasantos",
      "severity": "low",
      "description": "This template detects Cache poisoning.",
      "reference": [
        "https://web.archive.org/web/20210422000653/https://blog.melbadry9.xyz/fuzzing/nuclei-cache-poisoning",
        "https://portswigger.net/research/practical-web-cache-poisoning",
        "https://portswigger.net/web-security/web-cache-poisoning"
      ],
      "metadata": {
        "max_request": 2
      },
      "tags": "cache,generic"
    },
    "variables": {
      "cache_key": "{{to_lower(rand_base(6))}}",
      "cache_header": "{{to_lower(rand_base(6))}}"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "redirects": false,
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "raw": [
          "GET /?{{cache_key}}\u003d9 HTTP/1.1\nHost: {{Hostname}}\nX-Forwarded-Prefix: {{cache_header}}.xfp\nX-Forwarded-Host: {{cache_header}}.xfh\nX-Forwarded-For: {{cache_header}}.xff\n",
          "GET /?{{cache_key}}\u003d9 HTTP/1.1\nHost: {{Hostname}}\n"
        ],
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "contains(body_2, cache_header)"
            ]
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}