    "id": "adfs-detect",
    "info": {
      "name": "ADFS Detect",
      "author": "Adam Crosser,Mys7ic",
      "severity": "info",
      "description": "Detects ADFS with forms-based authentication enabled.",
      "metadata": {
        "max_request": 1
      },
      "tags": "tech,adfs"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/adfs/ls/idpinitiatedsignon.aspx"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "/adfs/portal/css/style.css"
            ],
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "var\\s+userNameValue\\s*\u003d\\s*\u0027([^\\\\]*)\\\\"
            ],
            "group": 1,
            "name": "domain",
            "internal": true
          }
        ]
      }
    ]
  },
