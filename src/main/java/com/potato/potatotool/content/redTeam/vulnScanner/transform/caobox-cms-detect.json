{
  "id": "caobox-cms-detect",
  "name": "Caobox CMS - Detect",
  "author": "Chirag Mistry",
  "severity": "INFO",
  "description": "Detects instances of Caobox CMS based on unique fingerprints and identifiers.\n",
  "tags": [
    "detect",
    "caobox",
    "cms",
    "tech"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "shodan": "http.component:\"Caobox\" http.component:\"caobox\" cpe:\"cpe:2.3:a:caobox:caobox\""
  },
  "variables": {
    "paths": [
      "/",
      "/admin/",
      "/index.php",
      "/admin/login.php"
    ]
  },
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "all",
          "values": [
            "Caobox CMS",
            "powered by Caobox",
            "Welcome to Caobox",
            "Caobox version"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "(?i)caobox",
            "(?i)caobox\\s+(v[0-9.]+)",
            "(?i)\u003ctitle\u003eCaobox CMS"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
