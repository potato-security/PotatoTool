  "originalPoc": {
    "id": "tyk-gateway-detect",
    "info": {
      "name": "Tyk API Gateway - Detection",
      "author": "davidfegyver",
      "severity": "info",
      "description": "Detects if the application uses Tyk API Gateway\n",
      "reference": [
        "https://github.com/TykTechnologies/tyk"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "tyk,gateway,tech,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/hello"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "Tyk GW",
              "description"
            ],
            "condition": "and",
            "case_insensitive": false
          },
          {
            "type": "word",
            "negative": false,
            "part": "content_type",
            "words": [
              "application/json"
            ],
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\"version\":\"([^\"]*)\""
            ],
            "group": 1,
            "name": "version",
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}