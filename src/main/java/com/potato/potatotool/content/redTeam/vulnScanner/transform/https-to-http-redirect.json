{
  "id": "https-to-http-redirect",
  "name": "HTTPS to HTTP redirect Misconfiguration",
  "author": "kazet,idealphase",
  "severity": "INFO",
  "description": "Detects whether there is a redirect from https:// to http://\n",
  "tags": [
    "misconfig",
    "http",
    "https"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
