  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "DSL",
          "values": [
            "startswith(tolower(location), \"http://\")",
            "startswith(tostring(BaseURL), \"https://\")",
            "(status_code \u003d\u003d 300 || status_code \u003d\u003d 301 || status_code \u003d\u003d 302 || status_code \u003d\u003d 303 || status_code \u003d\u003d 307 || status_code \u003d\u003d 308)"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "DSL",
          "values": [
            "startswith(tostring(BaseURL), \"https://\")",
            "status_code \u003d\u003d 200",
            "contains(tolower(body), \"\u003cmeta http-equiv\u003d\\\"refresh\\\" content\u003d\\\"0; url\u003dhttp://\")"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
