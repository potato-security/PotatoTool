  "originalPoc": {
    "id": "redfish-api",
    "info": {
      "name": "Redfish API - Detect",
      "author": "righettod",
      "severity": "info",
      "description": "Redfish API was detected.\n",
      "reference": [
        "https://en.wikipedia.org/wiki/Redfish_(specification)",
        "https://www.dmtf.org/standards/redfish"
      ],
      "metadata": {
        "max_request": 1,
        "shodan_query": "http.html:\"/redfish/v1\""
      },
      "tags": "config,exposure,redfish,api"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/redfish/v1/"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "contains_any(body, \"\\\"@odata.type\\\":\", \"/redfish/v1/$metadata#Message\")",
              "contains(header, \"application/json\")",
              "status_code \u003d\u003d 200 || status_code \u003d\u003d 502"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "[a-z]+\\.v?([0-9_\\.]+)\\."
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}