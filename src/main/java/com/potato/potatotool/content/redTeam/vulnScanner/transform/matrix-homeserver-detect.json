  "originalPoc": {
    "id": "matrix-homeserver-detect",
    "info": {
      "name": "Matrix Homeserver - Version Detection",
      "author": "davidegirardi",
      "severity": "info",
      "description": "Extract the Matrix homeserver name and version\n",
      "classification": {},
      "metadata": {
        "max_request": 1,
        "shodan_query": "title:\"Synapse is running\""
      },
      "tags": "tech,matrix,synapse"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": true,
        "path": [
          "{{BaseURL}}/_matrix/federation/v1/version"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "\"server\":",
              "\"name\":",
              "\"version\":"
            ],
            "condition": "and",
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "json",
            "json": [
              ".server | select((.name !\u003d null) and (.version !\u003d null)) | .name, .version"
            ]
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}