          "{{BaseURL}}/webapps/index.php",
          "{{BaseURL}}/websrvs/index.php",
          "{{BaseURL}}/admin/login_uid.php"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "WebADM",
              "RCDevs Security",
              "www.rcdevs.com"
            ],
            "condition": "and",
            "case_insensitive": true
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
