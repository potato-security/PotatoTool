    "id": "opentouch-multimediaservices-panel",
    "info": {
      "name": "OpenTouch Multimedia Services - Detect",
      "author": "righettod",
      "severity": "info",
      "description": "OpenTouch Multimedia Services Login Panel was detected.\n",
      "reference": [
        "https://www.al-enterprise.com/-/media/assets/internet/documents/opentouch-multimedia-services-datasheet-en.pdf"
      ],
      "metadata": {
        "max_request": 2
      },
      "tags": "panel,opentouch,login,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/authenticationform/login",
          "{{BaseURL}}/authenticationform/jsp/logonWeb.jsp"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "OpenTouch",
              "Multimedia Services",
              "Alcatel-Lucent"
            ],
            "condition": "and",
            "case_insensitive": true
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)Version\\s+([0-9.-]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
