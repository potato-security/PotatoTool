      "admin"
    ],
    "username": [
      "sonar",
      "admin"
    ]
  },
  "variablesType": "clusterbomb",
  "cweId": "CWE-522",
  "cvssScore": "8.3",
  "cvssMetrics": "CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:L",
