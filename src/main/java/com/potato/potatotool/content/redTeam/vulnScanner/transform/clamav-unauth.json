{
  "id": "clamav-unauth",
  "name": "ClamAV Server - Unauthenticated Access",
  "author": "dwisiswant0",
  "severity": "HIGH",
  "description": "ClamAV server 0.99.2, and possibly other previous versions, allow the execution\nof dangerous service commands without authentication. Specifically, the command \u0027SCAN\u0027\nmay be used to list system files and the command \u0027SHUTDOWN\u0027 shut downs the service.\n",
  "references": [
    "https://seclists.org/nmap-dev/2016/q2/201",
    "https://bugzilla.clamav.net/show_bug.cgi?id\u003d11585"
  ],
  "tags": [
    "network",
    "clamav",
    "unauth",
    "seclists",
    "misconfig",
    "tcp"
  ],
  "protocol": "tcp",
  "selfContained": false,
  "searchQueries": {
    "shodan": "port:3310 product:\"ClamAV\" version:\"0.99.2\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "host": "{{Hostname}}",
      "port": "3310",
      "inputs": [
        {
          "data": "SCAN /nonexistent/{{to_lower(rand_text_alpha(10))}}\r\n",
          "read": "0"
        }
      ],
      "stepId": "tcp_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 48,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "all",
          "values": [
            "No such",
            "lstat() failed"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
