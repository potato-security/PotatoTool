  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "raw": [
        "GET  HTTP/1.1\nHost: {{Hostname}}\nOrigin: {{cors_origin}}\n"
