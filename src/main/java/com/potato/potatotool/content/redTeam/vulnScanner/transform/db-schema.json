        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "This file is auto-generated from the current state of the database.",
              "ActiveRecord::Schema.define"
            ],
            "condition": "and",
            "case_insensitive": false
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "eRecord::Schema\\.define\\(version: ([0-9_]+)\\) do"
            ],
            "group": 1,
            "name": "version",
            "internal": true
          }
        ]
      }
