{
  "id": "akamai-cache-detect",
  "name": "Akamai Cache Detection",
  "author": "nybble04",
  "severity": "INFO",
  "description": "Sends a HEAD request with a Pragma header value of \"akamai-x-cache-on\" and looks for an akamai-specific response header value.\n",
  "references": [
    "https://community.akamai.com/customers/s/article/Using-Akamai-Pragma-headers-to-investigate-or-troubleshoot-Akamai-content-delivery?language\u003den_US",
    "https://spyclub.tech/2022/12/14/unusual-cache-poisoning-akamai-s3/"
  ],
  "tags": [
    "cache",
    "akamai",
    "tech"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "HEAD",
      "path": "{{BaseURL}}",
      "headers": {
        "Pragma": "akamai-x-cache-on"
      },
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "REGEX",
          "part": "header",
          "values": [
            "(?:TCP_HIT|TCP_MISS).*deploy\\.akamaitechnologies\\.com"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "akamai-cache-detect",
    "info": {
      "name": "Akamai Cache Detection",
      "author": "nybble04",
      "severity": "info",
      "description": "Sends a HEAD request with a Pragma header value of \"akamai-x-cache-on\" and looks for an akamai-specific response header value.\n",
      "reference": [
        "https://community.akamai.com/customers/s/article/Using-Akamai-Pragma-headers-to-investigate-or-troubleshoot-Akamai-content-delivery?language\u003den_US",
        "https://spyclub.tech/2022/12/14/unusual-cache-poisoning-akamai-s3/"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "cache,akamai,tech"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "HEAD",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "headers": {
          "Pragma": "akamai-x-cache-on"
        },
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "regex",
            "part": "header",
            "regex": [
              "(?:TCP_HIT|TCP_MISS).*deploy\\.akamaitechnologies\\.com"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}