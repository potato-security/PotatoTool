    "id": "cvsweb-detect",
    "info": {
      "name": "CVSweb - Detect",
      "author": "lu4nx",
      "severity": "info",
      "description": "CVSweb is a WWW interface for CVS repositories with which you can browse a file hierarchy on your browser to view each file\u0027s revision history in a very handy manner.\n",
      "reference": [
        "https://cvsweb.openbsd.org/"
      ],
      "classification": {},
      "metadata": {
        "max_request": 1,
        "shodan_query": "title:\"cvsweb\"",
        "fofa_query": "title\u003d\"cvsweb\"",
        "zoomeye_query": "title:cvsweb"
      },
      "tags": "tech,cvsweb,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "content\u003d\".*CVSweb.*\""
            ],
            "group": 1,
            "internal": true
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "content\u003d\".*CVSweb\\s*([0-9.]+)\""
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
