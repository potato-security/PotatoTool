{
  "id": "lantronix-xport-unauth",
  "name": "Lantronix XPort 6.10.0.1 - Unauthenticated Access",
  "author": "John Osborn (Summit Security Group,LLC)",
  "severity": "HIGH",
  "description": "The Lantronix XPort\u0027s telnet service is not configured to require authentication by default.An unauthenticated user can remotely administer the device by hitting \u0027Enter\u0027 when prompted by the telnet service.\n",
  "references": [
    "https://www.lantronix.com/wp-content/uploads/pdf/XPort_UG.pdf"
  ],
  "tags": [
    "misconfig",
    "tcp",
    "default-login",
    "network"
  ],
  "protocol": "tcp",
  "selfContained": false,
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "host": "{{Hostname}}",
      "port": "9999",
      "inputs": [
        {
          "data": "\r\n",
          "read": "0"
        },
        {
          "read": "2048"
        }
      ],
      "stepId": "tcp_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
