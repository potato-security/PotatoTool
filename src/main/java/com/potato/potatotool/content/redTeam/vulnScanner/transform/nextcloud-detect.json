    "id": "nextcloud-detect",
    "info": {
      "name": "Nextcloud Detect",
      "author": "skeltavik",
      "severity": "info",
      "description": "Nextcloud is a suite of client-server software for creating and using file hosting services\n",
      "reference": [
        "https://nextcloud.com"
      ],
      "classification": {},
      "metadata": {
        "max_request": 4,
        "shodan_query": "http.title:\"Nextcloud\""
      },
      "tags": "tech,nextcloud,storage"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}",
          "{{BaseURL}}/login",
          "{{BaseURL}}/nextcloud/login",
          "{{BaseURL}}/nextcloud/index.php/login"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "var nc_lastLogin",
              "var nc_pageLoad"
            ],
            "condition": "and",
            "case_insensitive": false
          },
          {
            "type": "status",
            "status": [
              200
            ]
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?m)\"version\":\"([0-9.]+)\","
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
