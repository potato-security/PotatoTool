{
  "id": "activemq-openwire-transport-detect",
  "name": "ActiveMQ OpenWire Transport Detection",
  "author": "pussycat0x,ret2src",
  "severity": "INFO",
  "description": "OpenWire is the native protocol that Apache ActiveMQ uses. It is designed for performance and size on the wire - sacrificing some ease of implementation with higher performance and reduced network bandwidth as a priority.\n",
  "tags": [
    "network",
    "activemq",
    "detect",
    "openwire",
    "detection",
    "tcp"
  ],
  "protocol": "tcp",
  "selfContained": false,
  "searchQueries": {
    "shodan": "product:\"ActiveMQ OpenWire transport\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "host": "{{Hostname}}",
      "port": "61616,6835",
      "inputs": [
        {
          "data": "VERSION",
          "read": "0"
        }
      ],
      "stepId": "tcp_0",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "all",
          "values": [
            "ActiveMQ"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "activemq-openwire-transport-detect",
    "info": {
      "name": "ActiveMQ OpenWire Transport Detection",
      "author": "pussycat0x,ret2src",
      "severity": "info",
      "description": "OpenWire is the native protocol that Apache ActiveMQ uses. It is designed for performance and size on the wire - sacrificing some ease of implementation with higher performance and reduced network bandwidth as a priority.\n",
      "metadata": {
        "max_request": 1,
        "shodan_query": "product:\"ActiveMQ OpenWire transport\""
      },
      "tags": "network,activemq,detect,openwire,detection,tcp"
    },
    "self_contained": false,
    "tcp": [
      {
        "host": [
          "{{Hostname}}"
        ],
        "inputs": [
          {
            "data": "VERSION",
            "read": 0
          }
        ],
        "port": "61616,6835",
        "stop_at_first_match": false,
        "read_size": 0,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "ActiveMQ"
            ],
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "ProviderVersion...([0-9.]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}