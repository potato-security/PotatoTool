    "id": "netflix-conductor-version",
    "info": {
      "name": "Netflix Conductor Version Detection",
      "author": "c-sh0",
      "severity": "info",
      "description": "Obtain netflix conductor version information",
      "reference": [
        "https://github.com/Netflix/conductor/blob/v1.6.0-rc1/ui/src/server.js#L17",
        "https://github.com/Netflix/conductor/blob/v3.1.0/rest/src/main/java/com/netflix/conductor/rest/controllers/AdminResource.java#L42"
      ],
      "classification": {},
      "metadata": {
        "max_request": 2,
        "shodan_query": "http.title:\"Conductor UI\", http.title:\"Workflow UI\""
      },
      "tags": "miscellaneous,tech,netflix,conductor,api,misc"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/api/admin/config",
          "{{BaseURL}}/api/sys"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "status",
            "status": [
              200
            ]
          },
          {
            "type": "word",
            "negative": false,
            "part": "header",
            "words": [
              "application/json"
            ],
            "case_insensitive": false
          },
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "CONDUCTOR_"
            ],
            "case_insensitive": true
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "conductor\\-server\\-([0-9.]+)\\-",
              "\"version\":\"([0-9.]+)\\-"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
}