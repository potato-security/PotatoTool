    "id": "kiali-panel",
    "info": {
      "name": "Kiali - Detect",
      "author": "righettod",
      "severity": "info",
      "description": "kiali panel was detected.\n",
      "reference": [
        "https://kiali.io/"
      ],
      "classification": {},
      "metadata": {
        "max_request": 2,
        "shodan_query": "title:\"Kiali\""
      },
      "tags": "panel,kiali,detect,login"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/kiali/api/status",
          "{{BaseURL}}/kiali/"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "status_code \u003d\u003d 200",
              "contains_any(to_lower(body), \"kiali-ui\", \"\u003ctitle\u003ekiali\", \"kiali version\")"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)\"Kiali version\":\\s*\"([a-z0-9.]+)\""
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
