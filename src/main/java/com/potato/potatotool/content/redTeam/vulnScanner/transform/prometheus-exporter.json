    "id": "prometheus-exporter",
    "info": {
      "name": "Prometheus exporter detect",
      "author": "jarijaas",
      "severity": "info",
      "description": "Prometheus exporter detector",
      "reference": [
        "https://github.com/prometheus/prometheus/wiki/Default-port-allocations"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "prometheus,misconfig"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "all",
            "words": [
              "Exporter",
              "\u003ca href\u003d\"/metrics\"\u003eMetrics\u003c/a\u003e"
            ],
            "condition": "and",
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\u003ctitle\u003e(.*?)\u003c/title\u003e"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
