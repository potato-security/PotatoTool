{
  "id": "joomla-detect",
  "name": "Joomla! Detect",
  "author": "ricardomaia",
  "severity": "INFO",
  "description": "Joomla! is a free and open-source content management system (CMS) for publishing content on websites.\n",
  "references": [
    "https://www.joomla.org/",
    "https://github.com/joomla/joomla-cms",
    "https://www.itoctopus.com/how-to-quickly-know-the-version-of-any-joomla-website",
    "https://hackertarget.com/attacking-enumerating-joomla/"
  ],
  "tags": [
    "tech",
    "joomla",
    "cms",
    "oss"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {
    "google": "Joomla! Administration Login inurl:\"/index.php\" || intitle:\"Joomla Web Installer\""
  },
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}/administrator/manifests/files/joomla.xml",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "WORD",
          "part": "body",
          "values": [
            "\u003cversion\u003e",
            "\u003ccreationDate\u003e",
            "\u003c/metafile\u003e"
          ],
          "negative": false,
          "condition": "AND",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "(?i)\u003cmeta.name\u003d\"generator\".content\u003d\"(Joomla!).*/\u003e",
            "(?i)Joomla_([\\d.|\\d]+)_version_history",
            "FILES_JOOMLA_XML_DESCRIPTION"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        }
      ],
      "matchersCondition": "OR",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
