    "id": "vbulletin-detect",
    "info": {
      "name": "vBulletin Detect",
      "author": "ricardomaia",
      "severity": "info",
      "description": "vBulletin is a proprietary forum and community publishing software written in PHP.",
      "reference": [
        "https://www.vbulletin.com/"
      ],
      "classification": {},
      "metadata": {
        "max_request": 1,
        "shodan_query": "title:\"Powered By vBulletin\"",
        "google_query": "intext:\"Powered By vBulletin\""
      },
      "tags": "tech,vbulletin"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "Powered By vBulletin",
              "content\u003d\"vBulletin",
              "id\u003d\"vbulletin_css"
            ],
            "condition": "or",
            "case_insensitive": true
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)meta.name\u003d.generator.*content\u003d.vbulletin.([\\d.|\\d]+)",
              "(?i)\\*.vBulletin.([\\d.|\\d]+).CSS"
            ],
            "group": 1,
            "name": "version",
            "internal": true
          }
        ]
      }
    ]
  },
