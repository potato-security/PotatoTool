    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/alfresco/api/-default-/public/cmis/versions/1.1/atom"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "org\\/alfresco\\/api\\/opencmis\\/OpenCMIS.get"
            ],
            "case_insensitive": false
          },
          {
            "type": "word",
            "negative": false,
            "part": "header",
            "words": [
              "application/json"
            ],
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "Enterprise v.*([0-9]\\.[0-9]+\\.[0-9]+)",
              "Community v.*([0-9]\\.[0-9]+\\.[0-9]+)",
