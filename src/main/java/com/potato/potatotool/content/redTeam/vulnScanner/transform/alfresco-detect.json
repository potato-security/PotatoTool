    "info": {
      "name": "Alfresco CMS Detection",
      "author": "pathtaga",
      "severity": "info",
      "description": "Alfresco CMS was discovered.",
      "reference": [
        "https://www.alfresco.com/"
      ],
      "classification": {
        "cwe_id": "CWE-200"
      },
      "metadata": {
        "max_request": 1
      },
      "tags": "alfresco,tech,panel"
