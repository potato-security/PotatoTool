    "id": "argocd-detect",
    "info": {
      "name": "Argo CD Login Panel",
      "author": "Adam Crosser,daffainfo,aringo",
      "severity": "info",
      "description": "An Argo CD login panel was discovered.",
      "reference": [
        "https://argoproj.github.io/cd/"
      ],
      "classification": {
        "cwe_id": "CWE-200"
      },
      "metadata": {
        "max_request": 2,
        "shodan_query": "http.title:\"Argo CD\""
      },
      "tags": "panel,argocd,login,kubernetes"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/api/version",
          "{{BaseURL}}/api/v1/settings"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "or",
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "contains(to_lower(header_1), \u0027grpc-metadata-content-type\u0027)",
              "status_code_1 \u003d\u003d 200"
            ],
            "condition": "and"
          },
          {
            "type": "dsl",
            "dsl": [
              "contains(body_2, \u0027appLabelKey\u0027)",
              "contains(body_2, \u0027resourceOverrides\u0027)"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "json",
            "json": [
              ".Version"
            ]
          }
        ]
      }
    ]
