            "condition": "and"
          },
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "CN\u003d[A-Za-z0-9-]+-CA",
              "(?i)\u003ca\\s+href\u003d\"([^\"]+\\.crl)\"[^\u003e]*\u003e[^\u003c]*\\.crl\u003c\\/a\u003e",
              "(?i)\u003ca\\s+href\u003d\"([^\"]+\\.cer)\"[^\u003e]*\u003e[^\u003c]*\\.cer\u003c\\/a\u003e",
