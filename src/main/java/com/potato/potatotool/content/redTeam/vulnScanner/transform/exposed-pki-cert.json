              "(?i)href\u003d\"([^\"]+\\.crl)\"",
              "(?i)href\u003d\"([^\"]+\\.cer)\"",
              "(?i)href\u003d\"([^\"]+\\.p7b)\""
            ],
            "condition": "or",
            "group": 1,
            "internal": true
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "CN\u003d[A-Za-z0-9-]+-CA",
              "O\u003d[A-Za-z0-9 ]+",
              "OU\u003d[A-Za-z0-9 ]+"
