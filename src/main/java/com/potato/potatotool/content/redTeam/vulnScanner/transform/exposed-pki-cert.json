      "severity": "high",
      "description": "Detects exposed internal PKI infrastructure including CRL distribution points and OCSP responders\n",
      "metadata": {
        "max_request": 10
      },
      "tags": "pki,exposure,misconfig"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "payloads": {
          "paths": [
            "",
            "certsrv/",
            "pki/",
            "PKI/",
            "crl/",
            "CRL/",
            ".well-known/pki-validation/",
            "ocsp/",
            "CertEnroll/",
            "CertSrv/"
          ]
        },
        "cookie_reuse": false,
