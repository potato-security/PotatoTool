{
  "id": "merlin-c2-jarm",
  "name": "Merlin C2 JARM - Detect",
  "author": "pussycat0x",
  "severity": "INFO",
  "description": "Merlin is a post-exploit Command \u0026 Control (C2) tool, also known as a Remote Access Tool (RAT), that communicates using the HTTP/1.1, HTTP/2, and HTTP/3 protocols. HTTP/3 is the combination of HTTP/2 over the Quick UDP Internet Connections (QUIC) protocol. This tool was the result of my work evaluating HTTP/2 in a paper titled Practical Approach to Detecting and Preventing Web Application Attacks over HTTP/2. Merlin is also my first attempts at learning Golang.\n",
  "references": [
    "https://github.com/cedowens/C2-JARM",
    "https://merlin-c2.readthedocs.io/en/latest/"
  ],
  "tags": [
    "jarm",
    "network",
    "c2",
    "ir",
    "osint",
    "cti",
    "merlin",
    "tcp"
  ],
  "protocol": "tcp",
  "selfContained": false,
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
