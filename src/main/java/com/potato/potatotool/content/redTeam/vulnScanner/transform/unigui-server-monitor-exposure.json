          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        },
        {
          "type": "DSL",
          "values": [
            "contains(body, \"layout:\\\"fit\\\",title:\\\"uniGUI Standalone Server\\\"\")",
