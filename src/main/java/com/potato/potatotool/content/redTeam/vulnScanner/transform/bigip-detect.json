    "id": "bigip-detect",
    "info": {
      "name": "BIGIP - Detection",
      "author": "PR3R00T,0x240x23elu",
      "severity": "info",
      "reference": [
        "https://www.intelisecure.com/how-to-decode-big-ip-f5-persistence-cookie-values",
        "https://support.f5.com/csp/article/K23254150"
      ],
      "metadata": {
        "max_request": 2
      },
      "tags": "bigip,tech,f5"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}",
          "{{BaseURL}}/my.policy"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "word",
            "negative": false,
            "part": "header",
            "words": [
              "BIGipServer~"
            ],
            "case_insensitive": false
          },
          {
            "type": "word",
            "negative": false,
            "part": "header",
            "words": [
              "BigIP"
            ],
            "case_insensitive": false
          },
          {
            "type": "word",
            "negative": false,
            "part": "body",
            "words": [
              "F5 Networks."
            ],
            "case_insensitive": false
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "header",
            "regex": [
              "(BIGipServer[a-z\\_\\.\\-\\~0-9A-Z]*)\u003d([!a-z0-9A-Z/.\u003d]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
