              "\u003ciframe[^\u003e]*src\u003d[\u0027\"](http[^s\u0027\"\u003e][^\u0027\"\u003e]*)[\u0027\"]",
              "\u003cobject[^\u003e]*data\u003d[\u0027\"](http[^s\u0027\"\u003e][^\u0027\"\u003e]*)[\u0027\"]"
