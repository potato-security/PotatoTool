{
  "id": "mixed-active-content",
  "name": "Mixed Active Content",
  "author": "Liwermor",
  "severity": "INFO",
  "description": "This check detects if there are any active content loaded over HTTP instead of HTTPS.\n",
  "references": [
    "https://developer.mozilla.org/en-US/docs/Web/Security/Mixed_content",
    "https://portswigger.net/kb/issues/01000400_mixed-content",
    "https://resources.infosecinstitute.com/topics/vulnerabilities/https-mixed-content-vulnerability/",
    "https://docs.gitlab.com/ee/user/application_security/dast/checks/319.1.html"
  ],
  "tags": [
    "misconfig"
  ],
  "protocol": "http",
  "selfContained": false,
  "searchQueries": {},
  "variables": {},
  "variablesType": "sniper",
  "verifySteps": [
    {
      "stepId": "http_0",
      "method": "GET",
      "path": "{{BaseURL}}",
      "headers": {},
      "followRedirect": false,
      "timeout": 0,
      "readSize": 0,
      "unsafe": false,
      "disableCookie": false,
      "disablePathAutomerge": false,
      "cache": false,
      "compressed": false,
      "chunked": false,
      "matchers": [
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "(?mi)\u003c!--\\[if (lt|lte) IE [0-9]*\\]\u003e\\s*\u003cscript[^\u003e]*\\ssrc\u003d\"http://"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        },
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "\u003c!--\\s*\u003cscript"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        },
        {
          "type": "REGEX",
          "part": "body",
          "values": [
            "\u003cscript[^\u003e]*src\u003d[\u0027\"]http://[^\u0027\"\u003e]+[\u0027\"]",
            "\u003ciframe[^\u003e]*src\u003d[\u0027\"]http://[^\u0027\"\u003e]+[\u0027\"]",
            "\u003cobject[^\u003e]*data\u003d[\u0027\"]http://[^\u0027\"\u003e]+[\u0027\"]"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "internal": "true",
          "group": 1
        },
        {
          "type": "DSL",
          "values": [
            "startswith(tostring(BaseURL), \"https://\")"
          ],
          "negative": false,
          "condition": "OR",
          "index": 0,
          "caseInsensitive": false,
          "greedy": false,
          "group": 0
        }
      ],
      "matchersCondition": "AND",
      "extractors": [],
      "output": {},
      "retries": 0,
      "retryInterval": 0
    }
  ],
  "exploitSteps": [],
  "globalConfig": {
    "maxRetries": 0,
    "retryInterval": 0,
    "globalHeaders": {},
    "stopAtFirstMatch": false,
    "threads": 0,
    "cookieReuse": false,
    "dnsConfig": {},
    "authConfig": {}
  },
  "originalPoc": {
    "id": "mixed-active-content",
    "info": {
      "name": "Mixed Active Content",
