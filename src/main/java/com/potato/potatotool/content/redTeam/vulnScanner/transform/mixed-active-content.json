        "read_all": false,
        "iterate_all": false,
        "matchers_condition": "and",
        "matchers": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?mi)\u003c!--\\[if (lt|lte) IE [0-9]*\\]\u003e\\s*\u003cscript[^\u003e]*\\ssrc\u003d\"http://"
            ],
            "group": 1,
            "internal": true
          },
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "\u003c!--\\s*\u003cscript"
