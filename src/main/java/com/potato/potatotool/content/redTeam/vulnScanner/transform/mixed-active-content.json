        "https://docs.gitlab.com/ee/user/application_security/dast/checks/319.1.html"
      ],
      "metadata": {
        "max_request": 1
      },
      "tags": "misconfig"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
