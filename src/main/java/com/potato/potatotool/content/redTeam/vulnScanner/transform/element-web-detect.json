    "id": "element-web-detect",
    "info": {
      "name": "Element Web - Detect",
      "author": "davidegirardi",
      "severity": "info",
      "description": "Identify if a web application is vanilla Element Web and return the version",
      "classification": {},
      "metadata": {
        "max_request": 2,
        "shodan_query": "html:\"manifest.json\""
      },
      "tags": "tech,matrix,element,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/manifest.json",
          "{{BaseURL}}/version"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": false,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "status_code_1 \u003d\u003d 200",
              "contains(content_type_1, \"application/json\")",
              "contains(json_minify(body_1), \"\\\"name\\\":\\\"Element\\\"\")",
              "status_code_2 \u003d\u003d 200"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "[^\\s]+"
            ],
            "group": 1,
            "internal": true
          }
