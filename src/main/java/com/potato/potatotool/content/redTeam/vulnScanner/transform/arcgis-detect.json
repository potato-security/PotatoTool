    "id": "arcgis-detect",
    "info": {
      "name": "ArcGIS - Detect",
      "author": "righettod",
      "severity": "info",
      "description": "ArcGIS products was detected.\n",
      "reference": [
        "https://enterprise.arcgis.com/en/"
      ],
      "metadata": {
        "max_request": 5,
        "shodan_query": "http.title:\"ArcGIS\""
      },
      "tags": "tech,arcgis,detect"
    },
    "self_contained": false,
    "http": [
      {
        "global_matchers": false,
        "cookie_reuse": false,
        "disable_cookie": false,
        "disable_path_automerge": false,
        "threads": 0,
        "method": "GET",
        "redirects": false,
        "path": [
          "{{BaseURL}}/portal/sharing/rest",
          "{{BaseURL}}/portal/portalhelp/en/rest/",
          "{{BaseURL}}/arcgis/rest/services",
          "{{BaseURL}}/server/rest/services",
          "{{BaseURL}}/arcgis/"
        ],
        "skip_variables_check": false,
        "stop_at_first_match": true,
        "unsafe": false,
        "read_all": false,
        "iterate_all": false,
        "matchers": [
          {
            "type": "dsl",
            "dsl": [
              "status_code \u003d\u003d 200",
              "contains_any(to_lower(body), \"\u003ctitle\u003earcgis portal directory\", \"search arcgis enterprise help\", \"\u003ctitle\u003earcgis\u003c/title\u003e\", \"arcgis rest services directory\", \"\u003ctitle\u003earcgis hub\u003c/title\u003e\")"
            ],
            "condition": "and"
          }
        ],
        "extractors": [
          {
            "type": "regex",
            "part": "body",
            "regex": [
              "(?i)\u0026copy;\\s+([0-9]+)\\s+Esri\\.",
              "\u003cb\u003eCurrent\\s+Version:\\s+\u003c\\/b\u003e([0-9.]+)"
            ],
            "group": 1,
            "internal": true
          }
        ]
      }
    ]
  },
  "originalFormat": "nuclei"
