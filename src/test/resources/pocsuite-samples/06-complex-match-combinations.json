        "vulPath": "/api/status",
        "necessary": "需要先通过步骤0",
        "status": "200",
        "match": {
          "regex": ["status.*ok"]
        }
      }
    ],
    "attack": [
      {
        "step": "0",
        "method": "POST",
        "vulPath": "/api/exploit",
        "params": "cmd=whoami",
        "status": "200",
        "match": {
          "regex": ["root", "admin"],
          "time": "2"
        },
        "result": {
          "ShellInfo": {
            "Command": "<regex>command:([^\\n]+)",
            "Output": "<regex>output:([^\\n]+)"
          }
        }
      }
    ]
